    <Parameter Name="f_ten_vt" DataType="System.String" Expression="IIf([d1.fix_yn] == 0, IIf([languageType] == 1, [d2.ten_vt], [d2.ten_vt2]), [d2.ten_vt])"/>
    <Parameter Name="t1" DataType="System.String" Expression="Substring(Trim([d1.ma_so_thue]),0,1)"/>
    <Parameter Name="t2" DataType="System.String" Expression="Substring(Trim([d1.ma_so_thue]),1,1)"/>
    <Parameter Name="t3" DataType="System.String" Expression="Substring(Trim([d1.ma_so_thue]),2,1)"/>
