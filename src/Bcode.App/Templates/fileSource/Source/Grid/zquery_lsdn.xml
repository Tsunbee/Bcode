<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardQueryToolbar SYSTEM "..\Include\XML\StandardQueryToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">

	<!ENTITY FilterInitialize SYSTEM "..\Include\FilterInitialize.xml">
	<!ENTITY FilterQuery SYSTEM "..\Include\FilterQuery.xml">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.Voucher.ent">
	%Control.Filter;

	<!ENTITY Controller "'GLDetail'">

	<!ENTITY FastBusiness.Encryption.Begin "">
	<!ENTITY QueryString "
declare @c char(1), @d char(1)
select @c = char(253), @d = char(252)
select * into #t from dbo.FastBusiness$Function$System$Split(@@queryString, @c)
update #t set data = replace(data, @d, '''')

declare @ma_ku varchar(32), @ngay1 smalldatetime, @ngay2 smalldatetime, @ma_dvcs varchar(8000), @tk varchar(128), @vu_viec_me varchar(32), @mau_bc varchar(32), @ma_phi varchar(33)


select @ma_ku = data from #t where id = 1
select @ngay1 = data from #t where id = 2
select @ngay2 = data from #t where id = 3
select @ma_dvcs = data from #t where id = 4
select @tk = data from #t where id = 5
select @vu_viec_me = data from #t where id = 6
select @mau_bc = data from #t where id = 7


drop table #t">
	<!ENTITY FastBusiness.Encryption.End "">
]>

<grid order="ngay_ct, stt_ct_nkc, so_ct, stt_rec, nh_dk, line_nbr" type="Inquiry" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Chi tiết dư nợ và lãi suất doanh nghiệp" e="Job Detail"></title>
	<subTitle v="Vụ việc: %c - %s, từ ngày %d1 đến ngày %d2..." e="Job: %c - %s, Date from %d1 to %d2..."></subTitle>
	<fields>
		<field name="ngay_ct" type="DateTime" dataFormatString="@datetimeFormat" width="80" aliasName="a" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Ngày ct" e="VC. Date"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ma_ct" width="60" aliasName="a" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct]', Value: '[stt_rec]'}, Script: 'beforeDrillDown(this);'" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Mã ct" e="VC. Code"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="so_ct" width="80" align="right" aliasName="a" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Số ct" e="Voucher No."></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ma_kh" width="100" aliasName="a" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Mã khách" e="Customer"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ten_kh%l" width="300" aliasName="b" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Tên khách hàng" e="Customer Name"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="dien_giai" width="300" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Diễn giải" e="Description"></header>
			<query>&InsertCommandFilter;</query>
		</field>

		<field name="tk" width="100" aliasName="a" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Tài khoản" e="Account"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="tk_du" width="100" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Tk đối ứng" e="Reference Account"></header>
			<query>&InsertCommandFilter;</query>
		</field> 

		<field name="ps_no_nt" type="Decimal" dataFormatString="@foreignCurrencyAmountViewFormat" aggregate="Sum" width="120" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Ps nợ nt" e="FC Debit Amount"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ps_co_nt" type="Decimal" dataFormatString="@foreignCurrencyAmountViewFormat" aggregate="Sum" width="120" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Ps có nt" e="FC Credit Amount"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ps_no" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" width="120" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Ps nợ" e="Debit Amount"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ps_co" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" width="120" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Ps có" e="Credit Amount"></header>
			<query>&InsertCommandFilter;</query>
		</field>

		<field name="ma_ku" width="100" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;" aliasName="a">
			<header v="Khế ước" e="Job"></header>
			<query>&InsertCommandFilter;</query>
		</field>
				<field name="ten_ku%l" width="300" aliasName="c" allowFilter="&GridQueryAllowFilter;" allowSorting="&GridQueryAllowSorting;">
			<header v="Tên khế ước" e="Customer Name"></header>
			<query>&InsertCommandFilter;</query>
		</field>

		<field name="stt_rec" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="stt_ct_nkc" width="0" hidden="true" aliasName="str(dmct.stt_ct_nkc, 3)">
			<header v="" e=""></header>
		</field>
		<field name="nh_dk" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="line_nbr" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ngay_ct"/>
			<field name="ma_ct"/>
			<field name="so_ct"/>
			<field name="ma_kh"/>
			<field name="ten_kh%l"/>
			<field name="ma_ku"/>
			<field name="ten_ku%l"/>

			<field name="dien_giai"/>

			<field name="tk"/>
			<field name="tk_du"/>

			<field name="ps_no_nt"/>
			<field name="ps_co_nt"/>
			<field name="ps_no"/>
			<field name="ps_co"/>

			
			<field name="stt_rec"/>
			<field name="stt_ct_nkc"/>
			<field name="nh_dk"/>
			<field name="line_nbr"/>
		</view>
	</views>

	<commands>
		<command event ="Showing">
			<text>
				&QueryString;
				<![CDATA[
declare @name nvarchar(4000)
select @name = rtrim(isnull(case when @@language = 'V' then ten_ku else ten_ku2 end, '')) from dmku where ma_ku = @ma_ku
select 'this._jobName = ''' + replace(replace(isnull(@name, ''), '\', '\\'), '''', '\''') + ''';this._queryFilterString = ''' + replace(replace(@@queryString, '\', '\\'), '''', '\''') + ''';init$GridQuery$(this);' as message
return
]]>
			</text>
		</command>

		&XMLWhenReportLoading;
		&XMLWhenReportClosing;
	</commands>

	<queries>
		<query event="Declare">
			<text>&DeclareCommandFilter;</text>
		</query>
		<query event="Finding">
			<text>
				&QueryString;
				<![CDATA[
declare @queryWhereClause nvarchar(4000), @queryFormClause nvarchar(4000), @textExternal nvarchar(4000), @accountKey nvarchar(4000)
select @queryFormClause = '  left join dmkh b on a.ma_kh = b.ma_kh left join dmku c on a.ma_ku = c.ma_ku'
select @queryWhereClause = 'a.ma_ku = ''' +  replace(@ma_ku, '''', '''''') + ''''

if isnull(@tk, '') <> '' begin
	select top 0 tk into #$tk from dmtk0
	exec dbo.FastBusiness$App$GetAccountKey 'a.tk', 'like', @tk, '#$tk', @@userID, @@admin, @accountKey output
	select @queryWhereClause = @queryWhereClause + ' and ' + @accountKey
end


]]>&FilterInitialize;&FilterQuery;<![CDATA[
exec FastBusiness$Report$GLDetail @@refresh, @@pageIndex, @@pageCount, @@lastPage, @@lastCount, @@firstItem, @@lastItem, @@textExternal, @queryFormClause, @queryWhereClause, @ngay1, @ngay2, @ma_dvcs, @@admin, @@userID, @@aggregation
]]>
			</text>
		</query>
	</queries>

	<script>
		<text>
			&JavascriptReportInit;
			<![CDATA[/* <flatten type="Javascript"> */
function init$GridQuery$(g) {
 var a = g._queryFilterString.split(String.fromCharCode(253));
 g._alterTitle = [null, [['%c', a[0], true], ['%s', g._jobName, true], ['%d1', formatDateView(a[1]), true], ['%d2', formatDateView(a[2]), true]]];
 var x = a[7];
 g._hiddenFields = [{Fields: 'ps_no_nt, ps_co_nt', Value: (x == '10')}];
}
/* </flatten> */]]>
		</text>
	</script>

	&XMLStandardQueryToolbar;
</grid>