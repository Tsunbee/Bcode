    <Parameter Name="f_bi_total" DataType="System.String" Expression="&quot;(&quot; + [2_total] + &quot;)&quot;"/>
    <Parameter Name="f_storeKeeperName" DataType="System.String" Expression="IIf([languageType]==1, IIf([d1.storeKeeperName] == &quot;&quot;, [storeKeeperName], [d1.storeKeeperName]), IIf([d1.storeKeeperName2] == &quot;&quot;, [storeKeeperName], [d1.storeKeeperName2]))"/>
    <Parameter Name="f_preparedByName" DataType="System.String" Expression="IIf([languageType]==1, IIf([d1.preparedByName] == &quot;&quot;, [preparedByName], [d1.preparedByName]), IIf([d1.preparedByName2] == &quot;&quot;, [preparedByName], [d1.preparedByName2]))"/>
    <Parameter Name="f_contactName" DataType="System.String" Expression="IIf([languageType]==1, IIf([d1.contactName] == &quot;&quot;, [contactName], [d1.contactName]), IIf([d1.contactName2] == &quot;&quot;, [contactName], [d1.contactName2]))"/>
    <Parameter Name="f_reportDate" DataType="System.String" Expression="IIf([d1.biReportDate2] == &quot;&quot;, [biReportDate2], [d1.biReportDate2])"/>
