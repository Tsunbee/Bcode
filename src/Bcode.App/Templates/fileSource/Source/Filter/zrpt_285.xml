<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY Identity "zrpt_285">
	<!ENTITY XMLWhenFilterLoading SYSTEM "..\Include\XML\WhenFilterLoading.xml">
	<!ENTITY XMLWhenFilterClosing SYSTEM "..\Include\XML\WhenFilterClosing.xml">
	<!ENTITY OutlineCss SYSTEM "..\Include\Javascript\OutlineCss.txt">
	<!ENTITY OutlineEntry SYSTEM "..\Include\Javascript\OutlineEntry.txt">
	<!ENTITY OnSelectionOutline SYSTEM "..\Include\Javascript\OnSelectionOutline.txt">
	<!ENTITY JavascriptReportFilter SYSTEM "..\Include\Javascript\ReportFilter.txt">
	
]>

<dir type="Report" id="1" cache="true" xmlns="urn:schemas-fast-com:data-dir">
	<title v="Điều kiện lọc" e="Filter Condition"></title>
	<fields>
		<field name="tu_thang" type="Decimal" dataFormatString="#0" allowNulls="false" aliasName="fromMonth" defaultValue="(new Date()).getMonth() + 1">
			<header v="Tháng" e="Month"></header>
			<footer v="Từ tháng/Năm" e="From Month/Year"/>
			<items style="Numeric"/>
		</field>
		<field name="tu_nam" type="Decimal" dataFormatString="###0" allowNulls="false" aliasName="fromYear" defaultValue="(new Date()).getFullYear()">
			<header v="Năm" e="Year"></header>
			<items style="Numeric"/>
		</field>
		<field name="den_thang" type="Decimal" dataFormatString="#0" allowNulls="false" aliasName="toMonth" defaultValue="(new Date()).getMonth() + 1">
			<header v="Tháng" e="Month"></header>
			<footer v="Đến tháng/Năm" e="To Month/Year"/>
			<items style="Numeric"/>
		</field>
		<field name="den_nam" type="Decimal" dataFormatString="###0" allowNulls="true" aliasName="toYear" defaultValue="(new Date()).getFullYear()">
			<header v="Năm" e="Year"></header>
			<items style="Numeric"/>
		</field>
		<field name="ma_kh">
			<header v="Khách hàng" e="Customer"></header>
			<items style="AutoComplete" controller="Customer" reference="ten_kh%l" key="status = '1'" check="1=1" information="ma_kh$dmkh.ten_kh%l"/>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''" inactivate="true">
			<header v="" e=""></header>
		</field>
		<field name="nh_kh3">
			<header v="Nhóm khách hàng 3" e="Customer Group 3"></header>
			<items style="AutoComplete" controller="CustomerGroup" reference="ten_nh3%l" key="loai_nh = 3 and status = '1'" check="loai_nh = 3" information="ma_nh$dmnhkh.ten_nh%l"/>
		</field>
		<field name="ten_nh3%l" readOnly="true" external="true" defaultValue="''" inactivate="true">
			<header v="" e=""></header>
		</field>
		<field name="kieu_xem" dataFormatString="1,0" clientDefault="1" align="right">
			<header v="Xem theo ngày" e="View By Date"></header>	
			<footer v="1 - Có, 0 - Không" e="1 - Yes, 0 - No"></footer>	
			<items style="Mask" />
		</field>
	</fields>

	<views> 
		<view id="Dir">			<item value="120, 30, 70, 100, 130, 0, 50, 0"/>			<item value="111-----: [tu_thang].Description, [tu_thang], [tu_nam]"/>
			<item value="111-----: [den_thang].Description, [den_thang], [den_nam]"/>
			<item value="11010000: [ma_kh].Label, [ma_kh], [ten_kh%l]"/>
			<item value="11010000: [nh_kh3].Label, [nh_kh3], [ten_nh3%l]"/>
			<item value="11100000: [kieu_xem].Label, [kieu_xem], [kieu_xem].Description"/>
		</view>  
	</views>

	<commands>
		&XMLWhenFilterLoading;
		&XMLWhenFilterClosing;
		
		<command event="Processing">
			<text>
				<![CDATA[
select @tu_thang tu_thang, @tu_nam tu_nam, @den_thang den_thang, @den_nam den_nam
exec zrpt_285 @tu_thang, @tu_nam, @den_thang, @den_nam, @ma_kh, @kieu_xem, @@unit, '@@sysDatabaseName', @@language, @@userID, @@admin, @nh_kh3
]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			&OutlineEntry;
			&JavascriptReportFilter; 
			<![CDATA[
function active$VoucherFilter$(f) {
	f.add_onResponseComplete(on$Filter$ResponseComplete); 
	
}
function close$VoucherFilter$(f) {
	try {f.remove_onResponseComplete(on$Filter$ResponseComplete);} catch (ex) {}
}
function on$Filter$ResponseComplete(sender, e) {
	var f = e.object, context = e.type.Context, result = e.type.Result;
	switch (context) {
		case 'Checking':
			var g = f.grid; 
			g._hiddenForms = [];
			g._alterTitle = [null, [['%s1', f.getItemValue('tu_thang'), true], ['%s2', f.getItemValue('tu_nam'), true],['%s3', f.getItemValue('den_thang'), true], ['%s4', f.getItemValue('den_nam'), true]]];
			//remove$GridReport$Filter(g);
			break;
		default:
			break;
	}
}
]]>
		</text>
	</script>

	&OutlineCss;
</dir>