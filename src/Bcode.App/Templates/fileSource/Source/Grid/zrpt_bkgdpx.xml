<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">

	<!ENTITY % ReferenceNumber SYSTEM "..\Include\ReferenceNumber.ent">
	%ReferenceNumber;

	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;

	<!ENTITY % Repetition SYSTEM "..\Include\Repetition.ent">
	%Repetition;
]>

<grid type="Report" valid="systotal = 1" filter="&Repetition.Key.001;" repetition="&Repetition.Key.002;" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Bảng kê giao dịch phân xưởng" e="Shop Activity Transactions List"></title>
	<subTitle v="Từ ngày %d1 đến ngày %d2..." e="Date from %d1 to %d2..."></subTitle>
	<fields>
		<field name="ngay_ct" type="DateTime" dataFormatString="@datetimeFormat" width ="80" allowSorting="true" allowFilter="true">
			<header v="Ngày ct" e="VC. Date"/>
		</field>
		<field name="ma_ct0" width="50" allowSorting="true" allowFilter="true" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct]', Value: '[stt_rec]'}, Script: 'beforeDrillDown(this);'">
			<header v="Mã ct" e="VC. Code"></header>
		</field>
		
		<field name="ten_kh" width="120" allowSorting="true" allowFilter="true">
			<header v="Tên khách hàng" e="VC. Code"></header>
		</field>
		<field name="so_ct" width="120" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true" align="right">
			<header v="Số gdpx" e="Voucher No."></header>
		</field>

		<field name="ngay_dh" width="100" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true" align="right">
			<header v="Ngày đơn hàng" e="Voucher No."></header>
		</field>
		<field name="dh_so" width="120" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true" align="right">
			<header v="Số đơn hàng" e="SO No."></header>
		</field>
			<field name="ma_vt" width="100" allowSorting="true" allowFilter="true">
			<header v="Mã vật tư" e="Customer ID"></header>
		</field>
		<field name="ten_vt%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên vật tư" e="Customer Name"></header>
		</field>
		<field name="dvt" width="50" allowSorting="true" allowFilter="true">
			<header v="Đvt" e="Description"></header>
		</field>
		<field name="ghi_chu" width="300" allowSorting="true" allowFilter="true">
			<header v="Ghi chú" e="Description"></header>
		</field>
		<field name="ma_gd" width="100" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mã giao dịch" e="Account"></header>
		</field>
		<field name="ma_px" width="100" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mã phân xưởng" e="Ref. Account"></header>
		</field>
		<field name="ten_nc" width="160" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Tên nhân công" e="Ref. Account"></header>
		</field>
		<field name="ten_nh" width="160" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Tên nhóm nhân công" e="Ref. Account"></header>
		</field>
		<field name="ma_cd" width="90" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true" align="right">
			<header v="Mã công đoạn" e="Voucher No."></header>
		</field>
		<field name="ten_cd" width="120" allowSorting="true" allowFilter="true">
			<header v="Tên công đoạn" e="VC. Code"></header>
		</field>
		<field name="so_luong" type="Decimal" width="120" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Số lượng giao dịch" e="FC Credit Amount"></header>
		</field>
		<field name="s2_sl_yc" type="Decimal" width="120" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Số lượng yêu cầu" e="FC Credit Amount"></header>
		</field>
		<field name="sl_da_lay" type="Decimal" width="120" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Lũy kế đã lấy" e="FC Credit Amount"></header>
		</field>
			<field name="so_lg_cl" type="Decimal" width="120" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Số lượng còn lại" e="FC Credit Amount"></header>
		</field>
		&ReferenceNumberFields;

		<field name="stt_rec" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_ct" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
			<field name="systotal" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="nhom_cd" width="90" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true" align="right">
			<header v="Nhóm cđ" e="Section Group"></header>
		</field>
		<field name="nhom_cd_sau" width="90" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true" align="right">
			<header v="Nhóm cđ sau" e="Infront of Section Group"></header>
		</field>
	</fields>
	<views>
		<view id="Grid">
			<field name="ngay_ct"/>
			<field name="ma_ct0"/>
			<field name="ten_kh"/>
			<field name="so_ct"/>
			<field name="ngay_dh"/>
			<field name="dh_so"/>

			&ReferenceNumberViews;

			<field name="ma_vt"/>
			<field name="ten_vt%l"/>
			
			<field name="ma_cd"/>
			<field name="ten_cd"/>
			<field name="nhom_cd"/>
			<field name="nhom_cd_sau"/>
			
			<field name="so_luong"/>
			<field name="s2_sl_yc"/>
			<field name="sl_da_lay"/>

			<field name="so_lg_cl"/>

			<field name="dvt"/>
			<field name="ma_gd"/>
			<field name="ma_px"/>
			<field name="ten_nc"/>
			<field name="ten_nh"/>
			<field name="ghi_chu"/>

			<field name="ma_ct"/>
			<field name="stt_rec"/>
			<field name="systotal"/>
		</view>
	</views>
	<commands>
		&XMLWhenReportLoading;
		&XMLWhenReportClosing;
	</commands>

	<script>
		<text>
			&JavascriptReportInit;
		</text>
	</script>

	&XMLStandardReportToolbar;
</grid>