<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY CommandControlLocationLotShowing SYSTEM "..\Include\Command\ControlLocationLotShowing.txt">
	<!ENTITY % UserDefinedFields SYSTEM "..\Include\XML\Config\Fields\ISGrid.ent">
	%UserDefinedFields;

	<!ENTITY VisibleFieldController "ISDetail">
	<!ENTITY % VoucherVisibleField SYSTEM "..\Include\VoucherVisibleField.ent">
	%VoucherVisibleField;

	<!ENTITY % CompactMode SYSTEM "..\Include\CompactMode.ent">
	%CompactMode;

	<!ENTITY SiteField SYSTEM "..\Include\XML\SiteField.txt">
	<!ENTITY % GridInitialize SYSTEM "..\Include\Grid.ent">
	%GridInitialize;

	<!ENTITY % InternalTransportForm SYSTEM "..\Include\InternalTransportForm.ent">
	%InternalTransportForm;
	<!ENTITY % SeparateInvoice.ISTran SYSTEM "..\Include\SeparateInvoice.ISTran">
	%SeparateInvoice.ISTran;
	<!ENTITY % DetailTax SYSTEM "..\Include\DetailTax.ent">
	%DetailTax;

	<!ENTITY TempDetailTable "#$d84"> 
	<!ENTITY % GridViewer SYSTEM "..\Include\GridViewer.ent">
	%GridViewer;
	
	<!ENTITY % zExpenseSubGrid SYSTEM "..\Include\zExpenseSubGrid.ent">
	%zExpenseSubGrid;
]> 

<grid table="d84$000000" code="stt_rec" order="stt_rec, line_nbr" type="Detail" freezeColumns="3" id="PXA" uniKey="true" xmlns="urn:schemas-fast-com:data-grid">
	<title v="" e=""></title>
	<subTitle v="" e=""></subTitle>
	<partition table="c84$000000" prime="d84$" inquiry="i84$" field="ngay_ct" expression="convert(char(6), {0}, 112)" increase="dateadd(month, 1, {0})" default="000000"/>

	<fields>
		<field name="ma_vt" width="100" aliasName="a">
			<header v="Mã hàng" e="Item Code"></header>
		</field>
		<field name="ten_vt%l" readOnly="true" external="true" defaultValue="''" width="300" aliasName="b">
			<header v="Tên mặt hàng" e="Item Description"></header>
		</field>
		<field name="dvt" width="50" aliasName="a">
			<header v="Đvt" e="UOM"></header>
		</field>

		<field name="he_so" type="Decimal" width="0" hidden="true" dataFormatString="&CoefficientViewFormat;" clientDefault="0">
			<header v="" e=""></header>
			<items style="Numeric"/>
		</field>

		&SiteField;

		<field name="ma_vi_tri" width="80" clientDefault="Default" aliasName="a">
			<header v="Mã vị trí" e="Location"></header>
		</field>
		<field name="ma_lo" width="80" aliasName="a">
			<header v="Mã lô" e="Lot"></header>
		</field>

		<field name="ton13" type="Decimal" dataFormatString="@quantityViewFormat" width="80" external="true" defaultValue="0" readOnly="true" aliasName="cast(a.so_luong as numeric(28, 6))">
			<header v="Tồn" e="Stock"></header>
			<items style="Numeric"/>
		</field>

		<field name="so_luong" type="Decimal" dataFormatString="@quantityViewFormat" clientDefault="0" width="80">
			<header v="Số lượng" e="Quantity"></header>
			<items style="Numeric"/>
		</field>

		&SeparateInvoice.InternalTransportFormDetailFields;

		<field name="px_gia_dd" type="Boolean" width="50">
			<header v="Giá đích danh" e="Specific Cost"></header>
		</field>
		<field name="gia_nt" type="Decimal" dataFormatString="@foreignCurrencyPriceViewFormat" clientDefault="0" width="100">
			<header v="Giá" e="Price"></header>
			<items style="Numeric"/>
		</field>
		<field name="tien_nt" type="Decimal" dataFormatString="@foreignCurrencyAmountViewFormat" clientDefault="0" width="100">
			<header v="Tiền" e="Amount"></header>
			<items style="Numeric"/>
		</field>

		<field name="ma_nx" width="80">
			<header v="Mã nx" e="Reason Code"></header>
		</field>
		<field name="tk_vt" width="80" aliasName="a">
			<header v="Tk có" e="Credit Account"></header>
		</field>
		<field name="tk_du" width="80" aliasName="a">
			<header v="Tk nợ" e="Debit Account"></header>
		</field>

		&SeparateInvoice.DetailFields;
		&XMLWHReferenceFields;
		&XMLUserDefinedFields;
	</fields>

	<views>
		<view id="Grid">
			<field name="ma_vt"/>
			<field name="ten_vt%l"/>
			<field name="dvt"/>
			<field name="he_so"/>

			<field name="ma_kho"/>
			<field name="ma_vi_tri"/>
			<field name="ma_lo"/>

			<field name="ton13"/>

			<field name="so_luong"/>

			&SeparateInvoice.InternalTransportFormDetailViews;

			<field name="px_gia_dd"/>
			<field name="gia_nt"/>
			<field name="tien_nt"/>

			<field name="ma_nx"/>
			<field name="tk_du"/>
			<field name="tk_vt"/>

			&SeparateInvoice.DetailViews;
			&XMLWHReferenceView;
			&XMLUserDefinedViews;
		</view>
	</views>

	<commands>

		<command event="Showing">
			<text>
				<![CDATA[
declare @message nvarchar(4000)
select @message = ''
]]>&CommandControlLocationLotShowing;<![CDATA[
]]>&VisibleFieldGridShowing;<![CDATA[
select @message as message
return
]]>
			</text>
		</command>

		<command event="Loading">
			<text>
				&MultiViewer.GridView.Command.Loading;
			</text>
		</command>
	</commands>

	<script>
		<text>
			&MultiViewer.GridView.Loading;
			&MultiViewer.GridView.Render;
		</text>
	</script>

	<queries>
		<query event="Loading">
			<text>
				<![CDATA[
select top 0 @@fieldExternal from @@prime$partition$current a left join dmvt b on a.ma_vt = b.ma_vt ]]>&ESG.queryLoadingHoverField;<![CDATA[
]]>
			</text>
		</query>

		<query event="Finding">
			<text>
				&MultiViewer.Check;
				<![CDATA[
declare @$dVC smalldatetime, @$stock$View$Type char(1)
select @$dVC = ngay_ct from c84$000000 where stt_rec = @stt_rec

select @@fieldExternal, a.line_nbr as id$, a.stt_rec, a.line_nbr, cast(0 as numeric(28, 6)) as so_luong0 into ]]>&TempDetailTable;<![CDATA[
	from @@prime$partition$current a left join dmvt b on a.ma_vt = b.ma_vt ]]>&ESG.queryLoadingHoverField;<![CDATA[
		where stt_rec = @stt_rec order by @@orderByClause
update a set ton13 = 0 from ]]>&TempDetailTable;<![CDATA[ a
exec dbo.FastBusiness$Voucher$LoadCurrentStock @stt_rec, @$dVC, '', ']]>&TempDetailTable;<![CDATA[', 'Edit', @@language, @@userID, @@admin, '@@sysDatabaseName'
select * from ]]>&TempDetailTable;<![CDATA[ order by @@orderByClause
]]>
			</text>
		</query>

	</queries>

	&MultiViewer.Toolbar;
</grid>