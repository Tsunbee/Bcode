<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE report [
  <!ENTITY s SYSTEM ".\Include\Separate.xml">

  <!ENTITY e "../images/excel.gif">
]>

<report xmlns="urn:schemas-fast-com:data-report">
  <query>
    <text>
      <![CDATA[select * from cfgltc01 where form = @form order by form, stt, ma_so]]>
    </text>
  </query>

  <forms>
    <form id="0" templateFile ="CFBalanceSheetForm_01" commandArgument="Excel" urlImage="&e;">
      <header v="Báo cáo tình hình tài chính hợp nhất" e="Consolidated Statement of Financial Position"/>
      <download>
        <header v="Báo cáo tình hình tài chính hợp nhất" e="Consolidated Statement of Financial Position"/>
      </download>
    </form>
  </forms>

  <fields>
    <field name="h_stt">
      <header v="Stt" e="Number"/>
    </field>
    <field name="h_ma_so">
      <header v="Mã số" e="Code"/>
    </field>
    <field name="h_ma_so_in">
      <header v="Mã số khi in" e="Code When Print"/>
    </field>
    <field name="h_chi_tieu">
      <header v="Chỉ tiêu" e="Norm"/>
    </field>
    <field name="h_chi_tieu2">
      <header v="Chỉ tiêu khác" e="Other Norm"/>
    </field>
    <field name="h_thuyet_minh">
      <header v="Thuyết minh" e="Interpretation"/>
    </field>

    <field name="h_in_ck">
      <header v="In" e="Print"/>
    </field>
    <field name="h_in_tl_ck">
      <header v="In mẫu tóm lược" e="Print Summary Form"/>
    </field>
    <field name="h_bold">
      <header v="Kiểu chữ" e="Font Bold"/>
    </field>
    <field name="h_ts_nv">
      <header v="Phân loại" e="Classify"/>
    </field>

    <field name="h_ngoai_bang">
      <header v="Ngoại bảng" e="Off Balance Sheet"/>
    </field>
    <field name="h_ct_tong">
      <header v="Loại chỉ tiêu" e="Article Type"/>
    </field>
    <field name="h_kind">
      <header v="Cách tính" e="Calculating Way"/>
    </field>
    <field name="h_loai_dc">
      <header v="Loại điều chỉnh" e="Adjustment Type"/>
    </field>
    <field name="h_cach_tinh">
      <header v="Công thức" e="Formula"/>
    </field>
  </fields>
</report>