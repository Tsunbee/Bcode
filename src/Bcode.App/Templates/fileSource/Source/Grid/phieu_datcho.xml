	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">

	<!ENTITY % ReferenceNumber SYSTEM "..\Include\ReferenceNumber.ent">
	%ReferenceNumber;

	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;

	<!ENTITY % Repetition SYSTEM "..\Include\Repetition.ent">
	%Repetition;
	
	<!ENTITY TransferID "phieu_datcho">
	<!ENTITY % PrintRight SYSTEM "..\Include\PrintRightGrid.ent">
	%PrintRight;
]>

<grid type="Report" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Danh sách phiếu đặt chỗ" e=""></title>
	<subTitle v="từ ngày %d1 đến %d2, tình trạng: %tt, phiếu %isCreated" e="Date From %d1 to %d2, status: %tt, ticket %isCreated "></subTitle>
<fields>
		<field name="ma_dat_cho" isPrimaryKey="true" width="200" allowFilter="true" allowSorting="true" >			<header v="Mã đặt chỗ" e="???"></header>		</field>
			<field name="ngay_dat_cho" type="DateTime" dataFormatString="dd/MM/yyyy HH:mm" width="120" allowFilter="true" allowSorting="true">
			<header v="Ngày đặt chỗ" e="Date"></header>
		</field>
				<field name="ngay_gh" type="DateTime" dataFormatString="dd/MM/yyyy HH:mm" width="120" allowFilter="true" allowSorting="true">
			<header v="Ngày gia hạn" e="Date"></header>
		</field>
						<field name="ngay_dong_tien_bs" type="DateTime" dataFormatString="dd/MM/yyyy HH:mm" width="120" allowFilter="true" allowSorting="true">
			<header v="Ngày đóng tiền bổ sung" e="Date"></header>
		</field>		<field name="ma_sp" width="100" allowFilter="true" allowSorting="true">			<header v="Mã sản phẩm" e="Description"></header>		</field>
			<field name="ma_kh" width="100" allowFilter="true" allowSorting="true">
			<header v="Mã khách hàng" e="Description"></header>
		</field>
			<field name="ten_kh" width="150" allowFilter="true" allowSorting="true">
			<header v="Tên khách hàng" e="Description"></header>
		</field>
			<field name="ma_san" width="100" allowFilter="true" allowSorting="true">
			<header v="Mã sàn" e="Description"></header>
		</field>
					<field name="ten_san%l" width="150" allowFilter="true" allowSorting="true">
			<header v="Tên sàn" e="Description"></header>
		</field>
	<field name="ten_uu_tien" width="100" allowFilter="true" allowSorting="true">
			<header v="Ưu tiên" e="Description"></header>
		</field>
			<field name="stt_uu_tien" width="100" allowFilter="true" allowSorting="true">
			<header v="STT UT" e="Description"></header>
		</field>
			<field name="ma_nvbh" width="150" allowFilter="true" allowSorting="true">
			<header v="Nhân viên kinh doanh" e="Description"></header>
		</field>
					<field name="ten_nvbh" width="150" allowFilter="true" allowSorting="true">
			<header v="Tên nhân viên kinh doanh" e="Description"></header>
		</field>
		<field name="tong_tien" type="Decimal" dataFormatString="@foreignCurrencyAmountViewFormat" width="120" aggregate="Sum">
			<header v="Tổng tiền" e="Payment"></header>
			<items style="Numeric"/>
		</field>
			<field name="ly_do" width="300" allowFilter="true" allowSorting="true">
			<header v="Lý do" e="Description"></header>
		</field>
					<field name="status" width="150" allowFilter="true" allowSorting="true">
			<header v="Trạng thái" e="Description"></header>
		</field>
			<field name="tinh_trang_gd" width="200" allowFilter="true" allowSorting="true">
			<header v="Tình trạng đặt chỗ" e="Description"></header>
		</field>
		<field name="ten_tinh_trang" width="200" allowFilter="true" allowSorting="true">
			<header v="Tên tình trạng" e="Description"></header>
		</field>			<field name="Sync" width="150"  type="Boolean"  allowFilter="true" allowSorting="true">
			<header v="Trạng thái kế thừa" e="Description"></header>
		</field>
				<field name="Sync_date" width="150"  type="DateTime" dataFormatString="dd/MM/yyyy HH:mm"  allowFilter="true" allowSorting="true">
			<header v="Ngày kế thừa" e="Description"></header>
		</field>
					<field name="ds_dvcs" width="200" allowFilter="true" allowSorting="true">
			<header v="Mã đơn vị cơ sở" e="Description"></header>
		</field>
		<field name="stt_rec" width="200" allowFilter="true" allowSorting="true" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct]', Value: '[stt_rec]'}, Script: 'beforeDrillDown(this);'">
			<header v="Giấy báo có" e="Description"></header>
		</field>
		<field name="ma_ct" width="0" hidden="true">
			<header v="" e=""></header>
		</field>	
	</fields>

	<views>
		<view id="Grid">
				<field name="ma_dat_cho" />
				<field name="ngay_dat_cho" />
				<field name="ngay_gh" />
				<field name="ngay_dong_tien_bs" />
				<field name="ma_sp" />
				<field name="ma_kh" />
				<field name="ten_kh" />
				<field name="tong_tien" />
				<field name="ten_tinh_trang" />
				<field name="ten_uu_tien" />
				<field name="stt_uu_tien" />
				<field name="ma_san" />
				<field name="ten_san%l" />
				<field name="ma_nvbh" />
				<field name="ten_nvbh" />
				<field name="ly_do" />
				<field name="tinh_trang_gd" />
				<field name="ds_dvcs" />
				<field name="stt_rec" />
				<field name="ma_ct"/>
		</view>
</views>

	<commands>
		&XMLWhenGridShowingPrintRight;
		&XMLWhenReportLoading;
		&XMLWhenReportClosing;
	</commands>

	<script>
		<text>
			<![CDATA[
function load$GridReport$(g) {
		g.add_onRender(on$GridReport$Render);
		g.add_onResponseComplete(on$Grid$ResponseComplete);
		g.add_commandEvent(on$Grid$ExecuteCommand);
}
function dispose$GridReport$(g) {
	try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}
	try {g.remove_commandEvent(on$Grid$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$Grid$ResponseComplete);} catch (ex) {}
}
function on$GridReport$Render(sender, eventArgs) {
	var g = eventArgs.grid;  
	if (g._hiddenFields) {
		var a = g._hiddenFields, h = '';
		for (var i = 0; i < a.length; i++) {
			setGridHiddenFields(g, a[i].Fields, a[i].Value);
			if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
		}
		g._externalHiddenFields = h;
	}
}

function on$Grid$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender, id = g.get_id(), s = String.format('$find(\'{0}\')._focusWhenTabChanged();', id);
	switch (action) {
		case 'BC1Post':
			if (g._getItemValue(g._activeRow, g._getColumnOrder('ten_tinh_trang')) == 'Hủy' break;
			if (g._getItemValue(g._activeRow, g._getColumnOrder('ten_tinh_trang')) == 'Hết hạn' break;
			if (g._getItemValue(g._activeRow, g._getColumnOrder('ten_tinh_trang')) == 'Đã thu tiền' break;
			if (g._activeCell == null || g._getItemValue(g._activeRow, g._getColumnOrder('stt_rec')) != '') break;
			request$Posting(g)
			g.showForm('phieu_datcho$Post');
			break;
		default:
			break;
	}
}


function request$Posting(g) {
	var r = g._activeRow;
	g._ma_kh = g._getItemValue(r, g._getColumnOrder('ma_kh'));
	g._ten_kh = g._getItemValue(r, g._getColumnOrder('ten_kh'));
	g._ma_dat_cho = g._getItemValue(r, g._getColumnOrder('ma_dat_cho'));
	g._ma_sp = g._getItemValue(r, g._getColumnOrder('ma_sp'));
	g._stt_uu_tien = g._getItemValue(r, g._getColumnOrder('stt_uu_tien'));
	g._ma_san = g._getItemValue(r, g._getColumnOrder('ma_san'));
}

function on$Grid$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		default:
			break;
	}
} 
function setGridHiddenFields(g, c, v) {
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var l = g._getColumnOrder($func.trim(a[i]));
		if (l != -1) g._setColumnVisible(l, !v);
	}
}
function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
]]>
			&PrintRightScript;
		</text>
	</script>
	
	<css>
		<text>
			<![CDATA[
div.BC1Post{background-image:url(../images/Operation.png);background-repeat:no-repeat;background-position:0 0;}
div.TextBC1Post{background-image:url(../images/TextApprove.png),url(../images/Line.png);background-repeat:no-repeat,repeat-x;background-position:0 0;}
div.BC1PostOverGreen, div.TextBC1PostOverGreen{background-position-y:-22px;}
]]>
		</text>
	</css>
	

	<toolbar>
		<button command="Search">
			<title v="Toolbar.Search" e="Toolbar.Search"></title>
		</button>
		<button command="Print">
			<title v="Toolbar.Print" e="Toolbar.Print"></title>
		</button>
		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"></title>
		</button>
		<button command="Aggregate">
			<title v="Toolbar.Aggregate" e="Toolbar.Aggregate"></title>
		</button>
		<button command="Seprate">
			<title v="-" e="-"></title>
		</button>
		<button command="BC1Post">
			<title v="Tạo giấy báo có $$120" e="Post to GL$$120"></title>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>
</grid>