<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY Identity "zrpt_71">
	<!ENTITY XMLWhenFilterLoading SYSTEM "..\Include\XML\WhenFilterLoading.xml">
	<!ENTITY XMLWhenFilterClosing SYSTEM "..\Include\XML\WhenFilterClosing.xml">
	<!ENTITY OutlineCss SYSTEM "..\Include\Javascript\OutlineCss.txt">
	<!ENTITY OutlineEntry SYSTEM "..\Include\Javascript\OutlineEntry.txt">
	<!ENTITY OnSelectionOutline SYSTEM "..\Include\Javascript\OnSelectionOutline.txt">
	<!ENTITY JavascriptReportFilter SYSTEM "..\Include\Javascript\ReportFilter.txt">
	
]>

<dir type="Report" id="1" cache="true" xmlns="urn:schemas-fast-com:data-dir">
	<title v="Điều kiện lọc" e="Filter Condition"></title>
	<fields>
		<field name="ngay_dh_tu" type="DateTime" dataFormatString="@datetimeFormat" allowNulls="false" aliasName="fromDate" defaultValue="new Date()">
			<header v="Từ ngày" e="Date from"></header>
			<footer v="Ngày đơn hàng từ/ đến" e="Order Date from/to"></footer>
		</field>
		<field name="ngay_dh_den" type="DateTime" dataFormatString="@datetimeFormat" allowNulls="false" aliasName="toDate" defaultValue="new Date()">
			<header v="Đến ngày" e="Date to"></header>
		</field>
		<field name="ngay_nk_tu" type="DateTime" dataFormatString="@datetimeFormat">
			<header v="Từ ngày" e="Date from"></header>
			<footer v="Ngày nhập kho từ/ đến" e="Receipt Date from/to"></footer>
		</field>
		<field name="ngay_nk_den" type="DateTime" dataFormatString="@datetimeFormat">
			<header v="Đến ngày" e="Date to"></header>
		</field>
		<field name="ngay_hd_tu" type="DateTime" dataFormatString="@datetimeFormat">
			<header v="Từ ngày" e="Date from"></header>
			<footer v="Ngày hóa đơn từ/ đến" e="Invoice Date from/to"></footer>
		</field>
		<field name="ngay_hd_den" type="DateTime" dataFormatString="@datetimeFormat">
			<header v="Đến ngày" e="Date to"></header>
		</field>
		
		<field name="ma_kh">
			<header v="Khách hàng" e="Customer"></header>
			<items style="AutoComplete" controller="Customer" reference="ten_kh%l" key="status = '1'" check="1=1" information="ma_kh$dmkh.ten_kh%l"/>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''" inactivate="true">
			<header v="" e=""></header>
		</field>
		
		<field name="tien_hd" dataFormatString="0, 1, *" clientDefault="*" align="right">
			<header v="Tiền còn lại" e="Amount remaining"></header>	
			<footer v="0 – Số tiền còn lại = 0, 1 – Số tiền còn lại khác 0, * - Tất cả" e="0 – Remaining amount =0, 1 – Remaining amount not 0, * - All"></footer>	
			<items style="Mask" />
		</field>
		<field name="ma_dvcs">
			<header v="Đơn vị" e="Unit"></header>
			<items style="Lookup" controller="Unit" key="status = '1'" check="1=1"/>
		</field>
	</fields>

	<views> 
		<view id="Dir">			<item value="150, 40, 60, 100, 130, 0, 50, 0"/>			<item value="1101----: [ngay_dh_tu].Description, [ngay_dh_tu], [ngay_dh_den]"/>
			<item value="1101----: [ngay_nk_tu].Description, [ngay_nk_tu], [ngay_nk_den]"/>
			<item value="1101----: [ngay_hd_tu].Description, [ngay_hd_tu], [ngay_hd_den]"/>			<item value="110100--: [ma_kh].Label, [ma_kh], [ten_kh%l]"/>
			<item value="1110000-: [tien_hd].Label, [tien_hd], [tien_hd].Description"/>			<item value="110000--: [ma_dvcs].Label, [ma_dvcs]"/>
		</view>  
	</views>

	<commands>
		&XMLWhenFilterLoading;
		&XMLWhenFilterClosing;
		
		<command event="Processing">
			<text>
				<![CDATA[
select @ngay_dh_tu as tu_ngay, @ngay_dh_den as den_ngay
exec zrpt_71 @ngay_dh_tu, @ngay_dh_den, @ngay_nk_tu, @ngay_nk_den, @ngay_hd_tu, @ngay_hd_den, @ma_kh, @tien_hd, @ma_dvcs, '@@sysDatabaseName', @@language, @@userID, @@admin
]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			&OutlineEntry;
			&JavascriptReportFilter; 
			<![CDATA[
function active$VoucherFilter$(f) {
	f.add_onResponseComplete(on$Filter$ResponseComplete); 
	changeLookupReadonly(f, 'ma_dvcs');
}
function close$VoucherFilter$(f) {
	try {f.remove_onResponseComplete(on$Filter$ResponseComplete);} catch (ex) {}
}
function on$Filter$ResponseComplete(sender, e) {
	var f = e.object, context = e.type.Context, result = e.type.Result;
	switch (context) {
		case 'Checking':
			var g = f.grid; 
			g._hiddenForms = [];
			g._alterTitle = [null, [['%s1', f.getItem('ngay_dh_tu').value, true], ['%s2', f.getItem('ngay_dh_den').value, true]]];
			//remove$GridReport$Filter(g);
			break;
		default:
			break;
	}
}
]]>
		</text>
	</script>

	&OutlineCss;
</dir>