<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>
	
<grid type="Report" valid="systotal = 1" filter="" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Kế hoạch thu bán hàng" e="Sales collection plan"></title>
	<subTitle v="Từ ngày %s1 đến ngày %s2" e="From Date %s1 to %s2"></subTitle>
	
	<fields>
		<field name="stt" width="60" type="Decimal" dataFormatString="####" allowSorting="true" allowFilter="true">
			<header v="Stt" e=" Number"></header>
		</field>
		<field name="ten" width="300" allowSorting="true" allowFilter="true">
			<header v="Dự án" e="Project"></header>
		</field>
		<field name="t_kh" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Kế hoạch - Tổng cộng" e="Planning - Total Amount"></header>
		</field>
		<field name="kh_trong_han" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="true">
			<header v="Kế hoạch - Nợ trong hạn và chưa đến hạn (còn phải thu theo tiến độ) (P.KT)" e="Planning - Debts due and not yet due (to be collected according to schedule) (Accounting Department)"></header>
		</field>
		<field name="kh_gac_so" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="true">
			<header v="Kế hoạch - Thu 5% ra sổ" e="Planning - Collect 5% and record it in the ledger"></header>
		</field>
		<field name="kh_giai_ngan" width="200" type="Decimal" dataFormatString="@baseCurrencyPriceViewFormat" allowSorting="true" allowFilter="true">
			<header v="Kế hoạch - Giải ngân KH (P.Tài chính)" e="Planning - Disburse funds to customers (Finance Department)"></header>
		</field>
		<field name="kh_qua_han" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="true">
			<header v="Kế hoạch - Nợ quá hạn (P.XLN)" e="Planning - Overdue debts (debt resolution department)"></header>
		</field>
		<field name="t_tt" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Thực hiện - Tổng cộng" e="Actutal - Total Amount"></header>
		</field>
		<field name="tt_trong_han" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Thực hiện - Nợ trong hạn và chưa đến hạn (còn phải thu theo tiến độ) (P.KT)" e="Actutal - Debts due and not yet due (to be collected according to schedule) (Accounting Department)"></header>
		</field>
		<field name="tt_gac_so" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Thực hiện - Thu 5% ra sổ (P.KT)" e="Collect 5% and record it in the ledger (Accounting Department)"></header>
		</field>
		<field name="tt_giai_ngan" width="200" type="Decimal" dataFormatString="@baseCurrencyPriceViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Thực hiện - Giải ngân KH (P.Tài chính)" e="Actutal - Disburse funds to customers (Finance Department)"></header>
		</field>
		<field name="tt_qua_han" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Thực hiện - Nợ quá hạn (P.XLN)" e="Actutal - Overdue debts (debt resolution department)"></header>
		</field>
		<field name="tt_thanh_ly" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Thực hiện - Thu thanh lý (P.XLN)" e="Actutal - Collect liquidation (debt resolution department)"></header>
		</field>
		<field name="tt_ban_moi" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Thực hiện - Bán mới (P.XLN)" e="Actutal - New sales (debt resolution department)"></header>
		</field>
		
		<field name="systotal" width="0" inactivate="true" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="stt"/>
			<field name="ten"/>
			<field name="t_kh"/>
			<field name="kh_trong_han"/>
			<field name="kh_gac_so"/>
			<field name="kh_giai_ngan"/>
			<field name="kh_qua_han"/>
			<field name="t_tt"/>
			<field name="tt_trong_han"/>
			<field name="tt_gac_so"/>
			<field name="tt_giai_ngan"/>
			<field name="tt_qua_han"/>
			<field name="tt_thanh_ly"/>
			<field name="tt_ban_moi"/>
			<field name="systotal"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
		  <text>
			<![CDATA[select 'load$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
		<command event="Closing">
		  <text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
function on$GridReport$Render(sender, eventArgs) {
	var g = eventArgs.grid;  
	if (g._hiddenFields) {
		var a = g._hiddenFields, h = '';
		for (var i = 0; i < a.length; i++) {
			setGridHiddenFields(g, a[i].Fields, a[i].Value);
			if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
		}
		g._externalHiddenFields = h;
	}
	setColorWithCondition(g, 'systotal','0', '', 'bold','');
}
function setGridHiddenFields(g, c, v) {
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var l = g._getColumnOrder($func.trim(a[i]));
		if (l != -1) g._setColumnVisible(l, !v);
	}
}
function setColorWithCondition(g, field, condition, color, bold, italic) {
		var iC	
		try {iC = g._getColumnOrder(field);				
			var r = g._rowCount;
			var i;
			for (i = 1; i <= r; i++) {
					if (g._getItemValue(i, iC) == condition) {
							setColor4Row(g, i, color);
							setFont4Row(g, i, bold, italic);
					}
			}
		}
		catch (err){}
}

function setColor4Row(g, rNumber, color) {
		var c = g._columnCount;
		var i;
		var o;
		for (i = 1; i <= c; i++) {
				o = g._getItem(rNumber, i);
				if (color != '') {
					//	o.style.color = color;
						$get(g.get_id()+ '_gridCell_' + rNumber.toString() + '.' +  i.toString()).style.backgroundColor = color;
						
					//	o.style.backgroundColor = color;
						
				}
		}
}

function setFont4Row(g, rNumber, bold, italic) {
		var c = g._columnCount;
		var i;
		var o;
		for (i = 1; i <= c; i++) {
				o = g._getItem(rNumber, i);
				if (bold != '') {
						o.style.fontWeight = bold;
				}
				if (italic != '') {
						o.style.fontStyle = italic;
				}
		}
}
function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
]]>
		</text>
	</script>
	
	&XMLStandardReportToolbar;
</grid>