    <Parameter Name="f_bi_ten_vt2" DataType="System.String" Expression="IIf([languageType]==1  , IIf([d1.ten_vt2] != &quot;&quot;, &quot;\n&quot; + [d1.ten_vt2], &quot;&quot;)  , IIf([d1.ten_vt] != &quot;&quot;, &quot;\n&quot; + [d1.ten_vt], &quot;&quot;))"/>
