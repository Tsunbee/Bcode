<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLStandardDetailToolbar SYSTEM "..\Include\XML\StandardDetailToolbar.xml">

	<!ENTITY % Extra SYSTEM "..\Include\Extra\Extra.ent">
	%Extra;
	<!ENTITY % Clipboard.List SYSTEM "..\Include\Clipboard\Clipboard.List">
	%Clipboard.List;
	<!ENTITY % Clipboard SYSTEM "..\Include\Clipboard\Clipboard.ent">
	%Clipboard;
]>

<grid table="zdmhd9" type="Detail" code="ma_hd" order="ma_hd, line_nbr" xmlns="urn:schemas-fast-com:data-grid">
	<title v="" e=""></title>
	<subTitle v="" e=""></subTitle>

	<fields>
		<field name="ma_kh" allowNulls="false" width="100" aliasName="a">
			<header v="Khách hàng" e="Customer"></header>
			<items style="AutoComplete" controller="Customer" reference="ten_kh%l" key="status = '1'" check="1 = 1" information="ma_kh$dmkh.ten_kh%l" new="Default"/>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''" inactivate="true" width="200" aliasName="b">
			<header v="Tên khách hàng" e="Customer Name"></header>
		</field>
		<field name="ngay_chuyen_doi" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100" aliasName="a">
			<header v="Ngày chuyển đổi" e="Transfer Date"></header>
		</field>
		
		<field name="ghi_chu" width="300" aliasName="a">
			<header v="Ghi chú" e="Note"></header>
		</field>
		
		<field name="line_nbr" type="Int32" isPrimaryKey="true" width="0" align="right" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ma_kh"/>
			<field name="ten_kh%l"/>
			<field name="ngay_chuyen_doi"/>
			<field name="ghi_chu"/>
			<field name="line_nbr"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>
				<![CDATA[
select 'load$GridDetail$dCustomer(this);]]>&Clipboard.Loading;<![CDATA[' as message
return]]>
			</text>
		</command>
		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$GridDetail$dCustomer(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[/* <flatten type="Javascript"> */
function load$GridDetail$dCustomer(g) {
	g.add_commandEvent(on$GridDetail$dCustomer$ExecuteCommand);
}
function dispose$GridDetail$dCustomer(g) {
	try {g.remove_commandEvent(on$GridDetail$dCustomer$ExecuteCommand);} catch (ex) {}
}
/* </flatten> */
function on$GridDetail$dCustomer$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender, f = g.get_element().parentForm;
	switch (action) {
		]]>&Clipboard.Event.Before;<![CDATA[
		]]>&Clipboard.Event.Before.Request;<![CDATA[
		]]>&Clipboard.Event.Before.Process;<![CDATA[
		]]>&Clipboard.Event.After;<![CDATA[
		]]>&Clipboard.Event.After.Process;<![CDATA[
		]]>&GridExtraToolbarExecuteCommandScript;<![CDATA[
		default:
			break;
	}
}
]]>
			&GridExtraToolbarScript;
		</text>
	</script>

	<css>
		<text>
			&GridExtraToolbarCss;
		</text>
	</css>

	<toolbar>
		<button command="Insert">
			<title v="Toolbar.Insert" e="Toolbar.Insert"></title>
		</button>
		<button command="Grow">
			<title v="Toolbar.Grow" e="Toolbar.Grow"></title>
		</button>
		<button command="Down">
			<title v="Toolbar.Down" e="Toolbar.Down"></title>
		</button>
		<button command="Clone">
			<title v="Toolbar.Clone" e="Toolbar.Clone"></title>
		</button>
		<button command="Remove">
			<title v="Toolbar.Remove" e="Toolbar.Remove"></title>
		</button>
		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"></title>
		</button>

		&GridExtraToolbar;

		<button command="-">
			<title v="-" e="-"/>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>

	<queries>
		<query event="Loading">
			<text>
				<![CDATA[
select @@fieldExternal from @@table a left join dmkh b on a.ma_kh = b.ma_kh where @@whereClause order by @@orderByClause
]]>
			</text>
		</query>
	</queries>
</grid>