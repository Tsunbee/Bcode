<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">

	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Bảng kê phiếu nhập kho mua hàng" e="Report"></title>
	<subTitle v="Từ ngày %d1 đến ngày %d2..." e="From data %d1 to %d2"></subTitle>
<fields>
		<field name="ngay_ct" type="DateTime" width="80" dataFormatString="@datetimeFormat" allowSorting="true" allowFilter="true">
			<header v="Ngày phiếu nhập" e="VC. Date"></header>
		</field>
		
		<field name="so_ct" width="120" align="right" allowSorting="true" allowFilter="true" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct]', Value: '[stt_rec]'}, Script: 'beforeDrillDown(this);'">
			<header v="Số ct" e="Voucher No."></header>
		</field>

		<field name="ma_kh" width="100" allowSorting="true" allowFilter="true">
			<header v="Mã ncc" e="Supplier ID"></header>
		</field>
		<field name="ten_kh%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên nhà cung cấp" e="Supplier Name"></header>
		</field>

	
		<field name="ma_vt" width="100" allowSorting="true" allowFilter="true">
			<header v="Mã hàng" e="Item Code"></header>
		</field>
		<field name="ten_vt%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên mặt hàng" e="Item Name"></header>
		</field>
			<field name="dvt" width="100" allowSorting="true" allowFilter="true">
			<header v="Đvt" e="UOM"></header>
		</field>

		<field name="so_luong" type="Decimal" dataFormatString="@quantityViewFormat" width="100" allowSorting="true" aggregate="Sum" allowFilter="&GridReportAllowFilter.Number;">
			<header v="SL phiếu nhập" e="Quantity"></header>
		</field>
		
		<field name="gia_nt" type="Decimal" dataFormatString="@baseCurrencyPriceViewFormat" width="100" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;">
			<header v="Giá nhập" e="Price"></header>
		</field>
		<field name="sl_hd" type="Decimal" dataFormatString="@quantityViewFormat" width="100" allowSorting="true" aggregate="Sum" allowFilter="&GridReportAllowFilter.Number;">
			<header v="SL hóa đơn" e="Quantity"></header>
		</field>
		<field name="sl_cl" type="Decimal" dataFormatString="@quantityViewFormat" width="100" allowSorting="true" aggregate="Sum" allowFilter="&GridReportAllowFilter.Number;">
			<header v="SL còn lại" e="Quantity"></header>
		</field>
		
			<field name="so_hd" width="120" align="right" allowSorting="true" allowFilter="true" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct_hd]', Value: '[stt_rec_hd]'}, Script: 'beforeDrillDown(this);'">
			<header v="Số hóa đơn" e="Voucher No."></header>
		</field>
		
		<field name="ngay_hd" type="DateTime" width="80" dataFormatString="@datetimeFormat" allowSorting="true" allowFilter="true">
			<header v="Ngày hóa đơn" e="VC. Date"></header>
		</field>
		
		<field name="stt_rec" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_ct" width="60" hidden="false"  allowSorting="true" allowFilter="true">
			<header v="Mã ct" e=""></header>
		</field>
		<field name="stt_rec_hd" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_ct_hd" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
</fields>

<views>
	<view id="Grid">
			<field name="ma_ct"/>
			<field name="ngay_ct"/>
			<field name="so_ct"/>
			<field name="ma_kh"/>
			<field name="ten_kh%l"/>
			<field name="ma_vt"/>
			<field name="ten_vt%l"/>
			<field name="dvt"/>
			<field name="so_luong"/>
			<field name="gia_nt"/>
			<field name="sl_hd"/>
			<field name="sl_cl"/>
			<field name="so_hd"/>
			<field name="ngay_hd"/>
			<field name="stt_rec"/>
			
			<field name="stt_rec_hd"/>
			<field name="ma_ct_hd"/>
	</view>
</views>

	<commands>
		&XMLWhenReportLoading;
		&XMLWhenReportClosing;
	</commands>

	<script>
		<text>
			<![CDATA[
function load$GridReport$(g) {
	g.add_onRender(on$GridReport$Render);
	g.add_onResponseComplete(on$GridMain$ResponseComplete);	
	g.add_commandEvent(on$EInvoice$ExecuteCommand);
	
	g._data = null;
}
function dispose$GridReport$(g) {
		g._data = null;
		try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}
		try {g.remove_commandEvent(on$EInvoice$ExecuteCommand);} catch (ex) {}
		try {g.remove_onResponseComplete(on$GridMain$ResponseComplete);} catch (ex) {}	
}
function on$GridReport$Render(sender, eventArgs) {
	var g = eventArgs.grid, l1 = g._getColumnOrder('success');
		for(var i = 1; i <= g._rowCount; i++){
			var v = g._getItemValue(i, l1);
			var o = g._getItem(i, l1).closest('tr').childNodes;
			for(var j = 0; j < o.length; j++){
				if (o[j].childNodes[0].childNodes[0] != null){
					if (v == 0) o[j].childNodes[0].childNodes[0].style.color = 'red';
				}
			}
	}
}
function on$EInvoice$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender, id = g.get_id();
	switch (action) {
		default:
			break;
	}
}

function on$GridMain$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {	
		default:
			break;
	}
}
		

function setGridHiddenFields(g, c, v) {
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var l = g._getColumnOrder($func.trim(a[i]));
		if (l != -1) g._setColumnVisible(l, !v);
	}
}
function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
]]>
		</text>
</script>

<response>
</response>

<css>
</css>

	<toolbar>
	<button command="Seprate">
		<title v="-" e="-"></title>
	</button>
	<button command="Search">
		<title v="Toolbar.Search" e="Toolbar.Search"></title>
	</button>
	<button command="Seprate">
		<title v="-" e="-"></title>
	</button>
	<button command="Aggregate">
		<title v="Toolbar.Aggregate" e="Toolbar.Aggregate"></title>
	</button>
		<button command="Seprate">
		<title v="-" e="-"></title>
	</button>
	
	<button command="Export">
		<title v="Toolbar.Export" e="Toolbar.Export"></title>
	</button>
	
</toolbar>
</grid>