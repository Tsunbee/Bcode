if dbo.FastBusiness$Function$CheckSQLInjection(@stt_rec) = 0 return
]]>&GLTranReportSql;<![CDATA[
declare @isFC bit, @q nvarchar(4000), @m_ma_nt0 char(3)
select @isFC = case when @@form in ('010', '030') then 0 else 1 end
select @m_ma_nt0 = rtrim(val) from options where name = 'm_ma_nt0'
select @isFC as isFC, ltrim(rtrim(so_ct)) as so_ct, case when @isFC = 1 then ma_nt else @m_ma_nt0 end as ma_nt, ngay_ct, t_tien, t_tien_nt, t_ck, t_ck_nt
  from @@prime$partition$current where stt_rec = @stt_rec

select identity(int, 1, 1) as line_nbr, a.ma_ph, c.dvt, c.ten_ph, c.ten_ph2, a.so_luong, a.gia_nt, a.gia, a.tien_nt as tien_nt, a.tien as tien, a.ck_nt, a.ck
  into #t from d88$$partition$current a left join @@prime$partition$current b on a.stt_rec = b.stt_rec left join dmpqt c on a.ma_ph = c.ma_ph where a.stt_rec = @stt_rec order by a.line_nbr

select * from #t order by line_nbr
]]>
      &Conditional.Unit.Profile.Query.Result;
    </text>
  </query>

