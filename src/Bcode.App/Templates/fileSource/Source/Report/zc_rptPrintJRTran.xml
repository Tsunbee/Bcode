<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE report [
	<!ENTITY b SYSTEM ".\Include\BaseCurrency.xml">
	<!ENTITY f SYSTEM ".\Include\ForeignCurrency.xml">
	<!ENTITY s SYSTEM ".\Include\Separate.xml">

	<!ENTITY p "../images/pdf.gif">
	<!ENTITY e "../images/excel.gif">
	<!ENTITY bi "../images/bilingual.png">

	<!ENTITY Controller "JRTran">
	<!ENTITY VoucherCode "HD9">
	<!ENTITY ISPrimeTable "m29$&#37;Partition">
	<!ENTITY ISDetailTable "d29$&#37;Partition">
	<!ENTITY GLTranReport SYSTEM ".\Include\rptPrintGLTranReportBI.xml">
	<!ENTITY GLTranReportSql SYSTEM ".\Include\ExtrptPrintGLTranReportSql.txt">

	<!ENTITY % Profile SYSTEM ".\Config\Profile.ent">
	%Profile;
	
	<!ENTITY % Multi.Print SYSTEM "..\Include\MultiPrint.ent">
	%Multi.Print;
]>

<report xmlns="urn:schemas-fast-com:data-report">
	<query>
		<text>
			&Conditional.Unit.Profile.Query.Declare; 
			&Conditional.Unit.Profile.Query.Select.Filter;
			<![CDATA[
select * into #$keys from @$keys
declare @formTypeIS2 tinyint
set @formTypeIS2 = 0
if @@form = '110' begin
	exec zrs_rptPrintJRTranExport @$ngay_ct1, @$ngay_ct2, @$ma_dvcs, '', ']]>&VoucherCode;<![CDATA[', ']]>&Controller;<![CDATA[', @formTypeIS2, 1, ']]>&ISPrimeTable;<![CDATA[', ']]>&ISDetailTable;<![CDATA[', @@language, @@userID, @@admin, '@@sysDatabaseName'
	return
	end 
	]]>&GLTranReportSql;<![CDATA[

]]>
			&Conditional.Unit.Profile.Query.Result;
		</text>
	</query>

	<forms>    
		<form id="110" reportFile="zc_rptPrintJRTran" templateFile="" commandArgument="Pdf" urlImage="&p;" >
			<header v="Mẫu chuẩn" e="Standard Form"></header>
			<download>
				<header v="Chứng từ phải thu khác, chứng từ bù trừ công nợ" e="Issuing Transaction (*)"></header>
			</download>
		</form>
		
		&s;
		&GLTranReport;

	</forms>

	<fields>
		<field name="title" type="String">
			<header v="C.TỪ PHẢI THU KHÁC, C.TỪ BÙ TRỪ CÔNG NỢ" e="MISC. RECEIVABLE, DEBIT/CREDIT MEMO"/>
		</field>
		<field name="h_so_phieu" type="String">
			<header v="Số phiếu: " e="Voucher No.: "/>
		</field>
		<field name="bi_h_so_phieu" type="String">
			<header v="Số phiếu" e="Voucher No."/>
		</field>
		<field name="h_space" type="String">
			<header v=" " e=" "/>
		</field>

		<field name="h_dien_giai" type="String">
			<header v="Diễn giải " e="Description"/>
		</field>
		<field name="h_vu_viec" type="String">
			<header v="Vụ việc " e="Job ID"/>
		</field>
		<field name="h_tk" type="String">
			<header v="Tài khoản " e="Account"/>
		</field>
		<field name="h_phat_sinh_no" type="String">
			<header v="Phát sinh nợ " e="Debit Amount"/>
		</field>
		<field name="h_phat_sinh_co" type="String">
			<header v="Phát sinh có " e="Credit Amount"/>
		</field>

		<field name="h_tt_bang_chu" type="String">
			<header v="Số tiền (viết bằng chữ): " e="Amount (in Words):"/>
		</field>
	</fields>
</report>