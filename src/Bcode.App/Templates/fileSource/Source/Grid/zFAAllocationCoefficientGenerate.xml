<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLStandardDetailToolbar SYSTEM "..\Include\XML\StandardDetailToolbar.xml">

	<!ENTITY % Extra SYSTEM "..\Include\Extra\Extra.ent">
	%Extra;
	<!ENTITY % Clipboard.List SYSTEM "..\Include\Clipboard\Clipboard.List">
	%Clipboard.List;
	<!ENTITY % Clipboard SYSTEM "..\Include\Clipboard\Clipboard.ent">
	%Clipboard;
	
	<!ENTITY % Tiny.External SYSTEM "..\Include\Tiny.External.ent">
	%Tiny.External;
	%Tiny.External.FADepartment;
	%Tiny.External.FAAllocationCoefficient;
]>

<grid table="cthspbts" type="Detail" code="" order="" xmlns="urn:schemas-fast-com:data-grid">
	<title v="" e=""></title>
	<subTitle v="" e=""></subTitle>

	<fields>
		<field name="tk_kh" allowNulls="false" width="100" aliasName="a" clientDefault="Default">
			<header v="Tk khấu hao" e="Depreciation Account"></header>
			<items style="AutoComplete" controller="Account" reference="ten_tk_kh%l" key="status = '1' and loai_tk ='1'" check=" loai_tk ='1'" information="tk$dmtk.ten_tk%l" new="Default"/>
		</field>
		<field name="ten_tk_kh%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true" clientDefault="Default">
			<header v="" e=""></header>
		</field>
		<field name="tk_cp" allowNulls="false" width="100" aliasName="a" clientDefault="Default">
			<header v="Tk chi phí" e="Expense Account"></header>
			<items style="AutoComplete" controller="Account" reference="ten_tk_cp%l" key="status = '1' and loai_tk ='1'" check=" loai_tk ='1'" information="tk$dmtk.ten_tk%l" new="Default"/>
		</field>
		<field name="ten_tk_cp%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true" clientDefault="Default">
			<header v="" e=""></header>
		</field>
		<field name="ma_bp_ts" width="100" aliasName="a">
			<header v="Bộ phận sử dụng" e="Using Department"></header>
			<items style="AutoComplete" controller="&Tiny.External.Lookup.DepartmentController;" reference="ten_bp_ts%l" key="status = '1'" check="1 = 1" information="&Tiny.External.Lookup.DepartmentInformation;" new="&Tiny.External.Lookup.DepartmentNew;"/>
		</field>
		<field name="ten_bp_ts%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_kh" width="100" aliasName="a">
			<header v="Khách hàng" e="Customer"></header>
			<items style="AutoComplete" controller="Customer" reference="ten_kh%l" key="status = '1'" check="1 = 1" information="ma_kh$dmkh.ten_kh%l" new="Default"/>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_vv" width="100" aliasName="a">
			<header v="Vụ việc" e="Job"></header>
			<items style="AutoComplete" controller="Job" reference="ten_vv%l" key="status = '1'" check="1 = 1" information="ma_vv$dmvv.ten_vv%l" new="Default"/>
		</field>
		<field name="ten_vv%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_bp" width="100" aliasName="a">
			<header v="Bộ phận" e="Department"></header>
			<items style="AutoComplete" controller="Department" reference="ten_bp%l" key=" status = '1'" check="1 = 1" information="ma_bp$dmbp.ten_bp%l" new="Default"/>
		</field>
		<field name="ten_bp%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_hd" width="100" aliasName="a">
			<header v="Mã hợp đồng" e="Contract"></header>
			<items style="AutoComplete" controller="Contract" reference="ten_hd%l" key="status = '1'" check="1 = 1" information="ma_hd$dmhd.ten_hd%l" new="Default"/>
		</field>
		<field name="ten_hd%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="so_lsx" align="right" width="100" aliasName="a">
			<items style="AutoComplete" controller="MO" reference="ten_lsx%l" information="so_lsx$phlsx.dien_giai"/>
			<header v="Số lsx" e="MO Number"></header>
		</field>
		<field name="ten_lsx%l" readOnly="true" external="true" defaultValue="''" inactivate="true" hidden="true">
			<header v="" e=""></header>
		</field>

		<field name="he_so" type="Decimal" dataFormatString="### ### ### ##0.000" width="100" aliasName="a">
			<header v="Hệ số" e="Coefficient"></header>
			<items style="Numeric"></items>
		</field>
		
		<field name="s4" dataFormatString="0, 1, 2" align="right" defaultValue="0" width="80" clientDefault="0" aliasName="a">
			<header v="CP hợp lý" e="Reasonable Exepense"></header>
			<footer v="0 - Không xác định, 1 - Hợp lý, 2 - Không hợp lý" e="0 - Unknow, 1 - Reasonable, 2 - Unreasonable"></footer>
			<items style="Mask"/>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ma_vv"/>
			<field name="ten_vv%l"/>
			<field name="he_so"/>
			<field name="tk_kh"/>
			<field name="ten_tk_kh%l"/>
			<field name="tk_cp"/>
			<field name="ten_tk_cp%l"/>
			<field name="ma_bp_ts"/>
			<field name="ten_bp_ts%l"/>
			<field name="ma_kh"/>
			<field name="ten_kh%l"/>

			<field name="ma_bp"/>
			<field name="ten_bp%l"/>
			<field name="ma_hd"/>
			<field name="ten_hd%l"/>
			<field name="so_lsx"/>
			<field name="ten_lsx%l"/>
			<field name="s4"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>
				<![CDATA[
select 'load$GridDetail$(this);]]>&Clipboard.Loading;<![CDATA[' as message
return]]>
			</text>
		</command>
		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$GridDetail$(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[/* <flatten type="Javascript"> */
function load$GridDetail$(g) {g.add_commandEvent(on$GridDetail$ExecuteCommand);}
function dispose$GridDetail$(g) {try {g.remove_commandEvent(on$GridDetail$ExecuteCommand);} catch (ex) {}}
/* </flatten> */
function on$GridDetail$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender, f = g.get_element().parentForm;
	switch (action) {
		]]>&Clipboard.Event.Before;<![CDATA[
		]]>&Clipboard.Event.Before.Request;<![CDATA[
		]]>&Clipboard.Event.Before.Process;<![CDATA[
		]]>&Clipboard.Event.After;<![CDATA[
		]]>&Clipboard.Event.After.Process;<![CDATA[
		]]>&GridExtraToolbarExecuteCommandScript;<![CDATA[
		default:
			break;
	}
}
]]>
			&GridExtraToolbarScript;
		</text>
	</script>

	<css>
		<text>
			&GridExtraToolbarCss;
		</text>
	</css>

	<toolbar>
		<button command="Insert">
			<title v="Toolbar.Insert" e="Toolbar.Insert"></title>
		</button>
		<button command="Grow">
			<title v="Toolbar.Grow" e="Toolbar.Grow"></title>
		</button>
		<button command="Down">
			<title v="Toolbar.Down" e="Toolbar.Down"></title>
		</button>
		<button command="Clone">
			<title v="Toolbar.Clone" e="Toolbar.Clone"></title>
		</button>
		<button command="Remove">
			<title v="Toolbar.Remove" e="Toolbar.Remove"></title>
		</button>


		&GridExtraToolbar;

		<button command="-">
			<title v="-" e="-"/>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>

	<queries>
		<query event="Loading">
			<text>
				<![CDATA[
select top 0 @@fieldExternal from @@table a
]]>
			</text>
		</query>
	</queries>
</grid>