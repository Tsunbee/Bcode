	<title v="Phiếu thanh toán tạm ứng" e="Payment of Advanced Amount"></title>
	<subTitle v="Cập nhật phiếu thanh toán tạm ứng: thêm, sửa, xóa..." e="Add, Edit, Delete Payment of Advanced Amount..."></subTitle>
	<partition table="c32$000000" prime="m32$" inquiry="i32$" field="ngay_ct" expression="convert(char(6), {0}, 112)" increase="dateadd(month, 1, {0})" default="000000"/>
	<fields>
		<field name="stt_rec" isPrimaryKey="true" width="0" hidden="true" aliasName="a">
			<header v="" e=""></header>
		</field>
		<field name="ma_dvcs" width="100" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Đơn vị" e="Unit"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ngay_ct" type="DateTime" dataFormatString="@datetimeFormat" width="100" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Ngày" e="Date"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ma_nk" width="100" align="right" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;" aliasName="a">
			<header v="Mã quyển" e="Voucher Book"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="so_ct" width="100" align="right" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;" aliasName="a">
			<header v="Số" e="Number"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ma_kh" width="100" aliasName="a" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Mã khách" e="Customer ID"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ten_kh%l" width="300" external="true" aliasName="b" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Tên khách" e="Customer Name"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="t_tt_nt" type="Decimal" dataFormatString="@foreignCurrencyAmountViewFormat" width="120" clientDefault="0.00" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;" aggregate="Sum">
			<header v="Tiền" e="Amount"></header>
			<items style="Numeric"/>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ma_nt" width="100" aliasName="a" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Mã nt" e="Currency Code"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="tk" width="100" aliasName="a" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Tài khoản có" e="Credit Account"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="tk_no" width="100" external="true" defaultValue="''" aliasName="e1.tk_no" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Tài khoản nợ" e="Debit Account"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		
		<field name="ma_td1" width="100" external="true" defaultValue="''" aliasName="e1.ma_td1" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;">
			<header v="Sàn" e="Floor"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ma_hd" width="100" external="true" defaultValue="''" aliasName="e1.ma_hd" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;" >
			<header v="Hợp đồng" e="Contract"></header>
			<query>&InsertCommandFilter;</query>
		</field>
		<field name="ma_sp" width="100" external="true" defaultValue="''" aliasName="e1.ma_sp" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;"  >
			<header v="Sản phẩm" e="Product"></header>
			<query>&InsertCommandFilter;</query>
			</field>
			<field name="ma_vv" width="100" external="true" defaultValue="''" aliasName="e1.ma_vv" allowFilter="&GridVoucherAllowFilter;" allowSorting="&GridVoucherAllowSorting;" >
			<header v="Mã vụ việc" e="Job"></header>
			<query>&InsertCommandFilter;</query>
		</field>

	</fields>

	<views>
		<view id="Grid">
			<field name="stt_rec"/>
			<field name="ma_dvcs"/>
			<field name="ngay_ct"/>
			<field name="ma_nk"/>
			<field name="so_ct"/>
			<field name="ma_kh"/>
			<field name="ten_kh%l"/>
			<field name="t_tt_nt"/>
			<field name="ma_nt"/>
			<field name="tk"/>
			<field name="tk_no"/>

		<field name="ma_td1"/>
		<field name="ma_hd"/>
		<field name="ma_sp"/>
		<field name="ma_vv"/>


		</view>
	</views>

	<commands>
		<command event="Showing">
			<text>
				<![CDATA[
declare @message nvarchar(4000)
select @message = ''
]]>&PrintRightGridShowing;&VisibleFieldGridShowing;<![CDATA[
select @message as message
return
]]>
			</text>
		</command>

		<command event="Loading">
			<text>
				&CreateTicket;
				&CommandWhenVoucherBeforeInit;
				<![CDATA[select @message = @message + 'this._authorize = ' + rtrim(@@sysDatabaseName.dbo.FastBusiness$System$GetAuthorize(@@admin, @@userID, 'ASTran', 'New')) + ';this._key = ''' + @ticket + ''';load$Grid(this);']]>
				&CommandWhenVoucherBeforeAddNew;
				&CommandWhenVoucherAfterInit;
			</text>
		</command>

		<command event="Closing">
			<text>
				<![CDATA[
select 'dispose$Grid(this);' as message
return
]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$Grid(g) {
	g.add_onResponseComplete(on$GridPaymentOfAdvancedAmount$ResponseComplete);
	g.add_commandEvent(on$GridPaymentOfAdvancedAmount$ExecuteCommand);

}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridPaymentOfAdvancedAmount$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridPaymentOfAdvancedAmount$ResponseComplete);} catch (ex) {}

}
function on$GridPaymentOfAdvancedAmount$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	switch (action) {
		case 'ImportData':
			show$Form(g, 'ASTranImport');
			break;
		case 'Download':
			]]>&UserDefinedDownload;<![CDATA[
			break;
		default:
			break;
	}
}
function on$GridPaymentOfAdvancedAmount$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		case 'Download':
			g._key = result[0].Value;
			break;
		
		default:
			break;
	}
}

function show$Form(g, c) {
	(g._authorize == 1) && (!g._denyNew) ? g.showForm(c) : $message.show(g._denyMessage ? g._denyMessage : $df.getResources(g._language, "Message.NotAccess"));
}
]]>
			&DowloadScript;
			&PrintRightScript;
			&VisibleFieldScript;
		</text>
	</script>

	<response>
		<action id="Download">
			<text>
				&CreateTicket;<![CDATA[
select @ticket as value
return
]]>
			</text>
		</action>

	</response>

	<queries>
		<query event="Loading">
			<text>
					<![CDATA[declare @$pageCount int; select @$pageCount = case when @@pageCount < 0 then 0 else @@pageCount end; 
exec FastBusiness$App$Voucher$Loading
@@id, @@master, @@prime, @@partition, @@expression, @@extension, @$pageCount, 'stt_rec', @@textList, @@textExternal, 'a left join dmkh b on a.ma_kh = b.ma_kh', @@textOrderBy, @@admin, @@userID, @@viewAccessMode, 0, @@queryString, default
, 'stt_rec, ma_vv, ma_hd, ma_td1, ma_sp, tk_no, line_nbr', 'd32$', ' outer apply (select top 1 stt_rec, ma_vv, ma_hd, ma_td1, ma_sp, stuff((select distinct '', '' + rtrim(sub_d.tk_no) from d32$ sub_d where sub_d.stt_rec = a.stt_rec and sub_d.tk_no <> '''' for xml path('''')), 1, 1, '''') as tk_no from d32$ where a.stt_rec = stt_rec and line_nbr = 1 ) e1' 
]]>
			</text>
		</query>
		
		<query event="Declare">
			<text>
				&DeclareCommandFilter;
				&ddDeclareCommandFilter;
			</text>
		</query>

		<query event="Finding">
			<text>
					<![CDATA[exec FastBusiness$App$Voucher$Finding
@@id, @@master, @@prime, @@inquiry, @@partition, @@expression, @@increase, @@extension, @@refresh, @@pageIndex, @@pageCount, @@lastPage, @@lastCount, @@firstItem, @@lastItem,
@@keyMaster, @@keyDetail, 'stt_rec', @@textList, @@textExternal,
'a left join dmkh b on a.ma_kh = b.ma_kh', @@textOrderBy, @@admin, @@userID, @@viewAccessMode,
@ngay_ct1, @ngay_ct2, @so_ct1, @so_ct2, @status, @user_id0, @ma_dvcs, default, default, default
, 'stt_rec, ma_vv, ma_hd, ma_td1, ma_sp, tk_no, line_nbr', 'd32$', ' outer apply (select top 1 stt_rec, ma_vv, ma_hd, ma_td1, ma_sp, stuff((select distinct '', '' + rtrim(sub_d.tk_no) from d32$ sub_d where sub_d.stt_rec = a.stt_rec and sub_d.tk_no <> '''' for xml path('''')), 1, 1, '''') as tk_no from d32$ where a.stt_rec = stt_rec and line_nbr = 1 ) e1' 
]]> 
			</text>
		</query>
	</queries>

