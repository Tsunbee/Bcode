<?xml version="1.0" encoding="utf-8"?>
<!--C-->

<!DOCTYPE grid [ 
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">

	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Báo cáo kế hoạch sản xuất" e="Production planning report"></title>
	<subTitle v="Từ ngày %d1 đến ngày %d2, Xưởng %s..." e="Date from %d1 to %d2, Shop %s..."></subTitle>
	<pivot rowField="xRow" columnField="xCol" dataFields="sl_sx" indexTable="2" indexColumn="1" indexHeader="2" indexView="17"/>
	<fields>
		<field name="ma_kh" width="100" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Mã khách" e="Customer"></header>
		</field>
		<field name="ten_kh" width="200" external="true" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Tên khách" e="Item Description"></header>
		</field>
		<field name="ma_px" width="100" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Xưởng" e="Workshop"></header>
		</field>
		<field name="ma_cd" width="100" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Công đoạn" e="Section"></header>
		</field>
		<field name="ngay_ct" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Ngày" e="Date"></header>
		</field>
		<field name="so_ct" width="100" align="right" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Số" e="Number"></header>
		</field>
		<field name="ma_sp" width="100" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Sản phẩm" e="Product"></header>
		</field>
		<field name="ma_vt" width="100" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Mã hàng" e="Item code"></header>
		</field>
		<field name="ten_vt" width="300" external="true" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="Tên mặt hàng" e="Item Description"></header>
		</field>
			<field name="length0" type="Decimal" dataFormatString="### ### ### ###" width="100" clientDefault="0" allowSorting="true" allowFilter="true" aggregate="Sum" readOnly="true">
			<header v="Dài" e="Order Quantity"></header>
			<items style="Numeric"/>
		</field>
		<field name="width0" type="Decimal" dataFormatString="### ### ### ###" width="100" clientDefault="0" allowSorting="true" allowFilter="true" aggregate="Sum" readOnly="true">
			<header v="Rộng" e="Order Quantity"></header>
			<items style="Numeric"/>
		</field>
		<field name="height0" type="Decimal" dataFormatString="### ### ### ###" width="100" clientDefault="0" allowSorting="true" allowFilter="true" aggregate="Sum" readOnly="true">
			<header v="Cao" e="Order Quantity"></header>
			<items style="Numeric"/>
		</field>
			<field name="so_khoi" type="Decimal" dataFormatString="@quantityViewFormat" width="100" clientDefault="0" allowSorting="true" allowFilter="true" aggregate="Sum" readOnly="true">
			<header v="Số khối" e="Order Quantity"></header>
			<items style="Numeric"/>
		</field>
				<field name="so_cont" type="Decimal" dataFormatString="@quantityViewFormat" width="100" clientDefault="0" allowSorting="true" allowFilter="true" aggregate="Sum" readOnly="true">
			<header v="Số cont" e="Order Quantity"></header>
			<items style="Numeric"/>
		</field>
		<field name="sl_lsx" type="Decimal" dataFormatString="### ### ### ###" width="100" clientDefault="0" allowSorting="true" allowFilter="true" aggregate="Sum" readOnly="true">
			<header v="Tổng SL" e="Order Quantity"></header>
			<items style="Numeric"/>
		</field>
			
		<field name="dvt" allowSorting="true" readOnly="true" allowFilter="true" width="60">
			<header v="Đvt" e="UOM"></header>
		</field>
		<field name="rtext" width="100" allowSorting="true" allowFilter="true" readOnly="true">
			<header v="" e=""></header>
		</field>
		<field name="sl_sx" type="Decimal" dataFormatString="### ### ### ###" width="100" clientDefault="0" allowSorting="true" allowFilter="true" aggregate="Sum" readOnly="true">
			<header v="" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="xColHeader" width="0" allowSorting="true" allowFilter="true" readOnly="true" hidden="true">
			<header v="" e=""></header>
		</field>

	</fields>

	<views>
		<view id="Grid">
			<field name="ma_kh"/>
			<field name="ten_kh"/>
			<field name="ma_px"/>
			<field name="ma_cd"/>
			<field name="ngay_ct"/>
			<field name="so_ct"/>
			<field name="ma_sp"/>
			<field name="ma_vt"/>
			<field name="ten_vt"/>
			<field name="length0"/>
				<field name="width0"/>
				<field name="height0"/>
				<field name="so_khoi"/>
				<field name="so_cont"/>


			<field name="sl_lsx"/>
			<field name="dvt"/>
			<field name="rtext"/>

			<field name="sl_sx"/>
			<field name="xColHeader"/>
		</view>
	</views>

	<commands>
		&XMLWhenReportLoading;
		&XMLWhenReportClosing;
	</commands>

	<script>
		<text>
			&JavascriptReportInit;
		</text>
	</script>

	&XMLStandardReportToolbar;
</grid>