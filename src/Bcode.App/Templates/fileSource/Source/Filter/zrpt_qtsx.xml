<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY XMLWhenFilterLoading SYSTEM "..\Include\XML\WhenFilterLoading.xml">
	<!ENTITY XMLWhenFilterClosing SYSTEM "..\Include\XML\WhenFilterClosing.xml">
	<!ENTITY OutlineCss SYSTEM "..\Include\Javascript\OutlineCss.txt">
	<!ENTITY OutlineEntry SYSTEM "..\Include\Javascript\OutlineEntry.txt">
]>

<dir id="1" type="Report" xmlns="urn:schemas-fast-com:data-dir">
	<title v="Điều kiện lọc" e="Management Fee"></title>
	<fields>
		<field name="ngay_tu" type="DateTime" dataFormatString="@datetimeFormat" allowNulls="false" aliasName="fromDate" defaultValue="new Date()">
			<header v="Ngày sản xuất từ" e="Date from"></header>
			<footer v="Ngày sản xuất từ/đến" e="Date from/to"></footer>
		</field>
		<field name="ngay_den" type="DateTime" dataFormatString="@datetimeFormat" allowNulls="false" aliasName="toDate" defaultValue="new Date()">
			<header v="Ngày sản xuất đến" e="Date to"></header>
		</field>
		
		<field name="ma_kh">
			<header v="Khách hàng" e="Customer"></header>
			<items style="AutoComplete" controller="Customer" reference="ten_kh%l" key="status = '1'" check="1=1" information ="ma_kh$dmkh.ten_kh%l"/>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''">
			<header v="" e=""></header>
		</field>
		
		<field name="ma_vt">
			<header v="Mã TP" e="Item"></header>
			<items style="AutoComplete" controller="Item" reference="ten_vt%l" key="status = '1'" check="1=1" information="ma_vt$dmvt.ten_vt%l"/>
		</field>
		<field name="ten_vt%l" readOnly="true" external="true" defaultValue="''" inactivate="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Dir">
			<item value="120, 40, 20, 40, 100, 100, 130"/>
			<item value="11001--: [ngay_tu].Description, [ngay_tu], [ngay_den]"/>
			<item value="1100100: [ma_kh].Label, [ma_kh], [ten_kh%l]"/>
			<item value="1100100: [ma_vt].Label, [ma_vt], [ten_vt%l]"/>
		</view>
	</views>
	
	<commands>
		<command event="Loading">
			<text>
				<![CDATA[
select N'active$VoucherFilter$(this);'	as message
return
]]>
			</text>
		</command>
		&XMLWhenFilterClosing;
		<command event="Processing">
			<text>
				<![CDATA[
select cast(@ngay_tu as smalldatetime) as ngay_tu, cast(@ngay_den as smalldatetime) as ngay_den, @ma_kh as ma_kh, @ma_vt as ma_vt
exec zrpt_qtsx @ngay_tu, @ngay_den, @ma_kh, @ma_vt, @@language, @@userID, @@admin
]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			&OutlineEntry;
			<![CDATA[
function active$VoucherFilter$(f) {
	f.add_onResponseComplete(on$Filter$ResponseComplete); 
}
function close$VoucherFilter$(f) {try {f.remove_onResponseComplete(on$Filter$ResponseComplete);} catch (ex) {}}
function on$Filter$ResponseComplete(sender, e) {
	var f = e.object, context = e.type.Context, result = e.type.Result;
	switch (context) {
		case 'Checking':
			var g = f.grid, d1 = f.getItem('ngay_tu').value, d2 = f.getItem('ngay_den').value;
			g._alterTitle = [null, [['%d1', d1, true], ['%d2', d2, true], ['%s', f.getItemValue('ma_px'), true]]];
			
			break;
		default:
			break;
	}
}
]]>
		</text>
	</script>
</dir>