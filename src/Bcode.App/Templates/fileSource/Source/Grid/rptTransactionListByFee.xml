<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">

	<!ENTITY % ReferenceNumber SYSTEM "..\Include\ReferenceNumber.ent">
	%ReferenceNumber;

	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
	<!ENTITY % Repetition SYSTEM "..\Include\Repetition.ent">
	%Repetition;
]>

<grid type="Report" valid="systotal = 1" filter="sysorder &lt;&gt; 1 "    xmlns="urn:schemas-fast-com:data-grid">
	<title v="Bảng kê chứng từ theo mã phí" e="Transaction List by Expense"/>
	<subTitle v="Từ ngày %d1 đến ngày %d2..." e="Date from %d1 to %d2..."></subTitle>
	<fields>
		<field name="ngay_ct" type="DateTime" dataFormatString="@datetimeFormat" width ="80" allowSorting="true" allowFilter="true">
			<header v="Ngày ct" e="VC. Date"/>
		</field>
		<field name="ma_ct0" width="60" allowSorting="true" allowFilter="true" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct]', Value: '[stt_rec]'}, Script: 'beforeDrillDown(this);'">
			<header v="Mã ct" e="VC. Code"></header>
		</field>
		<field name="so_ct" width="80" allowSorting="true" allowFilter="true" align="right">
			<header v="Số ct" e="Voucher No."/>
		</field>

		&ReferenceNumberFields;

		<field name="ma_kh" width="100" allowSorting="true" allowFilter="true">
			<header v="Mã khách" e="Customer ID"/>
		</field>
		<field name="ten_kh%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên khách hàng" e="Customer Name"/>
		</field>
		<field name="dien_giai" width="300" allowSorting="true" allowFilter="true">
			<header v="Diễn giải" e="Description"/>
		</field>
		<field name="tk" width="100" allowSorting="true" allowFilter="true">
			<header v="Tài khoản" e="Account"/>
		</field>
		<field name="tk_du" width="100" allowSorting="true" allowFilter="true">
			<header v="Tk đối ứng" e="Ref. Account"/>
		</field>

		<field name="ps_no_nt" type="Decimal" width="120" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Phát sinh nợ nt" e="FC Debit Amount"/>
		</field>
		<field name="ps_co_nt" type="Decimal" width="120" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Phát sinh có nt" e="FC Credit Amount"/>
		</field>
		<field name="ma_nt" width="60" allowSorting="true" allowFilter="true">
			<header v="Mã nt" e="FC Code"/>
		</field>
		<field name="ty_gia" type="Decimal" width="100" dataFormatString="@exchangeRateViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;">
			<header v="Tỷ giá" e="Exchange Rate"/>
		</field>
		<field name="ps_no" type="Decimal" width="120" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Phát sinh nợ" e="Debit Amount"/>
		</field>
		<field name="ps_co" type="Decimal" width="120" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="&GridReportAllowFilter.Number;" aggregate="Sum">
			<header v="Phát sinh có" e="Credit Amount"/>
		</field>

		<field name ="ma_phi" width="100" allowSorting="true" allowFilter="true">
			<header v="Mã phí" e="Expense"></header>
		</field>
		<field name ="ten_phi%l" width="100" allowSorting="true" allowFilter="true">
			<header v="Tên phí" e="Expense Name"></header>
		</field>
		<field name ="ma_td1" width="100" allowSorting="true" allowFilter="true">
				<header v="Mã sàn" e="Floor Code"></header>
		</field>
		<field name ="ten_san%l" width="200" allowSorting="true" allowFilter="true">
				<header v="Tên sàn" e="Floor Name"></header>
		</field>
		<field name ="ma_vv" width="100" allowSorting="true" allowFilter="true">
				<header v="Mã vụ việc" e="Job Code"></header>
		</field>
		<field name ="ten_vv%l" width="200" allowSorting="true" allowFilter="true">
				<header v="Tên vụ việc" e="Job Name"></header>
		</field>
		<field name="stt_rec" width="0" hidden="true">
			<header v="" e=""/>
		</field>
		<field name="ma_ct" width="0" hidden="true">
			<header v="" e=""/>
		</field>
		
		<field name="systotal" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
			<field name="sysorder" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ngay_ct"/>
			<field name="ma_ct0"/>
			<field name="so_ct"/>

			&ReferenceNumberViews;

			<field name="ma_kh"/>
			<field name="ten_kh%l"/>
			<field name="dien_giai"/>
			<field name="tk"/>
			<field name="tk_du"/>

			<field name="ps_no_nt"/>
			<field name="ps_co_nt"/>
			<field name="ma_nt"/>
			<field name="ty_gia"/>
			<field name="ps_no"/>
			<field name="ps_co"/>

			<field name="ma_phi"/>
			<field name="ten_phi%l"/>
			
			<field name="ma_td1"/>
			<field name="ten_san%l"/>
			<field name="ma_vv"/>
			<field name="ten_vv%l"/>
			<field name="ma_ct"/>
			<field name="stt_rec"/>
						<field name="systotal"/>
						<field name="sysorder"/>

		</view>
	</views>

	<commands>
		&XMLWhenReportLoading;
		&XMLWhenReportClosing;
	</commands>

	<script>
		<text>
			<![CDATA[
				function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
				function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
				function on$GridReport$Render(sender, eventArgs) {
					var g = eventArgs.grid;  
					if (g._hiddenFields) {
						var a = g._hiddenFields, h = '';
						for (var i = 0; i < a.length; i++) {
							setGridHiddenFields(g, a[i].Fields, a[i].Value);
							if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
						}
						g._externalHiddenFields = h;
					}
										set$Color(g)

				}
				function setGridHiddenFields(g, c, v) {
					var a = c.split(',');
					for (var i = 0; i < a.length; i++) {
						var l = g._getColumnOrder($func.trim(a[i]));
						if (l != -1) g._setColumnVisible(l, !v);
					}
				}
				function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
				function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
				function set$Color(g){  
							g._$sysorder = g._getColumnOrder('sysorder');
							for (var s = 1; s <= g._rowCount; s++){
								for (var c = 1; c <= g._columnCount; c++){
									if ((g._getItemValue(s, g._$sysorder) == '0') ) {    
										$get(g._id + '_inputCell_' + s + '.' + c + '').style.color = 'navy';
										$get(g._id + '_inputCell_' + s + '.' + c + '').style.fontSize = '8pt';
										$get(g._id + '_inputCell_' + s + '.' + c + '').style.fontWeight = 'bold';
									}
							}
						}
					 }
				]]>
			
		</text>
	</script>

	&XMLStandardReportToolbar;
</grid>