<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [	
	<!ENTITY DowloadScript SYSTEM "..\Include\Javascript\DownloadScript.txt">
	<!ENTITY TransferID "zhdtt1ps">
	<!ENTITY CreateTicket "declare @ticket varchar(32), @filename varchar(128), @description nvarchar(128)
select @ticket = lower(replace(newid(),'-',''))
select @filename = '', @description = ''
insert into @@sysDatabaseName..ticket values(@ticket, @@userID, '&TransferID;', @filename, @description, '@@appDatabaseName', getdate());">
		
	<!ENTITY UnitFilter "">
	<!ENTITY UnitQuery "">
	
	<!ENTITY % ExportImportTemplate SYSTEM "..\Include\ExportImportTemplate.ent">
	%ExportImportTemplate;
	<!ENTITY ExportImportTemplate.UploadController "controller=&TransferID;&amp;form=&TransferID;">
]>

<grid table="zhdtt1ps_v" code="ma_hd, ngay_tt" order="ma_hd, ngay_tt" filter="&UnitFilter;" initialize="&UnitQuery;" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Cập nhật thanh toán trực tiếp CĐT ngoài" e="???"></title>
	<subTitle v="Cập nhật: Thêm, sửa, xóa" e="Input: New, Edit, Delete"></subTitle>
	<fields>
		<field name="ma_hd" isPrimaryKey="true" dataFormatString="@upperCaseFormat" width="100" allowFilter="true" allowSorting="true">			<header v="Hợp đồng" e="Contract"></header>			<items style="Mask"/>		</field>		<field name="ngay_tt" isPrimaryKey="true" type="DateTime" dataFormatString="@datetimeFormat" width="100" allowFilter="true" allowSorting="true">			<header v="Ngày thanh toán" e="Payment Date"></header>		</field>		<field name="tt" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" allowFilter="true" allowSorting="true">			<header v="Thanh toán" e="Payment"></header>		</field>		
		<field name="ten_hd%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên hợp đồng" e="Description"></header>
		</field>
		<field name="ngay_hd" type="DateTime" width="100" dataFormatString="@datetimeFormat" allowFilter="true">
			<header v="Ngày ký" e=" Date Signed"></header>
		</field>
		<field name="ngay_hd1" type="DateTime" width="100" dataFormatString="@datetimeFormat" allowFilter="true">
			<header v="Ngày bắt đầu" e="Start Date"></header>
		</field>
		<field name="ngay_hd2" type="DateTime" width="100" dataFormatString="@datetimeFormat" allowFilter="true">
			<header v="Ngày kết thúc" e="Finish Date"></header>
		</field>
		<field name="so_hd" width="100" allowSorting="true" allowFilter="true">
			<header v="Số hợp đồng" e="Description"></header>
		</field>
		<field name="ma_vv" width="100" allowSorting="true" allowFilter="true">
			<header v="Sản phẩm" e="Description"></header>
		</field>
		<field name="ten_vv%l" aliasName="b"  width="300" allowSorting="true" allowFilter="true">
			<header v="Tên sản phẩm" e="Description"></header>
		</field>
		<field name="ma_kh" width="100" allowSorting="true" allowFilter="true">
			<header v="Mã khách" e="Description"></header>
		</field>
		<field name="ten_kh%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên khách hàng" e="Description"></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ma_hd"/>
			<field name="ten_hd%l"/>
			<field name="ngay_tt"/>
			<field name="tt"/>
			<field name="ngay_hd"/>
			<field name="ngay_hd1"/>
			<field name="ngay_hd2"/>
			<field name="so_hd"/>
			<field name="ma_vv"/>
			<field name="ten_vv%l"/>
			<field name="ma_kh"/>
			<field name="ten_kh%l"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>			
				&CreateTicket;<![CDATA[			
select 'this._key = ''' + @ticket + ''';this._authorize = ' + rtrim(@@sysDatabaseName.dbo.FastBusiness$System$GetAuthorize(@@admin, @@userID, 'zhdtt1ps', 'New')) + ';load$Grid(this);' as message
return
]]>
			</text>
		</command>
		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$Grid(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$Grid(g) {
	g.add_onResponseComplete(on$GridMain$ResponseComplete);	
	g.add_commandEvent(on$GridMain$ExecuteCommand);
}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridMain$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridMain$ResponseComplete);} catch (ex) {}	
}
function on$GridMain$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	
	switch (action) {	
		case 'ImportData': 
			(g._authorize == 1) ? g.showForm('zhdtt1psImport') : $message.show($df.getResources(g._language, "Message.NotAccess"));
			break;
		case 'Download':
			]]>&UserDefinedDownload;<![CDATA[
			break;	
		default:
			break;
	}
}
function on$GridMain$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {		
		case 'Download':
			g._key = result[0].Value;
			break;
		default:
			break;
	}
}
]]> 
			&DowloadScript; 
		</text>
	</script>	
 
	<response>
		<action id="Download">
			<text>
				&CreateTicket;<![CDATA[
select @ticket as value
return
]]>
			</text>
		</action>
	</response>
	
	<css>
		<text>
			<![CDATA[
div.ImportData{background-image:url(../images/Upload.png);background-repeat:no-repeat;background-position:0 0;}
div.ImportDataOverGreen{background-position:0 -22px;}
div.Download{background-image:url(../Images/Download.png);background-repeat:no-repeat;background-position:0 0;}
div.DownloadOverGreen{background-position:0 -22px;}
]]>
		</text>
	</css>

	<toolbar>
		<button command="New">
			<title v="Toolbar.New" e="Toolbar.New"></title>
		</button>
		<button command="Edit">
			<title v="Toolbar.Edit" e="Toolbar.Edit"></title>
		</button>
		<button command="Delete">
			<title v="Toolbar.Delete" e="Toolbar.Delete"></title>
		</button>
		<button command="Search">
			<title v="Toolbar.Search" e="Toolbar.Search"></title>
		</button>
		<button command="View">
			<title v="Toolbar.View" e="Toolbar.View"></title>
		</button>
		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"/>
		</button>		 
		<button command="-">
			<title v="-" e="-"/>
		</button>
		<button command="ImportData">
			<title v="Lấy dữ liệu từ tệp..." e="Import Data from File..."></title>
		</button>
		<button command="Download">
			<title v="Tải tệp mẫu..." e="Download Template File..."/>
		</button> 
		<button command="Separate">
			<title v="-" e="-"/>
		</button>		
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>
</grid>