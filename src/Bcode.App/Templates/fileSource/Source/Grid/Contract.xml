<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY DowloadScript SYSTEM "..\Include\Javascript\DownloadScript.txt">

	<!ENTITY TransferID "Contract">

	<!ENTITY FastBusiness.Encryption.Begin "">
	<!ENTITY CreateTicket "declare @ticket varchar(32)
select @ticket = lower(replace(newid(),'-',''))
insert into @@sysDatabaseName..ticket values(@ticket, @@userID, '&TransferID;', '', '', '@@appDatabaseName', getdate());">

	<!ENTITY ExtensionTicket "declare @$ticket varchar(32)
select @$ticket = lower(replace(newid(),'-',''))
insert into @@sysDatabaseName..ticket values(@$ticket, @@userID, '&TransferID;', '', '', '@@appDatabaseName', getdate());">
	<!ENTITY FastBusiness.Encryption.End "">

	<!ENTITY % ExportImportTemplate SYSTEM "..\Include\ExportImportTemplate.ent">
	%ExportImportTemplate;
	<!ENTITY ExportImportTemplate.UploadController "controller=&TransferID;&amp;form=&TransferID;">
	<!ENTITY ExportImportTemplate.UploadControllerExtension "controller=&TransferID;&amp;form=&TransferID;Update">
		
	<!ENTITY UnitResult "case when @q = '' then '1=1' else ' (' + @q + ')' end">

	<!ENTITY % Control.Unit SYSTEM "..\Include\Unit.ent">
	%Control.Unit;
	%Control.Unit.Include.Contract;
	%Control.Unit.Ignore;

	<!ENTITY k "ma_hd">
	<!ENTITY Tag "dmhd">

	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
	
	<!ENTITY FilterAccess "&UnitFilter; and dbo.zFastBusiness$Function$CheckMgmtObjRights(2, @@userID, @@admin, &k;) = 1 ">
]>

<grid table="vdmhd_thuong" code="ma_hd" order="ma_hd" regular="." filter="loai_hd2 not in (select ma_loai from zdmloaihd where xtype = 'S') and &FilterAccess;" initialize="&UnitQuery;" xmlns="urn:schemas-fast-com:data-grid">

	<title v="Danh mục hợp đồng" e="Contract List"></title>
	<subTitle v="Cập nhật: thêm, sửa, xóa..." e="Add, Edit, Delete Contract..."></subTitle>

	<fields>
		<field name="ma_hd" isPrimaryKey="true" aliasName="a" width="100" allowSorting="true" allowFilter="true">
			<header v="Mã hợp đồng" e="Contract"></header>
		</field>
		<field name="ten_hd%l" width="300" aliasName="a" allowSorting="true" allowFilter="true">
			<header v="Tên hợp đồng" e="Description"></header>
		</field>
				<field name="so_hd" width="250" aliasName="a" allowSorting="true" allowFilter="true">
			<header v="Số hợp đồng" e="Description"></header>
		</field>
		<field name="ngay_hd" type="DateTime" width="100" aliasName="a" dataFormatString="@datetimeFormat" allowFilter="&GridListAllowFilter.Number;">
			<header v="Ngày ký" e=" Date Signed"></header>
		</field>
		<field name="ngay_hd1" type="DateTime" width="100" aliasName="a" dataFormatString="@datetimeFormat" allowFilter="&GridListAllowFilter.Number;">
			<header v="Ngày bắt đầu" e="Start Date"></header>
		</field>
		<field name="ngay_hd2" type="DateTime" width="100" aliasName="a" dataFormatString="@datetimeFormat" allowFilter="&GridListAllowFilter.Number;">
			<header v="Ngày kết thúc" e="Finish Date"></header>
		</field>
				<field name="list_dvcs" external="true" defaultValue="''"  width="100" allowSorting="true" allowFilter="true">
			<header v="Mã đơn vị cơ sở" e="Contract"></header>
		</field>

		<field name="nh_hd2" allowSorting="true" allowFilter="true" width="0" hidden="true">
			<header v="2" e="2"></header>
		</field>
		
		<field name="loai_hd" width="100" allowSorting="true" allowFilter="true" align="right">
			<header v="Tính chất hợp đồng" e="Contract Category"></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="list_dvcs"/>
			<field name="ma_hd"/>
			<field name="ten_hd%l"/>
			<field name="so_hd"/>
			<field name="ngay_hd"/>
			<field name="ngay_hd1"/>
			<field name="ngay_hd2"/>
			<field name="nh_hd2"/>
			<field name="loai_hd"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>
				&CreateTicket;
				&ExtensionTicket;
				<![CDATA[
select 'this._authorize = ' + rtrim(@@sysDatabaseName.dbo.FastBusiness$System$GetAuthorize(@@admin, @@userID, 'Contract', 'New')) + ';this._key = ''' + @ticket + ''';this._$key = ''' + @$ticket + ''';load$Grid(this);' as message
return
]]>
			</text>
		</command>

		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$Grid(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[/* <flatten type="Javascript"> */
function load$Grid(g) {
	g.add_onResponseComplete(on$GridContract$ResponseComplete);
	g.add_commandEvent(on$GridContract$ExecuteCommand);
}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridContract$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridContract$ResponseComplete);} catch (ex) {}
}
/* </flatten> */
function on$GridContract$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	switch (action) {
		case 'ImportData':
			switch(e.type.Value) {
				case '210':
					show$Form(g, 'ContractImport');
					break;
				case '230':
					g._ImportData$zController = 'ContractUpdate';
					show$Form(g, 'ContractImportUpdate');
					break;
				case '41':
					g._ImportData$zController = 'ContractHisCustomer';
					show$Form(g, 'ContractImportUpdate');
					break;
				default:break;
			}
			
			//show$Form(g, 'ContractImport');
			break;
		case 'Download':
			switch(e.type.Value) {
				case '210':
					]]>&UserDefinedDownload;<![CDATA[
				case '230':
					]]>&UserDefinedDownloadExtension;<![CDATA[
				case '41':
					var r = $get('requestFormData');
					if (!r) r = $func.requestFormData();
					var query = '?type=TemplateUpload&controller=zContract1&form=ContractHisCustomer' + String.format('&r={0}', Math.random());
					r.action = $func.resolveClientUrl('~/AppHandler/ExportHandler.ashx' + query, g._baseUrl);
					if (!$func.isIE) r.target = '_blank';
					r.submit();
					break;
				default:break;
			}
			break;
		default:
			break;
	}
}
/* <flatten type="Javascript"> */
function on$GridContract$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		case 'Download':
			g._key = result[0].Value;
			break;
		case 'Allowance':
			g._$key = result[0].Value;	
			break;
		default:
			break;
	}
}
function show$Form(g, c) {(g._authorize == 1) ? g.showForm(c) : $message.show($df.getResources(g._language, "Message.NotAccess"));}
/* </flatten> */]]>
			&DowloadScript;
		</text>
	</script>

	<css>
		<text>
			<![CDATA[
div.GroupImportData{background-image:url(../images/Transfer.png);background-repeat:no-repeat;background-position:0 0;}
div.TextGroupImportData{background-image:url(../images/TextUpload.png),url(../images/Line.png);background-repeat:no-repeat,repeat-x;background-position:0 0;}
div.GroupDownload{background-image:url(../Images/Transfer.png);background-repeat:no-repeat;background-position:-30px 0;}
div.TextGroupDownload{background-image:url(../images/TextDownload.png),url(../images/Line.png);background-repeat:no-repeat,repeat-x;background-position:0 0;}
div.GroupImportDataOverGreen, div.TextGroupImportDataOverGreen, div.GroupDownloadOverGreen, div.TextGroupDownloadOverGreen{background-position-y:-22px;}
]]>
		</text>
	</css>

	<response>
		<action id="Download">
			<text>
				&CreateTicket;<![CDATA[
select @ticket as value
return
]]>
			</text>
		</action>
		
		<action id="Allowance">
			<text>
				&ExtensionTicket;<![CDATA[
select @$ticket as value
return
]]>
			</text>
		</action>
	</response>

	<toolbar>
		<button command="New">
			<title v="Toolbar.New" e="Toolbar.New"></title>
		</button>
		<button command="Edit">
			<title v="Toolbar.Edit" e="Toolbar.Edit"></title>
		</button>
		<button command="Delete">
			<title v="Toolbar.Delete" e="Toolbar.Delete"></title>
		</button>
		<button command="Clone">
			<title v="Toolbar.Copy" e="Toolbar.Copy"></title>
		</button>
		<button command="Search">
			<title v="Toolbar.Search" e="Toolbar.Search"></title>
		</button>
		<button command="View">
			<title v="Toolbar.View" e="Toolbar.View"></title>
		</button>
		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"/>
		</button>

		<button command="-">
			<title v="-" e="-"/>
		</button>

		<button command="ImportData">
			<title v="Lấy dữ liệu từ tệp..." e="Import Data from File..."></title>
			<menuItems>
				<menuItem commandArgument="210">
					<header v="Danh mục hợp đồng"	e="Contract List"/>
				</menuItem>
				<menuItem commandArgument="120">
					<header v="-"  e="-"/>
				</menuItem>
				<menuItem commandArgument="230">
					<header v="Cập nhật hợp đồng"	e="Contract Update"/>
				</menuItem>
				<menuItem commandArgument="41">
					<header v="Cập nhật lịch sử khách hàng" e="Update Customer History"/>
				</menuItem>
			</menuItems>
		</button>
		<button command="Download">
			<title v="Tải tệp mẫu..." e="Download Template File..."/>
			<menuItems>
				<menuItem commandArgument="210">
					<header v="Danh mục hợp đồng"	e="Contract List"/>
				</menuItem>
				<menuItem commandArgument="120">
					<header v="-"  e="-"/>
				</menuItem>
				<menuItem commandArgument="230">
					<header v="Cập nhật hợp đồng"	e="Contract Update"/>
				</menuItem>
				<menuItem commandArgument="41">
					<header v="Cập nhật lịch sử khách hàng" e="Update Customer History"/>
				</menuItem>
			</menuItems>
		</button>

		<button command="Separate">
			<title v="-" e="-"/>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>
</grid>