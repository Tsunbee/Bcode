	de on a.stt_rec = de.stt_rec left join dmhd hd on de.ma_hd = hd.ma_hd left join dmdtqt3 qt3 on de.ma_td3 = qt3.ma_dtqt left join zvdmvv vv on de.ma_vv = vv.ma_vv ']]>
