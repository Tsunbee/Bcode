<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" valid="systotal = 1" filter="" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Báo cáo Tình trạng Đơn hàng" e="Order Status Report"></title>
	<subTitle v="Từ ngày %s1 đến ngày %s2" e="From Date %s1 to %s2"></subTitle>
	<pivot rowField="xRow" columnField="xColumn" dataFields="so_luong" indexTable="2" indexColumn="1" indexHeader="2" indexView="7"/>
	<fields>
		<field name="ten_kh" allowSorting="true" allowFilter="true" width="250" hyperlinkFormatString="~/AppHandler/View.ashx Query: {Page: 'zquery_zrpt_273SF1', Controller: 'zrpt_273', Name: '[dh_ma_kh]', Value: '[dh_ma_kh] + String.fromCharCode(253) + this._queryFilterString'}, Script: 'beforeDrillDownWithCondition(this);'">
			<header v="Tên khách hàng" e="Customer Name"></header>
		</field>
		<field name="dh_so" align="right" allowSorting="true" allowFilter="true" width="80">
			<header v="Đơn hàng" e="Order Number"></header>
		</field>
		<field name="dh_ngay_ct" type="DateTime" dataFormatString="@datetimeFormat" width ="80" allowSorting="true" allowFilter="true">
			<header v="Ngày đơn hàng" e="VC. Date"/>
		</field>
		<field name="ma_vt" allowSorting="true" allowFilter="true" width="100">
			<header v="Mã hàng" e="Item"></header>
		</field>
		<field name="ten_vt" allowSorting="true" allowFilter="true" width="300">
			<header v="Tên vật tư" e="Item"></header>
		</field>
		<field name="sl_dh" type="Decimal" dataFormatString="@quantityViewFormat" allowSorting="true" allowFilter="true" width="80" aggregate="Sum">
			<header v="Sl đơn hàng" e="SO Q'ty"></header>
		</field>
		<field name="sl_trien_khai" type="Decimal" dataFormatString="@quantityViewFormat" allowSorting="true" allowFilter="true" width="100" aggregate="Sum">
			<header v="Sl triển khai" e="Quantity"></header>
		</field>
		<field name="sl_quy_doi_cai" type="Decimal" dataFormatString="@quantityViewFormat" allowSorting="true" allowFilter="true" width="100" aggregate="Sum">
			<header v="Sl quy đổi cái" e="Quantity"></header>
		</field>
		<field name="sl_chua_hoan_thien" type="Decimal" dataFormatString="@quantityViewFormat" allowSorting="true" allowFilter="true" width="100" aggregate="Sum">
			<header v="Sl chưa đóng gói" e="Quantity"></header>
		</field>
<!--		<field name="tong_sl" type="Decimal" dataFormatString="@quantityViewFormat" allowSorting="true" allowFilter="true" width="80">
			<header v="Tổng Số lượng" e="SO Q'ty"></header>
		</field>-->
		<field name="so_luong" type="Decimal" dataFormatString="@quantityViewFormat" allowSorting="true" allowFilter="true" width="100" aggregate="Sum">
			<header v="Số lượng" e="Quantity"></header>
		</field>

				<field name="dh_ma_kh" allowSorting="true" allowFilter="true" width="0" hidden="true" inactivate="true">
			<header v="Khách hàng" e="Customer"></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ten_kh"/>
			<field name="dh_so"/>
			<field name="dh_ngay_ct"/>
			<field name="ma_vt"/>
			<field name="ten_vt"/>
			<field name="sl_dh"/>
			<field name="sl_trien_khai"/>
			<field name="sl_quy_doi_cai"/>
			<field name="sl_chua_hoan_thien"/>

			
			<field name="dh_ma_kh"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
		  <text>
			<![CDATA[select 'load$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
		<command event="Closing">
		  <text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
function on$GridReport$Render(sender, eventArgs) {
	var g = eventArgs.grid;  
	if (g._hiddenFields) {    
		var a = g._hiddenFields, h = '';
		for (var i = 0; i < a.length; i++) {
			setGridHiddenFields(g, a[i].Fields, a[i].Value);
			if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
		}
		g._externalHiddenFields = h;
	}
}
function setGridHiddenFields(g, c, v) {
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var l = g._getColumnOrder($func.trim(a[i]));
		if (l != -1) g._setColumnVisible(l, !v);
	}
}
function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
function beforeDrillDownWithCondition(g) {g._args.cancelEvent = !(g._getItemValue(g._activeRow, g._getColumnOrder('systotal')) == 1);}
]]>
		</text>
	</script>
	
	&XMLStandardReportToolbar;
</grid>