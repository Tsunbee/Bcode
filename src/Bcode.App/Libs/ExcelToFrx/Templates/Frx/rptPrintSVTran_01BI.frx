    <Parameter Name="t33" DataType="System.String" Expression="Substring(Trim([f_companyTaxCode]),12,1)"/>
    <Parameter Name="f_t_tien_in_word" DataType="System.String" Expression="IIf([languageType] == 1      , IIf([isFC] == 0, [d1.t_tt_in_word], [d1.t_tt_nt_in_word])      , IIf([isFC] == 0, [d1.t_tt_in_word2], [d1.t_tt_nt_in_word2]))"/>
    <Parameter Name="f_t_tien2" DataType="System.String" Expression="IIf([isFC] == 0,[d1.t_tien2],[d1.t_tien_nt2])"/>
    <Parameter Name="f_tien2" DataType="System.String" Expression="IIf([isFC] == 0,[d1.tien2],[d1.tien_nt2])"/>
    <Parameter Name="f_gia2" DataType="System.String" Expression="IIf([isFC] == 0,[d1.gia2],[d1.gia_nt2])"/>
    <Parameter Name="f_ten_kh" DataType="System.String" Expression="IIf([languageType] == 1, [d1.ten_kh], [d1.ten_kh2])"/>
    <Parameter Name="f_thanh_toan" DataType="System.String" Expression="IIf([languageType] == 1, [d1.thanh_toan], [d1.thanh_toan2])"/>
    <Parameter Name="f_company" DataType="System.String" Expression="IIf([companyLine].Trim() == &quot;1&quot;, [Entity_Line1], IIf([companyLine].Trim() == &quot;2&quot;, [Entity_Line2], IIf([companyLine].Trim() == &quot;3&quot;, [Entity_Line3], IIf([companyLine].Trim() == &quot;4&quot;, [Entity_Line4], IIf([companyLine].Trim() == &quot;5&quot;, [Entity_Line5], &quot;&quot;)))))"/>
    <Parameter Name="f_mau_so" DataType="System.String" Expression="IIf([d1.ky_hieu] == &quot;&quot;, [h_mau_so2], [d1.ky_hieu])"/>
    <Parameter Name="f_address" DataType="System.String" Expression="IIf([addressLine].Trim() == &quot;1&quot;, [Entity_Line1], IIf([addressLine].Trim() == &quot;2&quot;, [Entity_Line2], IIf([addressLine].Trim() == &quot;3&quot;, [Entity_Line3], IIf([addressLine].Trim() == &quot;4&quot;, [Entity_Line4], IIf([addressLine].Trim() == &quot;5&quot;, [Entity_Line5], &quot;&quot;)))))"/>
    <Parameter Name="f_2_biReportDate" DataType="System.String" Expression="&quot;(&quot; + [2_biReportDate] + &quot;)&quot;"/>
    <Parameter Name="f_ngay_ct" DataType="System.String" Expression="[h_colon] + &quot; &quot; + FormatDateTime([d1.ngay_ct], [dateFormatString])"/>
    <Parameter Name="f_h_mau_so2" DataType="System.String" Expression="&quot;(&quot; + [2_h_mau_so] + &quot;)&quot;"/>
    <Parameter Name="f_h_so_seri2" DataType="System.String" Expression="&quot;(&quot; + [2_h_so_seri2] + &quot;)&quot;"/>
    <Parameter Name="f_h_so_hd2" DataType="System.String" Expression="&quot;(&quot; + [2_h_so_hd2] + &quot;)&quot;"/>
    <Parameter Name="f_so_lien" DataType="System.String" Expression="IIf([languageType] == 1, [d1.so_lien], [d1.so_lien2])"/>
    <Parameter Name="f_so_lien2" DataType="System.String" Expression="&quot;(&quot; + [2_h_lien] + IIf([languageType] == 1, [d1.so_lien2], [d1.so_lien]) + &quot;)&quot;"/>
    <Parameter Name="f_t_tien_in_word2" DataType="System.String" Expression="IIf([languageType] == 1      , IIf([isFC] == 0, [d1.t_tt_in_word2], [d1.t_tt_nt_in_word2])      , IIf([isFC] == 0, [d1.t_tt_in_word], [d1.t_tt_nt_in_word]))"/>
    <Parameter Name="f_ten_vt2" DataType="System.String" Expression="IIf([d1.fix_yn] == 0, IIf([languageType] == 1, IIf([d1.ten_vt2] != &quot;&quot;, &quot;\r\n&quot; + [d1.ten_vt2], &quot;&quot;), IIf([d1.ten_vt] != &quot;&quot;, &quot;\r\n&quot; + [d1.ten_vt], &quot;&quot;)), &quot;&quot;)"/>
    <Parameter Name="f_h_total2" DataType="System.String" Expression="&quot;(&quot; + [2_h_t_tien_bi] + &quot;)&quot;"/>
    <Parameter Name="f_thanh_toan2" DataType="System.String" Expression="IIf([languageType] == 1, [d1.thanh_toan2], [d1.thanh_toan])"/>
    <Parameter Name="f_company2" DataType="System.String" Expression="IIf([companyLine].Trim() == &quot;1&quot;, [2_Entity_Line1], IIf([companyLine].Trim() == &quot;2&quot;, [2_Entity_Line2], IIf([companyLine].Trim() == &quot;3&quot;, [2_Entity_Line3], IIf([companyLine].Trim() == &quot;4&quot;, [2_Entity_Line4], IIf([companyLine].Trim() == &quot;5&quot;, [2_Entity_Line5], &quot;&quot;)))))"/>
    <Parameter Name="f_address2" DataType="System.String" Expression="IIf([addressLine].Trim() == &quot;1&quot;, [2_Entity_Line1], IIf([addressLine].Trim() == &quot;2&quot;, [2_Entity_Line2], IIf([addressLine].Trim() == &quot;3&quot;, [2_Entity_Line3], IIf([addressLine].Trim() == &quot;4&quot;, [2_Entity_Line4], IIf([addressLine].Trim() == &quot;5&quot;, [2_Entity_Line5], &quot;&quot;)))))"/>
    <Parameter Name="f_companyTaxCode" DataType="System.String" Expression="[companyTaxCode].Replace(&quot;-&quot;, &quot;&quot;)"/>
    <Parameter Name="f_companyTaxCodeCus" DataType="System.String" Expression="[d1.ma_so_thue].Replace(&quot;-&quot;, &quot;&quot;)"/>
