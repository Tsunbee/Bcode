<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">

	<!ENTITY % ReferenceNumber SYSTEM "..\Include\ReferenceNumber.ent">
	%ReferenceNumber;

	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;

	<!ENTITY % Repetition SYSTEM "..\Include\Repetition.ent">
	%Repetition;
	
	<!ENTITY TransferID "paycontract">
	<!ENTITY % PrintRight SYSTEM "..\Include\PrintRightGrid.ent">
	%PrintRight;
]>

<grid type="Report"  xmlns="urn:schemas-fast-com:data-grid">
	<title v="Bảng kê đợt thanh toán hợp đồng" e="Transaction List"></title>
	<subTitle v="Hợp đồng: %s1" e="Contract: %s1"/>
	<fields>
		<field name="ma_hdg" width="130" allowSorting="true" allowFilter="true">
			<header v="Mã hợp đồng gốc" e="Customer ID"></header>
		</field>
		<field name="ma_sp" width="130" allowSorting="true" allowFilter="true">
			<header v="Mã sản phẩm" e="Customer ID"></header>
		</field>
		<field name="trang_thai" width="180" allowSorting="true" allowFilter="true">
			<header v="Trạng thái" e="Customer ID"></header>
		</field>
		<field name="ma_hdcn" width="130" allowSorting="true" allowFilter="true">
			<header v="Mã HĐCN" e="Customer ID"></header>
		</field>
				<field name="so_hdcn" width="230" allowSorting="true" allowFilter="true">
			<header v="Số HĐCN" e="Customer ID"></header>
		</field>
				<field name="ngay_tt_hdcn" type="DateTime" dataFormatString="@datetimeFormat" width ="120" allowSorting="true" allowFilter="true">
			<header v="Ngày tt HĐCN" e="VC. Date"/>
		</field>
				<field name="ma_dot_hdcn" width="130" allowSorting="true" allowFilter="true">
			<header v="Mã đợt HĐCN" e="Customer ID"></header>
		</field>
				<field name="ty_le_hdcn" width="150" type="Decimal" dataFormatString="### ### ### ##0.00" allowSorting="true" allowFilter="true">
			<header v="Tỷ lệ HĐCN" e="Amount Contract"></header>
		</field>
		<field name="ty_le_tt_hdcn" width="150" type="Decimal" 
				dataFormatString="### ### ### ##0.00" 
				allowSorting="true" allowFilter="true">
			<header v="Tỷ lệ TT HĐCN (%)" e="Payment Rate CN"></header>
		</field>
		<field name="tien_hdcn" width="150"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="Tiền đợt HĐCN" e="Amount Contract"></header>
		</field>
	<field name="tien_hdcn1" width="250"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="GTCL sau CK và Giảm trừ HĐCN" e="Amount Contract"></header>
		</field>
	<field name="chenhlech_hdcn" width="200"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="Chênh lệch đợt và giá trị HĐ" e="Amount Contract"></header>
		</field>
			<field name="gt_datt_hdcn" width="150"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="Tiền đã tt HĐCN" e="Amount Contract"></header>
		</field>
	<field name="han_tt_hdcn" type="DateTime" dataFormatString="@datetimeFormat" width ="120" allowSorting="true" allowFilter="true">
			<header v="Hạn tt HĐCN" e="VC. Date"/>
		</field>
			<field name="ma_hdkt" width="130" allowSorting="true" allowFilter="true">
			<header v="Mã hợp kinh tế" e="Customer ID"></header>
		</field>
						<field name="so_hdkt" width="230" allowSorting="true" allowFilter="true">
			<header v="Số HĐKT" e="Customer ID"></header>
		</field>
				<field name="ngay_tt_hdkt" type="DateTime" dataFormatString="@datetimeFormat" width ="120" allowSorting="true" allowFilter="true">
			<header v="Ngày tt HĐKT" e="VC. Date"/>
		</field>
				<field name="ma_dot_hdkt" width="130" allowSorting="true" allowFilter="true">
			<header v="Mã đợt HĐKT" e="Customer ID"></header>
		</field>
				<field name="ty_le_hdkt" width="150"  type="Decimal" dataFormatString="### ### ### ##0.00" allowSorting="true" allowFilter="true" >
			<header v="Tỷ lệ HĐKT" e="Amount Contract"></header>
		</field>
		<field name="ty_le_tt_hdkt" width="150" type="Decimal" 
				dataFormatString="### ### ### ##0.00" 
				allowSorting="true" allowFilter="true">
			<header v="Tỷ lệ TT HĐKT (%)" e="Payment Rate KT"></header>
		</field>
						<field name="tien_hdkt" width="150"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="Tiền đợt HĐKT" e="Amount Contract"></header>
		</field>
						<field name="tien_hdkt1" width="250"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="GTCL sau CK và Giảm trừ HĐKT" e="Amount Contract"></header>
		</field>
		<field name="chenhlech_hdkt" width="200"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="Chênh lệch đợt và giá trị HĐ" e="Amount Contract"></header>
		</field>
					<field name="gt_datt_hdkt" width="150"  type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" allowSorting="true" allowFilter="true" >
			<header v="Tiền đã tt HĐKT" e="Amount Contract"></header>
		</field>
		<field name="han_tt_hdkt" type="DateTime" dataFormatString="@datetimeFormat" width ="120" allowSorting="true" allowFilter="true">
			<header v="Hạn tt HĐKT" e="VC. Date"/>
		</field>
					<field name="systotal" hidden="true" />

	</fields>
	<views>
		<view id="Grid">
			<field name="ma_hdg"/>
			<field name="ma_sp"/>
			<field name="trang_thai"/>
			<field name="ma_hdcn"/>
			<field name="so_hdcn"/>
			<field name="ngay_tt_hdcn"/>
			<field name="ma_dot_hdcn"/>
			<field name="ty_le_hdcn"/>
			<field name="ty_le_tt_hdcn"/>
			<field name="tien_hdcn"/>
			<field name="tien_hdcn1"/>
			<field name="chenhlech_hdcn"/>
			<field name="gt_datt_hdcn"/>
			<field name="han_tt_hdcn"/>
			<field name="ma_hdkt"/>
			<field name="so_hdkt"/>
			<field name="ngay_tt_hdkt"/>
			<field name="ma_dot_hdkt"/>
			<field name="ty_le_hdkt"/>
			<field name="ty_le_tt_hdkt"/>
			<field name="tien_hdkt"/>
			<field name="tien_hdkt1"/>
			<field name="chenhlech_hdkt"/>
			<field name="gt_datt_hdkt"/>
			<field name="han_tt_hdkt"/>
			<field name="systotal"/>
		</view>
	</views>
	<commands>
		&XMLWhenGridShowingPrintRight;
		&XMLWhenReportLoading;
		&XMLWhenReportClosing;
	</commands>

	<script>
		<text>
		<![CDATA[
		function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
		function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
		function on$GridReport$Render(sender, eventArgs) {
			var g = eventArgs.grid;  
			if (g._hiddenFields) {
				var a = g._hiddenFields, h = '';
				for (var i = 0; i < a.length; i++) {
					setGridHiddenFields(g, a[i].Fields, a[i].Value);
					if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
				}
				g._externalHiddenFields = h;
			}
								set$Color(g)

		}
		function setGridHiddenFields(g, c, v) {
			var a = c.split(',');
			for (var i = 0; i < a.length; i++) {
				var l = g._getColumnOrder($func.trim(a[i]));
				if (l != -1) g._setColumnVisible(l, !v);
			}
		}
		function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
		function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
		function set$Color(g) {
				var systotalCol = g._getColumnOrder('systotal');  
				if (systotalCol == -1) return;             
				for (var s = 1; s <= g._rowCount; s++) {
						if (g._getItemValue(s, systotalCol) == '0') { 
								for (var c = 1; c <= g._columnCount; c++) {
										var cell = $get(g._id + '_inputCell_' + s + '.' + c);
										if (!cell) continue;                
										cell.style.color = 'navy';
										cell.style.fontSize = '8pt';
										cell.style.fontWeight = 'bold';
								}
						}
				}
		}
		]]>
				&PrintRightScript;
		</text>
	</script>

	&XMLStandardReportToolbar;
</grid>