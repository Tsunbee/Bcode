<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY TransferID "ManagementObject3">

	<!ENTITY % ManagementObjectName SYSTEM "..\Include\ManagementObjectName.ent">
	%ManagementObjectName;

	<!ENTITY DowloadScript SYSTEM "..\Include\Javascript\DownloadScript.txt">

	
	<!ENTITY CreateTicket "declare @ticket varchar(32)
select @ticket = lower(replace(newid(),'-',''))
insert into @@sysDatabaseName..ticket values(@ticket, @@userID, '&TransferID;', '', '', '@@appDatabaseName', getdate());">
	

	<!ENTITY % ExportImportTemplate SYSTEM "..\Include\ExportImportTemplate.ent">
	%ExportImportTemplate;
	<!ENTITY ExportImportTemplate.UploadController "controller=&TransferID;&amp;form=&TransferID;">
]>

<grid table="dmdtqt3" code="ma_dtqt" order="ma_dtqt" xmlns="urn:schemas-fast-com:data-grid">
	<title v="&Name.Object3.001.v;" e="&Name.Object3.001.e;"></title>
	<subTitle v="Cập nhật &Name.Object3.040.v;: thêm, sửa, xóa..." e="Add, Edit, Delete &Name.Object3.040.e;..."></subTitle>

	<fields>
		<field name="ma_dtqt" isPrimaryKey="true" width="100" allowSorting="true" allowFilter="true">
			<header v="&Name.Object3.010.v;" e="&Name.Object3.010.e;"></header>
		</field>
		<field name="ten_dtqt%l" width="300" allowSorting="true" allowFilter="true">
			<header v="&Name.Object3.020.v;" e="&Name.Object3.020.e;"></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ma_dtqt"/>
			<field name="ten_dtqt%l"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>
				&CreateTicket;<![CDATA[
select 'this._authorize = ' + rtrim(@@sysDatabaseName.dbo.FastBusiness$System$GetAuthorize(@@admin, @@userID, ']]>&TransferID;<![CDATA[', 'New')) + ';this._key = ''' + @ticket + ''';load$]]>&TransferID;<![CDATA[$Grid(this);' as message
return
]]>
			</text>
		</command>

		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$]]>&TransferID;<![CDATA[$Grid(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$]]>&TransferID;<![CDATA[$Grid(g) {
	g.add_onResponseComplete(on$GridItem$]]>&TransferID;<![CDATA[$ResponseComplete);
	g.add_commandEvent(on$GridItem$]]>&TransferID;<![CDATA[$ExecuteCommand);
}
function dispose$]]>&TransferID;<![CDATA[$Grid(g) {
	try {g.remove_commandEvent(on$GridItem$]]>&TransferID;<![CDATA[$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridItem$]]>&TransferID;<![CDATA[$ResponseComplete);} catch (ex) {}
}

function on$GridItem$]]>&TransferID;<![CDATA[$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	switch (action) {
		case 'ImportData':
			show$Form(g, ']]>&TransferID;<![CDATA[Import');
			break;
		case 'Download':
			]]>&UserDefinedDownload;<![CDATA[
			break;
		default:
			break;
	}
}
function on$GridItem$]]>&TransferID;<![CDATA[$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		case 'Download':
			g._key = result[0].Value;
			break;
		default:
			break;
	}
}
function show$Form(g, c) {(g._authorize == 1) ? g.showForm(c) : $message.show($df.getResources(g._language, "Message.NotAccess"));}
]]>
			&DowloadScript;
		</text>
	</script>

	<css>
		<text>
			<![CDATA[
div.ImportData{background-image:url(../images/Upload.png);background-repeat:no-repeat;background-position:0 0;}
div.ImportDataOverGreen{background-position:0 -22px;}
div.Download{background-image:url(../Images/Download.png);background-repeat:no-repeat;background-position:0 0;}
div.DownloadOverGreen{background-position:0 -22px;}
]]>
		</text>
	</css>

	<response>
		<action id="Download">
			<text>
				&CreateTicket;<![CDATA[
select @ticket as value
return
]]>
			</text>
		</action>
	</response>

	<toolbar>
		<button command="New">
			<title v="Toolbar.New" e="Toolbar.New"></title>
		</button>
		<button command="Edit">
			<title v="Toolbar.Edit" e="Toolbar.Edit"></title>
		</button>
		<button command="Delete">
			<title v="Toolbar.Delete" e="Toolbar.Delete"></title>
		</button>
		<button command="View">
			<title v="Toolbar.View" e="Toolbar.View"></title>
		</button>
		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"/>
		</button>
		<button command="Clone">
			<title v="Toolbar.Copy" e="Toolbar.Copy"></title>
		</button>
		<button command="-">
			<title v="-" e="-"/>
		</button>

		<button command="ImportData">
			<title v="Lấy dữ liệu từ tệp..." e="Import Data from File..."></title>
		</button>
		<button command="Download">
			<title v="Tải tệp mẫu..." e="Download Template File..."/>
		</button>

		<button command="Separate">
			<title v="-" e="-"/>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>
</grid>