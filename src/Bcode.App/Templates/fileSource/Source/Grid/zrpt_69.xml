<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" valid="systotal = 1" filter="" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Báo cáo theo dõi chi tiết đơn hàng, hóa đơn, thanh toán" e="Detailed tracking report of orders, invoices, payments"></title>
	<subTitle v="Từ ngày %s1 đến ngày %s2" e="From Date %s1 to %s2"></subTitle>
	<fields>
		<field name="so_ct_v" width="100" allowSorting="true" allowFilter="true" align="right" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct]', Value: '[stt_rec]'}, Script: 'beforeDrillDown(this);'">
			<header v="Số đơn hàng" e="Order Number"></header>
		</field>
		<field name="ma_vt_v" width="100" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mặt hàng" e="Item"></header>
		</field>
		<field name="so_luong" width="100" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng" e="Quantity"></header>
		</field>
		<field name="gia2" width="100" type="Decimal" dataFormatString="@baseCurrencyPriceViewFormat" allowSorting="true" allowFilter="true">
			<header v="Đơn giá" e="Price"></header>
		</field>
		<field name="tien2" width="100" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Tiền" e="Amount"></header>
		</field>
		
		<field name="hd_so_ct" width="100" allowSorting="true" allowFilter="true" align="right" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[hd_ma_ct]', Value: '[hd_stt_rec]'}, Script: 'beforeDrillDown(this);'">
			<header v="Số hóa đơn" e="Invoice Number"></header>
		</field>
		<field name="hd_so_luong" width="100" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng" e="Quantity"></header>
		</field>
		<field name="hd_tien2" width="100" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Tiền hàng" e="Amount"></header>
		</field>
		<field name="hd_thue" width="100" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="true">
			<header v="VAT" e="VAT"></header>
		</field>
		
		<field name="thu_so_ct" width="100" allowSorting="true" allowFilter="true" align="right" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[thu_ma_ct]', Value: '[thu_stt_rec]'}, Script: 'beforeDrillDown(this);'">
			<header v="Số thanh toán" e="Payment Number"></header>
		</field>
		<field name="thu_ngay_ct" width="100" type="DateTime" dataFormatString="@datetimeFormat" allowSorting="true" allowFilter="true">
			<header v="Ngày thanh toán" e="Payment date"></header>
		</field>
		<field name="thu_tien" width="100" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số tiền" e="Amount"></header>
		</field>
		
		<field name="tien_cl" width="100" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số tiền còn lại trên đơn hàng" e="Amount remaining on order"></header>
		</field>
		<field name="hd_tien_cl" width="100" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số tiền còn lại trên hóa đơn" e="Amount remaining on invoice"></header>
		</field>
		<field name="sl_cl" width="100" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng còn lại trên đơn hàng" e="Quantity remaining on order"></header>
		</field>
		
		<field name="stt_rec" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="ma_ct" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		
		<field name="hd_stt_rec" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="hd_ma_ct" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		
		<field name="thu_stt_rec" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="thu_ma_ct" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		
		<field name="systotal" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="so_ct_v"/>
			<field name="ma_vt_v"/>
			<field name="so_luong"/>
			<field name="gia2"/>
			<field name="tien2"/>
			<field name="hd_so_ct"/>
			<field name="hd_so_luong"/>
			<field name="hd_tien2"/>
			<field name="hd_thue"/>
			
			<field name="thu_so_ct"/>
			<field name="thu_ngay_ct"/>
			<field name="thu_tien"/>
			
			<field name="tien_cl"/>
			<field name="hd_tien_cl"/>
			<field name="sl_cl"/>
			
			<field name="stt_rec"/>
			<field name="ma_ct"/>
			
			<field name="hd_stt_rec"/>
			<field name="hd_ma_ct"/>
			
			<field name="thu_stt_rec"/>
			<field name="thu_ma_ct"/>
			
			<field name="systotal"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
		  <text>
			<![CDATA[select 'load$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
		<command event="Closing">
		  <text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
function on$GridReport$Render(sender, eventArgs) {
	var g = eventArgs.grid;  
	if (g._hiddenFields) {    
		var a = g._hiddenFields, h = '';
		for (var i = 0; i < a.length; i++) {
			setGridHiddenFields(g, a[i].Fields, a[i].Value);
			if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
		}
		g._externalHiddenFields = h;
	}
	setColorWithCondition(g, 'systotal', '0', '', 'bold', '');
}
function setGridHiddenFields(g, c, v) {
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var l = g._getColumnOrder($func.trim(a[i]));
		if (l != -1) g._setColumnVisible(l, !v);
	}
}

function setColorWithCondition(g, field, condition, color, bold, italic) {
		var iC	
		try {iC = g._getColumnOrder(field);				
			var r = g._rowCount;
			var i;
			for (i = 1; i <= r; i++) {
					if (g._getItemValue(i, iC) == condition) {
							setColor4Row(g, i, color);
							setFont4Row(g, i, bold, italic);
					}
			}
		}
		catch (err){}
}

function setColor4Row(g, rNumber, color) {
		var c = g._columnCount;
		var i;
		var o;
		for (i = 1; i <= c; i++) {
				o = g._getItem(rNumber, i);
				if (color != '') {
					//	o.style.color = color;
						$get(g.get_id()+ '_gridCell_' + rNumber.toString() + '.' +  i.toString()).style.backgroundColor = color;
						
					//	o.style.backgroundColor = color;
						
				}
		}
}

function setFont4Row(g, rNumber, bold, italic) {
		var c = g._columnCount;
		var i;
		var o;
		for (i = 1; i <= c; i++) {
				o = g._getItem(rNumber, i);
				if (bold != '') {
						o.style.fontWeight = bold;
				}
				if (italic != '') {
						o.style.fontStyle = italic;
				}
		}
}

function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
]]>
		</text>
	</script>
	
	&XMLStandardReportToolbar;
</grid>