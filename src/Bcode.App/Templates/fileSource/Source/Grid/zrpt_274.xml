<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" valid="systotal = 1" filter="" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Báo cáo kho thành phẩm" e="Finished goods warehouse report"></title>
	<subTitle v="Từ ngày %s1 đến ngày %s2" e="From Date %s1 to %s2"></subTitle>
	
	<fields>
		<field name="ma_kh" width="180" hidden="true" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Tên Khách hàng" e="Customer"></header>
		</field>
		<field name="ngay_ct" width="100" type="DateTime" dataFormatString="@datetimeFormat" allowSorting="true" allowFilter="true">
			<header v="Ngày đơn hàng" e="SO Date"></header>
		</field>
		<field name="so_ct" width="130" allowSorting="true" allowFilter="true" align="right" hyperlinkFormatString="~/AppHandler/Voucher.ashx Query: {Name: '[ma_ct]', Value: '[stt_rec9]'}, Script: 'beforeDrillDown(this);'">
			<header v="Số đh" e="Voucher No. Official"></header>
		</field>
		<field name="pnk_ngay_ct" width="100" type="DateTime" dataFormatString="@datetimeFormat" allowSorting="true" allowFilter="true">
			<header v="Ngày phiếu nhập" e="PN Date"></header>
		</field>
		<field name="pnk_so_ct" width="130" allowSorting="true" allowFilter="true" align="right" >
			<header v="Số ct phiếu nhập" e="Voucher No. Official"></header>
		</field>
		<field name="ma_vt" width="130" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mã sản phẩm" e="Item"></header>
		</field>
		<field name="ten_vt" width="250" allowSorting="true" allowFilter="true">
			<header v="Tên sản phẩm" e="Item Name"></header>
		</field>
		<field name="sl_dh" width="130" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng ĐH" e="SO Quantity"></header>
		</field>
		<field name="sl_pnd" width="130" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true" hyperlinkFormatString="~/AppHandler/View.ashx Query: {Page: 'zquery_zrpt_274PND', Controller: 'zrpt_274', Name: '[ma_vtlsx]', Value: '[ma_vtlsx] + String.fromCharCode(253) + [ma_kh] + this._queryFilterString'}, Script: 'beforeDrillDownWithCondition(this);'">>
			<header v="Số lượng nhập kho" e="PND Quantity"></header>
		</field>
		<field name="ma_vtlsx" width="150" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mã vật tư lệnh sản xuất" e="Item"></header>
		</field>
		<field name="sl_lsx" width="130" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng lsx" e="Remain Q'ty"></header>
		</field>
		<field name="sl_cl" width="130" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng còn lại" e="Remain Q'ty"></header>
		</field>
				<field name="ten_kh" width="180"  dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Tên Khách hàng" e="Customer"></header>
		</field>
		<field name="ma_ct" width="" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="stt_rec" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
		<field name="systotal" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ma_kh"/>
				<field name="ten_kh"/>
			<field name="ngay_ct"/>
			<field name="so_ct"/>
			<field name="ma_vt"/>
			<field name="ma_vtlsx"/>
			<field name="ten_vt"/>
			<field name="sl_dh"/>
			<field name="pnk_ngay_ct"/>
			<field name="pnk_so_ct"/>
			<field name="sl_pnd"/>
			<field name="sl_cl"/>
			
			<field name="ma_ct"/>
			<field name="stt_rec"/>
			<field name="systotal"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
		  <text>
			<![CDATA[select 'load$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
		<command event="Closing">
		  <text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
function on$GridReport$Render(sender, eventArgs) {
	var g = eventArgs.grid;  
	if (g._hiddenFields) {    
		var a = g._hiddenFields, h = '';
		for (var i = 0; i < a.length; i++) {
			setGridHiddenFields(g, a[i].Fields, a[i].Value);
			if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
		}
		g._externalHiddenFields = h;
	}
}
function setGridHiddenFields(g, c, v) {
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var l = g._getColumnOrder($func.trim(a[i]));
		if (l != -1) g._setColumnVisible(l, !v);
	}	
}
function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
function beforeDrillDownWithCondition(g) {g._args.cancelEvent = !(g._getItemValue(g._activeRow, g._getColumnOrder('sl_pnd')) != 0);}
]]>
		</text>
	</script>
	
	&XMLStandardReportToolbar;
</grid>