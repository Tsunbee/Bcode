    <Parameter Name="f_t_tien_thue_gtgt0" DataType="System.String" Expression="IIf([isFC] == 0,[d1.thue_0],[d1.thue_nt_0])"/>
    <Parameter Name="f_t_khong_thue" DataType="System.String" Expression="IIf([isFC] == 0,[d1.tien_99],[d1.tien_nt_99])"/>
    <Parameter Name="f_h_khong_thue" DataType="System.String" Expression="&quot;/&quot;"/>
