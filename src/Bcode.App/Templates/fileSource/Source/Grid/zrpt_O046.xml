		<command event="Closing">
			<text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[

			function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
			function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
			function on$GridReport$Render(sender, eventArgs) {
				var g = eventArgs.grid;  
				if (g._hiddenFields) {
					var a = g._hiddenFields, h = '';
					for (var i = 0; i < a.length; i++) {
						setGridHiddenFields(g, a[i].Fields, a[i].Value);
						if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
					}
					g._externalHiddenFields = h;
				}
				set$Color(g)
			}
			function setGridHiddenFields(g, c, v) {
				var a = c.split(',');
				for (var i = 0; i < a.length; i++) {
					var l = g._getColumnOrder($func.trim(a[i]));
					if (l != -1) g._setColumnVisible(l, !v);
				}
			}
				function set$Color(g) {
				var row_kind = g._getColumnOrder('row_kind');  
				if (row_kind == -1) return;             
				for (var s = 1; s <= g._rowCount; s++) {
						if (g._getItemValue(s, row_kind) == '0') { 
								for (var c = 1; c <= g._columnCount; c++) {
										var cell = $get(g._id + '_inputCell_' + s + '.' + c);
										if (!cell) continue;                
										cell.style.color = 'navy';
										cell.style.fontSize = '8pt';
										cell.style.fontWeight = 'bold';
								}
						}
				}
		}
		function ViewDetail(o, n) {
		var g = o.grid, p = window.location.href.split('?')[0], v = g._getItemValue(g._activeRow, g._getColumnOrder('ma_hd'));
		var w = window.open(p.substring(0, p.lastIndexOf("/") + 1) + 'zcohd1.aspx?query=' + window.btoa(unescape(encodeURIComponent(v))));

				var tries1 = 0;
				var timer1 = setInterval(function () {
						tries1++;
						if (tries1 > 50) { clearInterval(timer1); return; }
						try {
								var ext = w.$find && w.$find('ctl00_FastBusiness_MainReport_searchExtender');
								if (ext) {
										clearInterval(timer1);
										ext.executeDialog(2);

										var tries2 = 0;
										var timer2 = setInterval(function () {
												tries2++;
												if (tries2 > 50) { clearInterval(timer2); return; }
												if (triggerFilterByMaHd(w, v)) {
														clearInterval(timer2);
												}
										}, 150);
								}
						} catch (e)
				}, 150);
		}

		function triggerFilterByMaHd(w, value) {
				var input = w.document.getElementById('ctl00_FastBusiness_MainReport_FilterPanelTextma_hd');
				var grid = w.$find && w.$find('ctl00_FastBusiness_MainReport');
				if (!input || !grid) return false;

				input.value = value;
				var fakeEvent = { keyCode: 13, which: 13, preventDefault: function () {}, stopPropagation: function () {} };
				grid.R0(input, fakeEvent, 2);
				return true;
		}
			function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
			function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
			]]>
		</text>
	</script>

