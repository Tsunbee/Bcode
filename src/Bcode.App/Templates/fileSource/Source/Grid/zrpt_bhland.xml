<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" valid="systotal = 1" filter="" indextable ='2' xmlns="urn:schemas-fast-com:data-grid">
	<title v="Báo cáo bán hàng - LAND" e="Sales Report - LAND"></title>
	<subTitle v="Từ ngày %s1 đến ngày %s2 - %s3 " e="From Date %s1 to %s2"></subTitle>

	<fields>

		<field name="tk_hach_toan" width="100" allowSorting="true" allowFilter="true">
			<header v="TK hạch toán" e="Account"></header>
		</field>
		<field name="ma_vv" width="200" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mã SP" e="Product Code"></header>
		</field>
		<field name="ten_kh" width="220" allowSorting="true" allowFilter="true">
			<header v="Tên khách hàng" e="Customer Name"></header>
		</field>
		<field name="cmnd" width="120" allowSorting="true" allowFilter="true">
			<header v="Số CCCD" e="ID Card"></header>
		</field>
		<field name="dia_chi" width="250" allowSorting="true" allowFilter="true">
			<header v="Địa chỉ" e="Address"></header>
		</field>
		<field name="ma_hd" width="150" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mã hợp đồng" e="Contract ID"></header>
		</field>
		<field name="so_hd" width="150" allowSorting="true" allowFilter="true">
			<header v="Số hợp đồng" e="Contract No."></header>
		</field>
		<field name="ten_hd" width="250" allowSorting="true" allowFilter="true">
			<header v="Tên hợp đồng" e="Contract Name"></header>
		</field>
		<field name="ngay_hd" type="DateTime" dataFormatString="@datetimeFormat" width="100" allowSorting="true" allowFilter="true">
			<header v="Ngày ký" e="Date Signed"></header>
		</field>
		
		<field name="dien_tich_dat" width="120" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Diện tích đất" e="Land Area"></header>
		</field>
		<field name="dien_tich_xay_dung" width="120" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Diện tích xây dựng" e="Construction Area"></header>
		</field>
		
		<field name="tong_gia_tri_hd" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="1. TỔNG GIÁ [2+3.1+3.2] TRỊ HỢP ĐỒNG" e="Total Value"></header>
		</field>
		<field name="gia_tri_nha" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="2. GIÁ TRỊ NHÀ" e="House Value"></header>
		</field>
		<field name="gia_tri_dat" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="3.1 GIÁ TRỊ ĐẤT" e="Land Value"></header>
		</field>
		<field name="gia_tri_noi_that" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="3.2 NỘI THẤT" e="Furniture Value"></header>
		</field>
		

		<field name="tong_tien_da_thu" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="4. TỔNG TIỀN ĐÃ THU [5+6.1+6.2]" e="Total Collected"></header>
		</field>
		<field name="da_thu_nha" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Đã thu Nhà" e="Collected (House)"></header>
		</field>
		<field name="da_thu_dat" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Đã thu Đất" e="Collected (Land)"></header>
		</field>
		<field name="da_thu_noi_that" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Đã thu Nội thất" e="Collected (Furniture)"></header>
		</field>
		
		<field name="con_phai_thu" width="150" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Còn phải thu" e="Remaining Receivable"></header>
		</field>

		<field name="gt_xhd_vat" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="1. GT ĐÃ XUẤT HĐƠN GỒM VAT" e="Remaining Receivable"></header>
		</field>

		<field name="dt_xhd" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="2. DOANH THU ĐÃ XUẤT HOÁ ĐƠN " e="Remaining Receivable"></header>
		</field>

		<field name="VAT" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="3. THUẾ GTGT" e="Remaining Receivable"></header>
		</field>

		<field name="GT0" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="4. GIÁ TRỊ ĐẤT ĐƯỢC TRỪ (0%)" e="Remaining Receivable"></header>
		</field>

		<field name="GT10" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="5. GIÁ TRỊ ĐẤT KHÔNG ĐƯỢC TRỪ (10%)" e="Remaining Receivable"></header>
		</field>
		<field name="GT_nha" width="200" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="6. GIÁ TRỊ NHÀ" e="Remaining Receivable"></header>
		</field>

		<field name="systotal" width="0" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="tk_hach_toan"/>
			<field name="ma_vv"/>
			<field name="ten_kh"/>
			<field name="cmnd"/>
			<field name="dia_chi"/>
			<field name="ma_hd"/>
			<field name="so_hd"/>
			<field name="ten_hd"/>
			<field name="ngay_hd"/>
			<field name="dien_tich_dat"/>
			<field name="dien_tich_xay_dung"/>
			<field name="tong_gia_tri_hd"/>
			<field name="gia_tri_nha"/>
			<field name="gia_tri_dat"/>
			<field name="gia_tri_noi_that"/>
			<field name="tong_tien_da_thu"/>
			<field name="da_thu_nha"/>
			<field name="da_thu_dat"/>
			<field name="da_thu_noi_that"/>
			<field name="con_phai_thu"/>
			<field name="gt_xhd_vat"/>
			<field name="dt_xhd"/>
			<field name="vat"/>
			<field name="GT0"/>
			<field name="GT10"/>
			<field name="GT_nha"/>

			<field name="systotal"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>
			<![CDATA[select 'load$GridReport$(this);' as message
	return]]>
			</text>
		</command>
		<command event="Closing">
			<text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
			function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
			function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
			function on$GridReport$Render(sender, eventArgs) {
				var g = eventArgs.grid;  
				if (g._hiddenFields) {
					var a = g._hiddenFields, h = '';
					for (var i = 0; i < a.length; i++) {
						setGridHiddenFields(g, a[i].Fields, a[i].Value);
						if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
					}
					g._externalHiddenFields = h;
				}
				set$Color(g)
			}
			function setGridHiddenFields(g, c, v) {
				var a = c.split(',');
				for (var i = 0; i < a.length; i++) {
					var l = g._getColumnOrder($func.trim(a[i]));
					if (l != -1) g._setColumnVisible(l, !v);
				}
			}
			function set$Color(g) {
				var systotalCol = g._getColumnOrder('systotal');  
				if (systotalCol == -1) return;              
				for (var s = 1; s <= g._rowCount; s++) {
					if (g._getItemValue(s, systotalCol) == '0') { 
						for (var c = 1; c <= g._columnCount; c++) {
							var cell = $get(g._id + '_inputCell_' + s + '.' + c);
							if (!cell) continue;                
							cell.style.color = 'navy';
							cell.style.fontSize = '8pt';
							cell.style.fontWeight = 'bold';
						}
					}
				}
			}
			function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
			function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
			]]>
		</text>
	</script>

	&XMLStandardReportToolbar;
</grid>