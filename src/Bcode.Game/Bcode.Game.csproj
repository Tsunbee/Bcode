<Project Sdk="Microsoft.NET.Sdk">
  <!-- "Giải lao" — game suy luận xã hội chơi chung qua LAN văn phòng (chủ đề triển khai dự án ERP Fast).
       Exe RIÊNG: Bcode chỉ build kèm, chép ra thư mục Game\ cạnh Bcode.exe và mở từ menu "Giải trí → Giải lao" — Bcode không nạp gì của game.
       Không có thư viện ngoài ngoài WebView2: đọc .xlsx bằng ZipArchive + XmlReader (Data/XlsxReader.cs), mạng bằng TcpListener / UdpClient.
       ⚠ Bộ câu hỏi là tài liệu NỘI BỘ — KHÔNG đưa file Excel / câu hỏi / đáp án vào repo hay bộ cài: chủ phòng chọn file lúc mở phòng. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bcode.Game</RootNamespace>
    <AssemblyName>BcodeGame</AssemblyName>
    <Product>Bcode — Giải lao</Product>
    <Authors>HaoTN</Authors>
    <Description>Đêm Go-Live — game suy luận xã hội chơi qua LAN, chủ đề triển khai dự án ERP.</Description>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Web\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dùng chung với Xem chung: mật khẩu phòng (challenge–response) + DPAPI cho mật khẩu nhớ trong game-lan.json -->
    <Compile Include="..\Shared\RoomAuth.cs" Link="Shared\RoomAuth.cs" />
    <Compile Include="..\Shared\DpapiText.cs" Link="Shared\DpapiText.cs" />
  </ItemGroup>
</Project>
