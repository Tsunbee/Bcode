<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bcode.App</RootNamespace>
    <AssemblyName>Bcode</AssemblyName>
    <!-- Bee's own icon (see Assets/README.md) — sets the .exe file icon (Explorer/taskbar
         shortcut). The window/title-bar icon is set separately at runtime from the same
         file, embedded as a resource — see UI/AppIcons.cs. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\bee.ico</ApplicationIcon>
    <!-- Bản quyền + điều khoản (hiện ở Properties của Bcode.exe, nhúng vào metadata assembly) — mức răn đe/pháp lý, không phải DRM. -->
    <Company>Bee</Company>
    <Product>Bcode</Product>
    <Copyright>© Bee. Phần mềm độc quyền. Cấm sao chép, phân phối lại hoặc dịch ngược (decompile/reverse-engineer) khi chưa được phép bằng văn bản.</Copyright>
    <Trademark>Bcode™ Bee</Trademark>
    <!-- PHIÊN BẢN Bcode — chỗ DUY NHẤT cần sửa khi lên bản mới. Dạng "số-nhãn" (1.9-beta) → hiện "Beta v1.9" ở góc phải thanh trên
         (topbar.html #verBadge / NativeTopBar) và ghi vào log lỗi (ErrorLog.Version / ErrorLog.VersionLabel). Bỏ "-beta" khi ra bản chính thức → "v2.0". -->
    <Version>2.5-beta</Version>
    <!-- Thư mục phát hành MẶC ĐỊNH cho "Kiểm tra bản Bcode mới" (Shared/AppUpdate.cs): máy chưa khai Settings → Thư mục phát hành bản mới
         thì dùng thư mục này (thư mục build có bcode-version.json). Người dùng vẫn khai đè được; gõ "-" = tắt kiểm tra. Để trống = không có mặc định. -->
    <!-- Bố cục phát hành: HAOTN\Bcode\{Bcode, Bcodeviewer, BcodeScreenDesigner} — mỗi app 1 thư mục con riêng. -->
    <BcodeReleaseFolder>\\172.168.5.17\Users\HAOTN\Bcode\Bcode</BcodeReleaseFolder>
    <!-- Thư mục con trong bản build là APP KHÁC tự cập nhật riêng: không vào bcode-manifest.json của Bcode (Shared/Release.targets) và
         cập nhật Bcode không đụng (UpdateCheckService.Configure keepDirs). Screen Designer: thư mục phát hành riêng, xem Bcode.ScreenDesigner.csproj. -->
    <BcodeNestedApps>ScreenDesigner</BcodeNestedApps>
  </PropertyGroup>
  <!-- Dấu tĩnh truy nguồn (tools/bcode-mark): GUID bộ Bcode nhúng cố định vào metadata assembly để nhận ra bản sao chép nhị phân. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BcodeMark</_Parameter1>
      <_Parameter2>b3c0de00-0000-4bee-b3c0-deb3c0deb3c0 | BcodeMark v1</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BcodeReleaseFolder</_Parameter1>
      <_Parameter2>$(BcodeReleaseFolder)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Lõi dùng chung (mục 1): WatermarkService... — tham chiếu, không chép. -->
  <ItemGroup>
    <ProjectReference Include="..\Bcode.Core\Bcode.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Jint" Version="4.2.2" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Backs the shell's top bar / icon rail / status bar (HTML+CSS+JS, see Web/Shell) —
         NOT Electron: this wraps the WebView2 Runtime already on the machine (ships with
         Windows 10/11 via Edge), so it launches an existing shared browser process instead of
         bundling/launching a whole Chromium copy per app — this is what keeps Bcode's actual
         startup/memory cost close to a normal WinForms app instead of an Electron one. All
         data-heavy screens (SQL Object tree, grids, script editor, WCommand tree, the 21-tool
         toolbar) stay 100% native WinForms/WinForms controls, untouched — only cosmetic chrome
         uses WebView2, per Bee's explicit "giữ được tốc độ" (keep it fast) instruction. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Code nhúng claude.ai / gemini.google.com dùng chung với BcodeViewer.App (xem Shared/AiWebHelper.cs) — link, không chép. -->
    <Compile Include="..\Shared\AiWebHelper.cs" Link="Shared\AiWebHelper.cs" />
    <!-- Công thức tạo/kiểm tra mã bản quyền gắn máy — dùng chung với công cụ cấp mã Bcode.KeyGen. -->
    <Compile Include="..\Shared\LicenseCodec.cs" Link="Shared\LicenseCodec.cs" />
    <!-- Mã hoá DPAPI mật khẩu / API key khi ghi settings.json — dùng chung với BcodeViewer.App (Viewer đọc chung settings.json). -->
    <Compile Include="..\Shared\DpapiText.cs" Link="Shared\DpapiText.cs" />
    <!-- Chuyển dữ liệu kiến thức (ghost + Hỏi Fast) sang thư mục / ổ khác — dùng chung với BcodeViewer. -->
    <Compile Include="..\Shared\KnowledgeMover.cs" Link="Shared\KnowledgeMover.cs" />
    <!-- Alt+Tab quay lại thì trả focus / con trỏ về chỗ cũ (WebView2 không tự làm) — dùng chung với BcodeViewer.App. -->
    <Compile Include="..\Shared\AppSwitchFocus.cs" Link="Shared\AppSwitchFocus.cs" />
    <!-- Giao thức pipe liên-tiến-trình có phiên bản (Bcode ↔ BcodeViewer ↔ BcodeNote) — Shared/PipeProtocol.cs, link vào cả hai. -->
    <Compile Include="..\Shared\PipeProtocol.cs" Link="Shared\PipeProtocol.cs" />
    <!-- Cập nhật bản mới (kiểm tra / tải trước / cài / quay lại + xử lý hộp update.html) — dùng chung với BcodeViewer.App, mỗi app thư mục phát hành riêng. -->
    <Compile Include="..\Shared\AppUpdate.cs" Link="Shared\AppUpdate.cs" />
    <Compile Include="..\Shared\AppUpdateDialog.cs" Link="Shared\AppUpdateDialog.cs" />
    <Compile Include="..\Shared\AppUpdateToast.cs" Link="Shared\AppUpdateToast.cs" />
    <!-- SqlWatch (src/SqlWatch, app riêng theo dõi câu SQL qua DMV) — link mã để Ctrl+3 mở được trong tab Bcode (Controls/SqlWatchControl.cs);
         bỏ Program/SelfTest (điểm vào riêng của exe). Project SqlWatch vẫn build độc lập như cũ. -->
    <Compile Include="..\SqlWatch\*.cs" Exclude="..\SqlWatch\Program.cs;..\SqlWatch\SelfTest.cs" LinkBase="SqlWatch" />
    <PackageReference Include="Scintilla.NET" Version="5.3.2.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shell's HTML/CSS/JS (see Web/Shell) — plain loose files copied next to Bcode.exe
         at build time (not embedded resources) so MainForm can map them as a WebView2 virtual
         host folder at runtime (see MainForm's WebView2 setup) and Bee can tweak them without
         recompiling. -->
    <Content Include="Web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Khung preview File Lookup (Controls/MonacoPreviewControl.cs + Web/Shell/filepreview.html)
         dùng CHÍNH bộ Monaco, ngôn ngữ fcode-xml, theme.js và font của BcodeViewer — link thẳng từ
         BcodeViewer.App/Web lúc build (không chép tay) để hai bên luôn tô màu giống hệt nhau. -->
    <Content Include="..\BcodeViewer.App\Web\vs\**" LinkBase="Web\Shell\viewer\vs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\BcodeViewer.App\Web\fonts\**" LinkBase="Web\Shell\viewer\fonts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- goto.js = hộp Ctrl+G "Go to" (TAG / DETAIL, tô mục hay dùng) — preview dùng chung với BcodeViewer để 2 bên giống hệt. -->
    <Content Include="..\BcodeViewer.App\Web\theme.js;..\BcodeViewer.App\Web\fcode-language.js;..\BcodeViewer.App\Web\goto.js;..\BcodeViewer.App\Web\dirpreview.js;..\BcodeViewer.App\Web\entity.js;..\Bcode.ScreenDesigner\Web\shim.js;..\Bcode.ScreenDesigner\Web\dp.css" LinkBase="Web\Shell\viewer">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Mẫu file cho "Clone danh mục" (xem Services/CatalogCloneService.cs) — file rời để sửa
         được mà không cần build lại. -->
    <Content Include="Templates\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Nội dung tab "Trợ giúp" (Controls/HelpControl.cs + Web/Shell/help.html): bản gốc là tài liệu hướng dẫn
         sử dụng ở docs/ của repo, chép thành Help\HuongDanSuDung.md cạnh exe — một nguồn cho cả repo lẫn app. -->
    <Content Include="..\..\docs\HuongDanSuDung.md" Link="Help\HuongDanSuDung.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\docs\images\**" LinkBase="Help\images">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Bí mật (tài khoản DAC, FSG_A, khoá eInvoice): Secrets\LocalSecrets.cs nằm trong .gitignore, mỗi máy build tự chép vào. Có file thì bỏ
       bản rỗng LocalSecrets.Empty.cs (cùng tên lớp); không có thì build bằng bản rỗng — các tính năng cần bí mật tự báo thiếu. Xem Secrets\README.md. -->
  <ItemGroup Condition="Exists('Secrets\LocalSecrets.cs')">
    <Compile Remove="Secrets\LocalSecrets.Empty.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embedded so UI/AppIcons.cs can load them at runtime via
         Assembly.GetManifestResourceStream (see Assets/README.md) — the app/title-bar icon
         and the File Lookup tree's file icon both come from here. A recent git merge wiped
         this ItemGroup down to empty, which is why both had silently stopped showing (the
         lookup in AppIcons.cs just returns null when the resource isn't found instead of
         throwing, so the app kept running with no icon instead of erroring). -->
    <EmbeddedResource Include="Assets\bee.ico" />
    <EmbeddedResource Include="Assets\app.ico" />
    <!-- 2 logo Fast dùng ở góc trái biên bản xác nhận (Services/BbxnService). -->
    <EmbeddedResource Include="Assets\bbxn\logo1.png" LogicalName="bbxn.logo1.png" />
    <EmbeddedResource Include="Assets\bbxn\logo2.png" LogicalName="bbxn.logo2.png" />
    <EmbeddedResource Include="Assets\includecheck\*.txt" LogicalName="includecheck.%(Filename)%(Extension)" />
    <!-- Write Schema → cập nhật bảng trong .rpt: chạy bằng Windows PowerShell 5.1 + Crystal runtime (Services/Rpt/RptSchemaService). -->
    <EmbeddedResource Include="Assets\rpt\rptschema.ps1" LogicalName="rpt.rptschema.ps1" />
    <EmbeddedResource Include="Assets\ssms\ssmslogin.ps1" LogicalName="ssms.ssmslogin.ps1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bee's own FCode client DLL (see Libs/README.md) — referenced as an ordinary library and
         called through its public static API only (Crypto.RSADecrypt/Encode/...), never decompiled
         or patched. Used solely to decrypt Bee's own "ConnectStr" registry value for Ctrl+F5. -->
    <Reference Include="FastBusiness.Crypto">
      <HintPath>Libs\FastBusiness.Crypto.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Engine giải mã object WITH ENCRYPTION của CHÍNH bạn qua DAC + sys.sysobjvalues
         (known-plaintext hợp lệ, KHÔNG reverse-engineer FCode — xem Forms/DecryptSqlObjectForm.cs).
         Chỉ cần đúng DLL này: Microsoft.Data.SqlClient mà nó phụ thuộc đã được Bcode.App tham
         chiếu sẵn cùng version (5.2.2), nên không kéo theo dependency nào khác. -->
    <!-- Module "Tạo báo cáo": project riêng ở src/Bcode.ReportBuilder (xem README ở đó), chỉ nhúng DLL đã build — giống ExcelToFrx / SqlDecryptor.Core.
         Alias "rb" (extern alias) vì DLL liên kết sẵn vài file dùng chung của Bcode.App nên có kiểu trùng tên; xem Services/ReportBuilderModule.cs. -->
    <Reference Include="Bcode.ReportBuilder">
      <HintPath>Libs\Bcode.ReportBuilder.dll</HintPath>
      <Aliases>rb</Aliases>
      <Private>true</Private>
    </Reference>
    <Reference Include="SqlDecryptor.Core">
      <HintPath>Libs\SqlDecryptor.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Tab "Excel → FRX": Excel mẫu in -> FastReport (.frx). DLL build từ src\ExcelToFrx (source của
         chính mình, xem Libs/ExcelToFrx/README.md). FrxGenerator.exe (net48 + FastReport.dll) và bộ mẫu .frx chuẩn
         chép ra thư mục ExcelToFrx\ ở output; MainForm.OpenExcelToFrxTab trỏ thẳng tới đó. -->
    <Reference Include="ExcelToFrx">
      <HintPath>Libs\ExcelToFrx\ExcelToFrx.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- PdfPig (ExcelToFrx đọc thẳng chữ trong PDF mẫu in): khai rõ để có trong Bcode.deps.json — chỉ chép DLL cạnh ExcelToFrx.dll thì .NET không nạp -->
    <Reference Include="UglyToad.PdfPig" Condition="Exists('Libs\ExcelToFrx\UglyToad.PdfPig.dll')"><HintPath>Libs\ExcelToFrx\UglyToad.PdfPig.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UglyToad.PdfPig.Core" Condition="Exists('Libs\ExcelToFrx\UglyToad.PdfPig.Core.dll')"><HintPath>Libs\ExcelToFrx\UglyToad.PdfPig.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UglyToad.PdfPig.DocumentLayoutAnalysis" Condition="Exists('Libs\ExcelToFrx\UglyToad.PdfPig.DocumentLayoutAnalysis.dll')"><HintPath>Libs\ExcelToFrx\UglyToad.PdfPig.DocumentLayoutAnalysis.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UglyToad.PdfPig.Fonts" Condition="Exists('Libs\ExcelToFrx\UglyToad.PdfPig.Fonts.dll')"><HintPath>Libs\ExcelToFrx\UglyToad.PdfPig.Fonts.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UglyToad.PdfPig.Package" Condition="Exists('Libs\ExcelToFrx\UglyToad.PdfPig.Package.dll')"><HintPath>Libs\ExcelToFrx\UglyToad.PdfPig.Package.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UglyToad.PdfPig.Tokenization" Condition="Exists('Libs\ExcelToFrx\UglyToad.PdfPig.Tokenization.dll')"><HintPath>Libs\ExcelToFrx\UglyToad.PdfPig.Tokenization.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UglyToad.PdfPig.Tokens" Condition="Exists('Libs\ExcelToFrx\UglyToad.PdfPig.Tokens.dll')"><HintPath>Libs\ExcelToFrx\UglyToad.PdfPig.Tokens.dll</HintPath><Private>true</Private></Reference>
    <None Remove="Libs\ExcelToFrx\**" />
    <None Include="Libs\ExcelToFrx\FrxGenerator\**">
      <Link>ExcelToFrx\FrxGenerator\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Libs\ExcelToFrx\Templates\**">
      <Link>ExcelToFrx\Templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- BcodeNote.exe (src/BcodeNote.App: Note (New) nhiều dự án) tham chiếu thẳng Bcode.dll và dùng lại control / service nội bộ (WebBarHost, WebViewEnvironment...). -->
    <InternalsVisibleTo Include="BcodeNote" />
  </ItemGroup>
  <ItemGroup>
    <!-- Screen Designer: exe riêng (src/Bcode.ScreenDesigner) — Bcode chỉ build kèm và chép ra thư mục ScreenDesigner\ cạnh Bcode.exe; mở từ menu "Triển khai". -->
    <ProjectReference Include="..\Bcode.ScreenDesigner\Bcode.ScreenDesigner.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyScreenDesigner" AfterTargets="Build">
    <ItemGroup>
      <DesignerOutput Include="..\Bcode.ScreenDesigner\bin\$(Configuration)\net8.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DesignerOutput)" DestinationFiles="@(DesignerOutput->'$(OutDir)ScreenDesigner\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- Đọc chữ trên ảnh (Tra ảnh lỗi): exe riêng src/Bcode.Ocr dùng OCR có sẵn của Windows (WinRT cần TargetFramework windows10.x) — build kèm, chép ra Ocr\. -->
    <ProjectReference Include="..\Bcode.Ocr\Bcode.Ocr.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net8.0-windows10.0.19041.0" />
  </ItemGroup>
  <Target Name="CopyOcr" AfterTargets="Build">
    <ItemGroup>
      <OcrOutput Include="..\Bcode.Ocr\bin\$(Configuration)\net8.0-windows10.0.19041.0\**\*" Exclude="..\Bcode.Ocr\bin\$(Configuration)\net8.0-windows10.0.19041.0\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(OcrOutput)" DestinationFiles="@(OcrOutput->'$(OutDir)Ocr\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- Giải mã file .f của Fast (khối <Encrypted>) cho Sơ đồ phụ thuộc: exe riêng src/Bcode.FDecrypt, chạy tiến trình tách (nạp fsystem.dll của FCode) — build kèm, chép ra FDecrypt\. -->
    <ProjectReference Include="..\Bcode.FDecrypt\Bcode.FDecrypt.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyFDecrypt" AfterTargets="Build">
    <ItemGroup>
      <!-- net48 x86 (chạy 32-bit như FCode — xem Bcode.FDecrypt.csproj). -->
      <FDecryptOutput Include="..\Bcode.FDecrypt\bin\$(Configuration)\net48\**\*" Exclude="..\Bcode.FDecrypt\bin\$(Configuration)\net48\**\*.pdb" />
      <!-- file còn sót của bản net8 cũ (64-bit) — bỏ để thư mục phát hành không mang theo -->
      <FDecryptStale Include="$(OutDir)FDecrypt\Bcode.FDecrypt.dll;$(OutDir)FDecrypt\Bcode.FDecrypt.deps.json;$(OutDir)FDecrypt\Bcode.FDecrypt.runtimeconfig.json;$(OutDir)FDecrypt\System.Management.dll;$(OutDir)FDecrypt\System.CodeDom.dll" />
    </ItemGroup>
    <Delete Files="@(FDecryptStale)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)FDecrypt\runtimes" ContinueOnError="true" />
    <Copy SourceFiles="@(FDecryptOutput)" DestinationFiles="@(FDecryptOutput->'$(OutDir)FDecrypt\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- Dấu phiên bản + "Có gì mới" + manifest SHA-256 cho "Cập nhật Bcode" (Shared/AppUpdate.cs) — dùng chung với BcodeViewer.App.
       Import CUỐI file: target manifest phải chạy sau mọi target chép ScreenDesigner / Ocr / FDecrypt. -->
  <Import Project="..\Shared\Release.targets" />
</Project>
