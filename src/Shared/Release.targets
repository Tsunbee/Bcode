<Project>
  <!--
    Dữ liệu phát hành cho cơ chế cập nhật bản mới (Shared/AppUpdate.cs) — import ở CUỐI .csproj của Bcode.App và BcodeViewer.App.
    Mỗi app phát hành vào thư mục riêng (<BcodeReleaseFolder> của từng csproj), ghi 3 file cạnh exe:
      bcode-version.json   { built, commit, config, version, build } — build = số commit git (tăng dần), so trước; giờ build chỉ dùng khi thiếu.
      bcode-changelog.txt  80 commit gần nhất "hash|ngày|nội dung" cho "Có gì mới" (ghi qua cmd > file để giữ UTF-8 tiếng Việt).
      bcode-manifest.json  danh sách file + SHA-256 (chỉ Release, hoặc /p:BcodeManifest=true): máy cập nhật chỉ tải file khác hash, kiểm hash.
    $(BcodeStampPaths) = pathspec git (tính từ thư mục project) để "Có gì mới" + commit chỉ tính commit đụng tới app này
    (vd Viewer: ". ../Shared ../Bcode.Core"); trống = cả repo (Bcode).
    Target manifest chạy sau mọi target AfterTargets="Build" khai TRƯỚC nó (chép ScreenDesigner / Ocr / FDecrypt của Bcode) — vì vậy import cuối file.
    Project KHÁC chép file vào thư mục build của app SAU khi app build xong (BcodeNote.App → cạnh Bcode.exe) phải gọi lại target
    WriteReleaseManifest của app đó (xem CopyNoteBesideBcode trong BcodeNote.App.csproj), không thì manifest lệch file thật.
    tools/publish-release.ps1 kiểm lại SHA-256 mọi file với manifest trước khi phát hành (lệch = dừng, không chép gì).
  -->
  <Target Name="WriteBuildStamp" AfterTargets="Build">
    <PropertyGroup>
      <_BcodePathArgs Condition="'$(BcodeStampPaths)' != ''"> -- $(BcodeStampPaths)</_BcodePathArgs>
    </PropertyGroup>
    <Exec Command="git log -1 --format=%25%25h$(_BcodePathArgs)" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BcodeCommit" />
    </Exec>
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BcodeBuildNo" />
    </Exec>
    <Exec Command="git -c i18n.logOutputEncoding=UTF-8 log -80 --format=%25%25h^|%25%25cs^|%25%25s$(_BcodePathArgs) &gt; &quot;$(OutDir)bcode-changelog.txt&quot;" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true" IgnoreExitCode="true" />
    <PropertyGroup>
      <BcodeBuiltUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BcodeBuiltUtc>
      <BcodeCommit Condition="$(BcodeCommit.Contains(' ')) Or $(BcodeCommit.Length) &gt; 12">unknown</BcodeCommit>
      <BcodeBuildNo Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(BcodeBuildNo)', '^\d{1,7}$'))">0</BcodeBuildNo>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)bcode-version.json" Lines="{ &quot;built&quot;: &quot;$(BcodeBuiltUtc)&quot;, &quot;commit&quot;: &quot;$(BcodeCommit)&quot;, &quot;config&quot;: &quot;$(Configuration)&quot;, &quot;version&quot;: &quot;$(Version)&quot;, &quot;build&quot;: $(BcodeBuildNo) }" Overwrite="true" />
  </Target>

  <Target Name="WriteReleaseManifest" AfterTargets="Build" Condition="'$(BcodeManifest)' == 'true' Or ('$(BcodeManifest)' == '' And '$(Configuration)' == 'Release')">
    <PropertyGroup>
      <!-- $(BcodeNestedApps) = 1 thư mục con là app tự cập nhật riêng (Bcode: ScreenDesigner) — không vào manifest -->
      <_BcodeNestedExclude Condition="'$(BcodeNestedApps)' != ''">;$(OutDir)$(BcodeNestedApps)\**</_BcodeNestedExclude>
    </PropertyGroup>
    <ItemGroup>
      <!-- bỏ *.WebView2\ (hồ sơ trình duyệt WebView2 sinh ra khi chạy Bcode / Viewer / Designer từ thư mục build — dữ liệu máy, không phát hành) -->
      <_BcodeOutFile Include="$(OutDir)**\*" Exclude="$(OutDir)bcode-manifest.json;$(OutDir)bcode-version.json;$(OutDir)bcode-changelog.txt;$(OutDir)**\*.WebView2\**$(_BcodeNestedExclude)" />
    </ItemGroup>
    <GetFileHash Files="@(_BcodeOutFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_BcodeHashed" />
    </GetFileHash>
    <PropertyGroup>
      <_BcodeOutFull>$([System.IO.Path]::GetFullPath('$(OutDir)'))</_BcodeOutFull>
    </PropertyGroup>
    <ItemGroup>
      <!-- đường dẫn tương đối, dấu / (JSON không nhận \ đơn) — tính từ FullPath vì RecursiveDir không đi qua output của task -->
      <_BcodeHashed>
        <Rel>$([MSBuild]::MakeRelative('$(_BcodeOutFull)', '%(FullPath)').Replace('\', '/'))</Rel>
      </_BcodeHashed>
    </ItemGroup>
    <WriteLinesToFile File="$(OutDir)bcode-manifest.json" Overwrite="true" Encoding="utf-8"
                      Lines="{ &quot;files&quot;: [;@(_BcodeHashed->'{ &quot;p&quot;: &quot;%(Rel)&quot;, &quot;h&quot;: &quot;%(FileHash)&quot; }', ',');] }" />
  </Target>

  <!-- Build không sinh manifest (Debug) thì xoá manifest cũ còn sót: manifest lệch file thật làm máy cập nhật báo "sai mã kiểm tra". -->
  <Target Name="DeleteStaleManifest" AfterTargets="Build" Condition="!('$(BcodeManifest)' == 'true' Or ('$(BcodeManifest)' == '' And '$(Configuration)' == 'Release'))">
    <Delete Files="$(OutDir)bcode-manifest.json" ContinueOnError="true" />
  </Target>
</Project>
