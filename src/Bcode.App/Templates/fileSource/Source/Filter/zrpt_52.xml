<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY Identity "zrpt_52">
	<!ENTITY XMLWhenFilterLoading SYSTEM "..\Include\XML\WhenFilterLoading.xml">
	<!ENTITY XMLWhenFilterClosing SYSTEM "..\Include\XML\WhenFilterClosing.xml">
	<!ENTITY OutlineCss SYSTEM "..\Include\Javascript\OutlineCss.txt">
	<!ENTITY OutlineEntry SYSTEM "..\Include\Javascript\OutlineEntry.txt">
	<!ENTITY OnSelectionOutline SYSTEM "..\Include\Javascript\OnSelectionOutline.txt">
	<!ENTITY JavascriptReportFilter SYSTEM "..\Include\Javascript\ReportFilter.txt">
	
]>

<dir type="Report" id="1" cache="true" xmlns="urn:schemas-fast-com:data-dir">
	<title v="Điều kiện lọc" e="Filter Condition"></title>

	<fields>
		<field name="tu_ky" type="Decimal" dataFormatString="#0" allowNulls="false" aliasName="fromPeriod" defaultValue="(new Date()).getMonth() + 1;">
			<header v="Từ kỳ" e="From Period"></header>
			<footer v="Từ kỳ/năm" e="From Period/Year"></footer>
			<items style="Numeric"></items>
		</field>
		<field name="tu_nam" type="Decimal" dataFormatString="###0" allowNulls="false" aliasName="fromYear" defaultValue="(new Date()).getFullYear()">
			<header v="Năm" e="Year"></header>
			<items style="Numeric"/>
		</field>
		<field name="den_ky" type="Decimal" dataFormatString="#0" allowNulls="false" aliasName="toPeriod" defaultValue="(new Date()).getMonth() + 1;">
			<header v="Đến kỳ" e="To Period"></header>
			<footer v="Đến kỳ/năm" e="To Period/Year"></footer>
			<items style="Numeric"></items>
		</field>
		<field name="den_nam" type="Decimal" dataFormatString="###0" allowNulls="false" aliasName="toYear" defaultValue="(new Date()).getFullYear()">
			<header v="Năm" e="Year"></header>
			<items style="Numeric"/>
		</field>		
		<field name="ma_kh" allowNulls="false" >
			<header v="Khách hàng" e="Customer"></header>
			<items style="AutoComplete" controller="Customer" reference="ten_kh%l" key="status = '1'" check="1=1" information ="ma_kh$dmkh.ten_kh%l"/>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''">
			<header v="" e=""></header>
		</field>
		<field name="ma_dvcs">
			<header v="Đơn vị" e="Unit"></header>
			<items style="Lookup" controller="Unit" key="status = '1'" check="1=1"/>
		</field> 
	</fields>

	<views> 
		<view id="Dir">
			<item value="120, 40, 60, 100, 130, 0, 50, 0"/>
			<item value="111-----: [tu_ky].Description, [tu_ky], [tu_nam]"/>
			<item value="111-----: [den_ky].Description, [den_ky], [den_nam]"/>
			<item value="110100--: [ma_kh].Label, [ma_kh], [ten_kh%l]"/>
			<item value="110000--: [ma_dvcs].Label, [ma_dvcs]"/>
			
		</view>  
	</views>

	<commands>
		&XMLWhenFilterLoading;
		&XMLWhenFilterClosing;
		
		<command event="Processing">
			<text>
				<![CDATA[
select @tu_ky tu_ky, @tu_nam tu_nam, @den_ky den_ky, @den_nam den_nam
exec zrpt_52 @tu_ky, @tu_nam, @den_ky, @den_nam, @ma_dvcs, @@language, @@userID, @@admin, @ma_kh
]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			&OutlineEntry;
			&JavascriptReportFilter; 
			<![CDATA[
function active$VoucherFilter$(f) {
	f.add_onResponseComplete(on$Filter$ResponseComplete); 
	changeLookupReadonly(f, 'ma_dvcs');
}
function close$VoucherFilter$(f) {
	try {f.remove_onResponseComplete(on$Filter$ResponseComplete);} catch (ex) {}
}
function on$Filter$ResponseComplete(sender, e) {
	var f = e.object, context = e.type.Context, result = e.type.Result;
	switch (context) {
		case 'Checking':
			var g = f.grid; 
			g._hiddenForms = [];
			g._alterTitle = [null, [['%s1', f.getItemValue('tu_ky'), true], ['%s2', f.getItemValue('tu_nam'), true], ['%s3', f.getItemValue('den_ky'), true], ['%s4', f.getItemValue('den_nam'), true]]];
			//remove$GridReport$Filter(g);
			break;
		default:
			break;
	}
}
]]>
		</text>
	</script>

	&OutlineCss;
</dir>