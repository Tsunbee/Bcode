<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
  <!ENTITY % BalanceSheetName SYSTEM "..\Include\BalanceSheetName.ent">
  %BalanceSheetName;
]>
<grid table="v20gltc1" code="form, stt, ma_so" order="form, stt, ma_so" xmlns="urn:schemas-fast-com:data-grid">
  <title v="&Name.TitleDeclaration.v;" e="&Name.TitleDeclaration.e;"></title>
  <subTitle v="Mẫu báo cáo: %s." e="Report Form: %s."></subTitle>

  <fields>
    <field name="form" isPrimaryKey="true" width="" hidden="true">
      <header v="" e=""></header>
    </field>
    <field name="stt" isPrimaryKey="true" width="60" align="right" allowFilter="true" allowSorting="true">
      <header v="Stt" e="Number"></header>
    </field>
    <field name="ma_so" isPrimaryKey="true" width="100" allowFilter="true" allowSorting="true">
      <header v="Mã số" e="Code"></header>
    </field>
    <field name="chi_tieu%l" width="300" allowFilter="true" allowSorting="true">
      <header v="Chỉ tiêu" e="Norm"></header>
    </field>
    <field name="thuyet_minh" width="100" allowFilter="true" allowSorting="true">
      <header v="Thuyết minh" e="Interpretation"></header>
    </field>
    <field name="cach_tinh" width="300" allowFilter="true" allowSorting="true">
      <header v="Công thức" e="Formula"></header>
    </field>
    <field name="tk" width="100" allowFilter="true" allowSorting="true">
      <header v="Tài khoản" e="Account"></header>
    </field>
    <field name="in_ck" width="60" align="right" allowFilter="true" allowSorting="true">
      <header v="In" e="Print"></header>
    </field>
  </fields>

  <views>
    <view id="Grid">
      <field name="form"/>
      <field name="stt"/>
      <field name="ma_so"/>
      <field name="chi_tieu%l"/>
      <field name="thuyet_minh"/>
      <field name="cach_tinh"/>
      <field name="tk"/>
      <field name="in_ck"/>
    </view>
  </views>

  <commands>
    <command event="Loading">
      <text>
        <![CDATA[select 'load$Grid(this);' as message
return]]>
      </text>
    </command>

    <command event="Closing">
      <text>
        <![CDATA[select 'dispose$Grid(this);' as message
return]]>
      </text>
    </command>
  </commands>

  <script>
    <text>
      <![CDATA[/* <flatten type="Javascript"> */
function load$Grid(g) {g.add_commandEvent(on$GridReport$ExecuteCommand);}
function dispose$Grid(g) {try {g.remove_commandEvent(on$GridReport$ExecuteCommand);} catch (ex) {}}
function on$GridReport$ExecuteCommand(sender, e) {
  var action = e.type.Action, g = sender;
  switch (action) {
    case 'BeforeFormLoad':
      e.type.Value.set_vars([{Name: 'c', Type: 'String', Value: g._formCode}]);
      break;
    default:
      break;
  }
}
/* </flatten> */]]>
    </text>
  </script>

  <toolbar>
    <button command="New">
      <title v="Toolbar.New" e="Toolbar.New"></title>
    </button>
    <button command="Edit">
      <title v="Toolbar.Edit" e="Toolbar.Edit"></title>
    </button>
    <button command="Delete">
      <title v="Toolbar.Delete" e="Toolbar.Delete"></title>
    </button>
    <button command="Search">
      <title v="Toolbar.Search" e="Toolbar.Search"></title>
    </button>
    <button command="View">
      <title v="Toolbar.View" e="Toolbar.View"></title>
    </button>
    <button command="Export">
      <title v="Toolbar.Export" e="Toolbar.Export"/>
    </button>
    <button command="Freeze">
      <title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
    </button>
  </toolbar>
</grid>