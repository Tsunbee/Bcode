<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY Identity "zrpt_O057">
	<!ENTITY XMLWhenFilterLoading SYSTEM "..\Include\XML\WhenFilterLoading.xml">
	<!ENTITY XMLWhenFilterClosing SYSTEM "..\Include\XML\WhenFilterClosing.xml">
	<!ENTITY OutlineCss SYSTEM "..\Include\Javascript\OutlineCss.txt">
	<!ENTITY OutlineEntry SYSTEM "..\Include\Javascript\OutlineEntry.txt">
	<!ENTITY OnSelectionOutline SYSTEM "..\Include\Javascript\OnSelectionOutline.txt">
	<!ENTITY JavascriptReportFilter SYSTEM "..\Include\Javascript\ReportFilter.txt">
	<!ENTITY ScriptQueryFilterString SYSTEM "..\Include\Javascript\QueryFilterString.txt">

	
]>

<dir type="Report" id="1" cache="true" xmlns="urn:schemas-fast-com:data-dir">
	<title v="Điều kiện lọc" e="Filter Condition"></title>
	<fields>
		<field name="tu_ngay" type="DateTime" dataFormatString="@datetimeFormat" allowNulls="false" aliasName="fromDate" defaultValue="new Date()">
			<header v="Từ ngày" e="Date from"></header>
			<footer v="Từ/đến ngày" e="Date from/to"></footer>
		</field>
		<field name="den_ngay" type="DateTime" dataFormatString="@datetimeFormat" allowNulls="false" aliasName="toDate" defaultValue="new Date()">
			<header v="Đến ngày" e="Date to"></header>
		</field>
		<field name="nh_vv1" allowNulls="false">
			<header v="Dự án" e="Job"></header>
			<items style="Lookup" controller="JobGroup" key="status ='1' and loai_nh = 1" check="loai_nh = 1" information ="ma_nh$dmnhvv.ten_nh%l"/>
		</field>
		<field name="loai_sp" >
			<header v="Loại sản phẩm" e="Project"></header>
			<items style="Lookup" controller="zdmloaisp" reference="ten_loai_sp%l" key="status ='1'" check="1=1" information="loai_sp$zdmloaisp.ten_loai_sp%l"/>
		</field>
		<field name="ten_loai_sp%l" readOnly="true" external="true" defaultValue="''" inactivate="true">
			<header v="" e=""></header>
		</field>
			<field name="kieu_sp" >
			<header v="Kiểu sản phẩm" e="Product style"></header>
			<items style="Lookup" controller="zdmkieusp" key="status='1'" check="1=1" reference="ten_kieu_sp%l" information="kieu_sp$zdmkieusp.ten_kieu_sp%l"/>
		</field>
		<field name="ten_kieu_sp%l" defaultValue="''" readOnly="true" external="true" categoryIndex="1">
			<header v="" e=""/>
		</field>
		<field name="ma_hd">
			<header v="Hợp đồng" e="Contract"></header>
			<items style="Lookup" controller="Contract" key="status = '1'" check="1=1" information="ma_hd$dmhd.ten_hd%l"/>
		</field>
		<field name="ma_kh">
			<header v="Khách hàng" e="Customer"></header>
			<items style="AutoComplete" controller="Customer" reference="ten_kh%l" key="status = '1'" check="1=1" information="ma_kh$dmkh.ten_kh%l"/>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''" inactivate="true">
			<header v="" e=""></header>
		</field>
		<field name="tien" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" defaultValue="0">
			<header v="Tiền" e="Amount"></header>
			<items style="Numeric"/>
		</field>		<field name="ma_dvcs">			<header v="Đơn vị" e="Unit"></header>			<items style="Lookup" controller="Unit" key="status='1'" check="1=1"/>		</field>		
		<field name="mau_bc" clientDefault="10">			<header v="Mẫu báo cáo" e="Report Form"></header>			<items style="DropDownList">				<item value="10">					<text v="Mẫu chuẩn" e="Standard Form"/>				</item>			</items>			<clientScript>&OnSelectionOutline;</clientScript>		</field> 
	</fields>

	<views> 
		<view id="Dir">			<item value="120, 40, 60, 100, 130, 0, 50, 0"/>			<item value="1101----: [tu_ngay].Label, [tu_ngay], [den_ngay]"/>			<item value="110000--: [nh_vv1].Label, [nh_vv1]"/>
			<item value="110000--: [loai_sp].Label, [loai_sp]"/>
			<item value="110000--: [kieu_sp].Label, [kieu_sp]"/>			<item value="110000--: [ma_hd].Label, [ma_hd]"/>
			<item value="110100--: [ma_kh].Label, [ma_kh], [ten_kh%l]"/>			<item value="110-----: [tien].Label, [tien]"/>			<item value="110000--: [ma_dvcs].Label, [ma_dvcs]"/>			<item value="110000--: [mau_bc].Label, [mau_bc]"/>
		</view>  
	</views>

	<commands>
		&XMLWhenFilterLoading;
		&XMLWhenFilterClosing;
		
		<command event="Processing">
			<text>
				<![CDATA[
select @tu_ngay as tu_ngay, @den_ngay as den_ngay
exec zrpt_O057 @tu_ngay, @den_ngay, @nh_vv1, @loai_sp, @kieu_sp, @ma_hd, @ma_kh, @tien, @ma_dvcs, '@@sysDatabaseName', @@language, @@userID, @@admin
]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			&OutlineEntry;
			&ScriptQueryFilterString;
			&JavascriptReportFilter; 
			<![CDATA[
function active$VoucherFilter$(f) {
	f.add_onResponseComplete(on$Filter$ResponseComplete); 
	changeLookupReadonly(f, 'ma_dvcs');
	changeLookupReadonly(f, 'loai_sp');
	changeLookupReadonly(f, 'kieu_sp');
	changeLookupReadonly(f, 'nh_vv1');
}
function close$VoucherFilter$(f) {
	try {f.remove_onResponseComplete(on$Filter$ResponseComplete);} catch (ex) {}
}
function on$Filter$ResponseComplete(sender, e) {
	var f = e.object, context = e.type.Context, result = e.type.Result;
	switch (context) {
		case 'Checking':
			var g = f.grid, v = f.getItem('mau_bc').value; 
			g._hiddenForms = [];
			g._alterTitle = [null, [['%s1', f.getItem('tu_ngay').value, true], ['%s2', f.getItem('den_ngay').value, true]]];
			g._queryFilterString = getQueryFilterString(f, 'tu_ngay, den_ngay, ma_dvcs');
			//remove$GridReport$Filter(g);
			break;
		default:
			break;
	}
}
]]>
		</text>
	</script>

	&OutlineCss;
</dir>