<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" valid="systotal = 1" filter="" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Báo cáo tồn kho theo khách hàng" e="Stock By Customer Report"></title>
	<subTitle v="Ngày %s1..." e="Date %s1..."></subTitle>
	
	<fields>
		<field name="stt" width="60" type="Decimal" dataFormatString="####" allowSorting="true" allowFilter="true">
			<header v="Stt" e=" Number"></header>
		</field>
		<field name="ten_kh" width="250" allowSorting="true" allowFilter="true">
			<header v="Khách hàng" e="Customer Name"></header>
		</field>
		<field name="sl_cont_ton" width="100" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng cont tồn tại đóng gói" e="Number of containers available for packing"></header>
		</field>
		<field name="sl_cont_co_lich" width="100" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng cont đã có lịch xuất dự kiến" e="Number of containers with scheduled export"></header>
		</field>
		<field name="sl_cont_chua_co_lich" width="100" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng cont tồn đóng gói chưa có lịch xuất" e="Number of unpacked containers with no export schedule"></header>
		</field>
		<field name="ton_chua_co_lich" width="100" type="Decimal" dataFormatString="@quantityViewFormat" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng cont tồn tại nhà máy chưa có lịch xuất" e="Number of containers in the factory with no export schedule"></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="stt"/>
			<field name="ten_kh"/>
			<field name="sl_cont_ton"/>
			<field name="sl_cont_co_lich"/>
			<field name="sl_cont_chua_co_lich"/>
			<field name="ton_chua_co_lich"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
		  <text>
			<![CDATA[select 'load$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
		<command event="Closing">
		  <text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
	</commands>

	<script>
		<text>
			&JavascriptReportInit;
		</text>
	</script>
	
	&XMLStandardReportToolbar;
</grid>