<Project Sdk="Microsoft.NET.Sdk">
  <!-- "Xem chung" — phòng chiếu phim qua LAN văn phòng: link YouTube / MP4 / MP3 trên mạng, hoặc file trên máy chủ phòng phát qua LAN.
       Exe RIÊNG (module tách khỏi game Giải lao): Bcode chỉ build kèm, chép ra thư mục Watch\ cạnh Bcode.exe, mở từ menu "Giải trí → Xem chung".
       Không có thư viện ngoài ngoài WebView2: mạng bằng TcpListener / UdpClient (không HttpListener — bind ra ngoài localhost cần quyền admin). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bcode.Watch</RootNamespace>
    <AssemblyName>BcodeWatch</AssemblyName>
    <Product>Bcode — Xem chung</Product>
    <Authors>HaoTN</Authors>
    <Description>Rạp Bcode — xem chung video / nhạc qua LAN văn phòng, đồng bộ theo chủ phòng.</Description>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Logo Rạp: dựng từ Web\logo.svg (40–256 px) + Web\logo-small.svg (16–32 px) — WatchForm lấy icon cửa sổ từ exe -->
    <ApplicationIcon>watch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Web\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dùng chung với game Giải lao: mật khẩu phòng (challenge–response) + DPAPI cho mật khẩu nhớ trong watch-lan.json -->
    <Compile Include="..\Shared\RoomAuth.cs" Link="Shared\RoomAuth.cs" />
    <Compile Include="..\Shared\DpapiText.cs" Link="Shared\DpapiText.cs" />
    <!-- Dọn hồ sơ WebView2 theo pid của lần chạy cũ trong %TEMP% (trước đây không bao giờ xoá) -->
    <Compile Include="..\Shared\WebViewProfileCleanup.cs" Link="Shared\WebViewProfileCleanup.cs" />
  </ItemGroup>
</Project>
