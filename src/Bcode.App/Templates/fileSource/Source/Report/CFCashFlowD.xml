<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE report [
  <!ENTITY s SYSTEM ".\Include\Separate.xml">

  <!ENTITY e "../images/excel.gif">
]>

<report xmlns="urn:schemas-fast-com:data-report">
  <query>
    <text>
      <![CDATA[select * from cfgltc03 where form = @form order by form, stt, ma_so]]>
    </text>
  </query>

  <forms>
    <form id="0" templateFile ="CFCashFlowD_01" commandArgument="Excel" urlImage="&e;">
      <header v="Báo cáo lưu chuyển tiền tệ hợp nhất theo phương pháp trực tiếp" e="Consolidated Cash Flow Statement under the Direct Method"/>
      <download>
        <header v="Báo cáo lưu chuyển tiền tệ hợp nhất theo phương pháp trực tiếp" e="Consolidated Cash Flow Statement under the Direct Method"/>
      </download>
    </form>
  </forms>

  <fields>
    <field name="h_stt">
      <header v="Stt" e="Number"/>
    </field>
    <field name="h_ma_so">
      <header v="Mã số" e="Code"/>
    </field>
    <field name="h_ma_so_in">
      <header v="Mã số khi in" e="Code When Print"/>
    </field>
    <field name="h_chi_tieu">
      <header v="Chỉ tiêu" e="Norm"/>
    </field>
    <field name="h_chi_tieu2">
      <header v="Chỉ tiêu khác" e="Other Norm"/>
    </field>
    <field name="h_thuyet_minh">
      <header v="Thuyết minh" e="Interpretation"/>
    </field>

    <field name="h_in_ck">
      <header v="In" e="Print"/>
    </field>
    <field name="h_in_tl_ck">
      <header v="In mẫu tóm lược" e="Print Summary Form"/>
    </field>
    <field name="h_bold">
      <header v="Kiểu chữ" e="Font Bold"/>
    </field>
    <field name="h_kieu_hien">
      <header v="Kiểu hiện" e="Sign Indicator"/>
    </field>

    <field name="h_kind">
      <header v="Cách tính" e="Calculating Way"/>
    </field>
    <field name="h_kieu_tinh">
      <header v="Kiểu tính" e="Balance Minus Type"/>
    </field>
    <field name="h_ds_ct">
      <header v="Danh sách chỉ tiêu" e="Consolidated Articles"/>
    </field>
    <field name="h_kind_hn">
      <header v="Cách tính hợp nhất" e="Consolidating Base"/>
    </field>
    <field name="h_loai_dc">
      <header v="Loại điều chỉnh" e="Adjustment Type"/>
    </field>
    <field name="h_cach_tinh">
      <header v="Công thức" e="Formula"/>
    </field>
    <field name="h_cach_tinh_hn">
      <header v="Công thức hợp nhất" e="Consolidating Formula"/>
    </field>
  </fields>
</report>