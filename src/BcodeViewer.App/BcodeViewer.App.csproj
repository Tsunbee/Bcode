<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BcodeViewer.App</RootNamespace>
    <AssemblyName>BcodeViewer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <!-- SQL IntelliSense only (table/column names — see Host/SqlSchemaService). BcodeViewer
         reuses the workspace Bcode.App already stores in %AppData%\Bcode\settings.json
         rather than referencing Bcode.App, which would drag its whole WinForms/ClosedXML
         surface into a standalone editor for two SELECTs. Same package version Bcode.App
         pins, so a machine with both installed doesn't end up with two native SNI copies. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The whole Web/ folder (index.html, editor.js, chat.js, style.css, vendored
         monaco-editor/min/vs) ships next to the exe so WebView2 can load it via a
         file:// path with no build step and no internet access needed at runtime. -->
    <None Include="Web\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- ApplicationIcon alone only sets the .exe file's own icon (Explorer/taskbar
         pinning) — the running window's titlebar icon needs Form.Icon set explicitly
         at runtime (see MainForm's constructor), which needs the file alongside the exe. -->
    <None Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
