<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [	
	<!ENTITY DowloadScript SYSTEM "..\Include\Javascript\DownloadScript.txt">
	<!ENTITY TransferID "dm_giao_dich">
	<!ENTITY CreateTicket "declare @ticket varchar(32), @filename varchar(128), @description nvarchar(128)
select @ticket = lower(replace(newid(),'-',''))
select @filename = 'dm_giao_dich.xlsx', @description = N'Phiếu giao dịch'
insert into @@sysDatabaseName..ticket values(@ticket, @@userID, '&TransferID;', @filename, @description, '@@appDatabaseName', getdate());">
		
	<!ENTITY UnitFilter "">
	<!ENTITY UnitQuery "">

	<!ENTITY % ExportImportTemplate SYSTEM "..\Include\ExportImportTemplate.ent">
	%ExportImportTemplate;
	<!ENTITY ExportImportTemplate.UploadController "controller=&TransferID;&amp;form=&TransferID;">
]>

<grid table="dm_giao_dich" regular="." code="id_tich_hop, ma_hd" order="ngay_giao_dich, ma_hd" filter="&UnitFilter;" initialize="&UnitQuery;" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Phiếu giao dịch" e="Reservation form"></title>
	<subTitle v="Cập nhật: Thêm, sửa, xóa" e="Input: New, Edit, Delete"></subTitle>
	<fields>
		<field name="id_tich_hop" isPrimaryKey="true" dataFormatString="@upperCaseFormat" width="250" allowFilter="true" allowSorting="true">
			<header v="ID" e="ID"></header>
			<items style="Mask"/>
		</field>
		<field name="ma_hd" isPrimaryKey="true" dataFormatString="@upperCaseFormat" width="150" allowFilter="true" allowSorting="true">
			<header v="Mã hợp đồng" e="Contract code"></header>
			<items style="Mask"/>
		</field>
		<field name="loai_hd2" allowSorting="true" allowFilter="true" width="100">
			<header v="Loại hợp đồng" e="Contract Type"></header>
		</field>
		<field name="ma_hd_goc" dataFormatString="@upperCaseFormat" width="150" allowFilter="true" allowSorting="true">
			<header v="Hợp đồng gốc" e="Contract code"></header>
			<items style="Mask"/>
		</field>
		<field name="ngay_giao_dich" type="DateTime" dataFormatString="@datetimeFormat" width="100" allowFilter="true" allowSorting="true">
			<header v="Ngày giao dịch" e="Ngày giao dịch"></header>
		</field>
		<field name="ma_kh" dataFormatString="@upperCaseFormat" width="100" allowFilter="true" allowSorting="true">
			<header v="Khách hàng" e="Customer"></header>
			<items style="Mask"/>
		</field>
		<field name="ma_nvbh" dataFormatString="@upperCaseFormat" width="100" allowFilter="true" allowSorting="true">
			<header v="Nhân viên kinh doanh" e="Nhân viên kinh doanh"></header>
			<items style="Mask"/>
		</field>
		<field name="tien_coc" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" width="100" allowFilter="true" allowSorting="true">
			<header v="Tiền cọc" e="Tiền giao dịch"></header>
		</field>
		<field name="ngay_tl" type="DateTime" dataFormatString="@datetimeFormat" width="100" allowFilter="true" allowSorting="true">
			<header v="Ngày thanh lý" e="Ngày giao dịch"></header>
		</field>
			<field name="tien_tl" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" width="100" allowFilter="true" allowSorting="true">
			<header v="Tiền thanh lý" e="Tiền giao dịch"></header>
		</field>
		
			<field name="tinh_trang_gd" allowSorting="true" allowFilter="true" width="100">
			<header v="Tình trạng" e="Contract Type"></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
		<field name="id_tich_hop"/>
		<field name="ma_hd"/>
		<field name="loai_hd2"/>
		<field name="ma_hd_goc"/>
		<field name="ngay_giao_dich"/>
		<field name="ma_kh"/>
		<field name="ma_nvbh"/>
		<field name="tien_coc"/>
		<field name="ngay_tl"/>
		<field name="tien_tl"/>
		<field name="tinh_trang_gd"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>			
				&CreateTicket;<![CDATA[			
select 'this._key = ''' + @ticket + ''';this._authorize = ' + rtrim(@@sysDatabaseName.dbo.FastBusiness$System$GetAuthorize(@@admin, @@userID, 'dm_giao_dich', 'New')) + ';load$Grid(this);' as message
return
]]>
			</text>
		</command>
		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$Grid(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$Grid(g) {
	g.add_onResponseComplete(on$GridMain$ResponseComplete);	
	g.add_commandEvent(on$GridMain$ExecuteCommand);
}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridMain$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridMain$ResponseComplete);} catch (ex) {}	
}
function on$GridMain$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	
	switch (action) {	
		case 'ImportData': 
			(g._authorize == 1) ? g.showForm('dm_giao_dichImport') : $message.show($df.getResources(g._language, "Message.NotAccess"));
			break;
		case 'Download':
			]]>&UserDefinedDownload;<![CDATA[
			break;
		default:
			break;
	}
}
function on$GridMain$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {		
		case 'Download':
			g._key = result[0].Value;
			break;
		default:
			break;
	}
}
]]> 
			&DowloadScript; 
		</text>
	</script>	
 
	<response>
		<action id="Download">
			<text>
				&CreateTicket;<![CDATA[
select @ticket as value
return
]]>
			</text>
		</action>
	</response>
	
	<css>
		<text>
			<![CDATA[
div.ImportData{background-image:url(../images/Upload.png);background-repeat:no-repeat;background-position:0 0;}
div.ImportDataOverGreen{background-position:0 -22px;}
div.Download{background-image:url(../Images/Download.png);background-repeat:no-repeat;background-position:0 0;}
div.DownloadOverGreen{background-position:0 -22px;}
]]>
		</text>
	</css>

	<toolbar>
		<button command="New">
			<title v="Toolbar.New" e="Toolbar.New"></title>
		</button>
		<button command="Edit">
			<title v="Toolbar.Edit" e="Toolbar.Edit"></title>
		</button>
		<button command="Delete">
			<title v="Toolbar.Delete" e="Toolbar.Delete"></title>
		</button>
		<button command="Search">
			<title v="Toolbar.Search" e="Toolbar.Search"></title>
		</button>
		<button command="View">
			<title v="Toolbar.View" e="Toolbar.View"></title>
		</button>
		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"/>
		</button>		 
		<button command="-">
			<title v="-" e="-"/>
		</button>
		<button command="ImportData">
			<title v="Lấy dữ liệu từ tệp..." e="Import Data from File..."></title>
		</button>
		<button command="Download">
			<title v="Tải tệp mẫu..." e="Download Template File..."/>
		</button> 
		<button command="Separate">
			<title v="-" e="-"/>
		</button>		
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>
</grid>