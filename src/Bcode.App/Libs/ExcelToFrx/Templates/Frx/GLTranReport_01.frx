    <Parameter Name="f_so_ct" DataType="System.String" Expression="Trim([d1.so_ct])"/>
    <Parameter Name="_ngay_ct" DataType="System.String" Expression="FormatDateTime([d1.ngay_ct], [dateFormatString])"/>
