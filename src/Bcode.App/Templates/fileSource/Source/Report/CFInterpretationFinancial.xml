<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE report [
  <!ENTITY s SYSTEM ".\Include\Separate.xml">

  <!ENTITY e "../images/excel.gif">
]>

<report xmlns="urn:schemas-fast-com:data-report">
  <query>
    <text>
      <![CDATA[
select stt, ma_so, chi_tieu, chi_tieu2, loai_chi_tieu, kieu_so_lieu, loai_so_du, loai_so_lieu, ma_tham_chieu, kind, loai_dc, cach_tinh
  from cfgltc05 where form = @form order by form, stt, ma_so
]]>
    </text>
  </query>

  <forms>
    <form id="0" templateFile ="CFInterpretationFinancial_01" commandArgument="Excel" urlImage="&e;">
      <header v="Thuyết minh báo cáo tài chính hợp nhất" e="Consolidated Interpretation of Financial"/>
      <download>
        <header v="Thuyết minh báo cáo tài chính hợp nhất" e="Consolidated Interpretation of Financial"/>
      </download>
    </form>
  </forms>

  <fields>
    <field name="h_stt">
      <header v="Stt" e="Number"/>
    </field>
    <field name="h_ma_so">
      <header v="Mã số" e="Code"/>
    </field>
    <field name="h_chi_tieu">
      <header v="Chỉ tiêu" e="Norm"/>
    </field>
    <field name="h_chi_tieu2">
      <header v="Chỉ tiêu khác" e="Other Norm"/>
    </field>
    <field name="h_loai_chi_tieu">
      <header v="Loại chỉ tiêu" e="Article Type"/>
    </field>
    <field name="h_kieu_so_lieu">
      <header v="Kiểu số liệu" e="Data Type"/>
    </field>
    <field name="h_loai_so_du">
      <header v="Loại số dư" e="Balance Type"/>
    </field>
    <field name="h_loai_so_lieu">
      <header v="Loại số liệu" e="Period"/>
    </field>

    <field name="h_ma_tham_chieu">
      <header v="Mã số tham chiếu" e="Reference Code"/>
    </field>
    <field name="h_kind">
      <header v="Cách tính" e="Calculating Way"/>
    </field>
    <field name="h_loai_dc">
      <header v="Loại điều chỉnh" e="Adjustment Type"/>
    </field>
    <field name="h_cach_tinh">
      <header v="Công thức" e="Formula"/>
    </field>
    <field name="h_bat_buoc">
      <header v="Tên trường bắt buộc nhập" e="Indicates a required field"/>
    </field>
  </fields>
</report>