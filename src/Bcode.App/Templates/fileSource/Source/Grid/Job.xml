	<script>
		<text>
			<![CDATA[/* <flatten type="Javascript"> */
function load$Grid(g) {
	g.add_onResponseComplete(on$GridJob$ResponseComplete);
	g.add_commandEvent(on$GridJob$ExecuteCommand);
	g.add_onRender(on$GridJob$GridRender);
}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridJob$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridJob$ResponseComplete);} catch (ex) {}
	try {g.remove_onRender(on$GridJob$GridRender);} catch (ex) {}
}
function on$GridJob$GridRender(sender, eventArgs) {
	var g = eventArgs.grid;
	if (g._extensions && g._rowCount == 1) {
		g._setActiveCell(g._getItem(1, 1));
		g.executeCommand({commandName:'View',commandArgument:'0'})
	}
}
/* </flatten> */
function on$GridJob$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	switch (action) {
			case 'ImportData':
			show$Form(g, 'JobImportUpdate');
			break;
		case 'Download':
			if (e.type.Value == '210') {
				]]>&UserDefinedDownload;<![CDATA[
			} else if (e.type.Value == '240') 
			{
					var r = $get('requestFormData');
					if (!r) r = $func.requestFormData();
					var query = '?type=TemplateUpload&controller=Job&form=JobUpdateXHD' + String.format('&r={0}', Math.random());
					r.action = $func.resolveClientUrl('~/AppHandler/ExportHandler.ashx' + query, g._baseUrl);
					if (!$func.isIE) r.target = '_blank';
					r.submit();
					break;
			}
			else {
				]]>&UserDefinedDownloadExtension;<![CDATA[
			}
			break;
		default:
			break;
	}
}
/* <flatten type="Javascript"> */
function on$GridJob$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		case 'Download':
			g._key = result[0].Value;
			break;
		case 'Allowance':
			g._$key = result[0].Value;	
			break;
		default:
			break;
	}
}
function show$Form(g, c) {(g._authorize == 1) ? g.showForm(c) : $message.show($df.getResources(g._language, "Message.NotAccess"));}
/* </flatten> */]]>
			&DowloadScript;
