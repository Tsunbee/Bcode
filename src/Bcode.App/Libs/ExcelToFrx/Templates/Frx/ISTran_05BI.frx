    <Parameter Name="f_bi_total" DataType="System.String" Expression="&quot;(&quot; + [2_total] + &quot;)&quot;"/>
    <Parameter Name="f_kho" DataType="System.String" Expression="[d1.ma_kho] + IIf([languageType]==1, IIf([d1.ten_kho] != &quot;&quot;, &quot; - &quot; + [d1.ten_kho], &quot;&quot;), IIf([d1.ten_kho2] != &quot;&quot;, &quot; - &quot; + [d1.ten_kho2], &quot;&quot;))"/>
    <Parameter Name="f_kho2" DataType="System.String" Expression="IIf([languageType]==1  , IIf([d1.ten_kho2] != &quot;&quot;, &quot;\n&quot; + [d1.ten_kho2] , &quot;&quot;)  , IIf([d1.ten_kho] != &quot;&quot;, &quot;\n&quot; + [d1.ten_kho], &quot;&quot;)  )"/>
