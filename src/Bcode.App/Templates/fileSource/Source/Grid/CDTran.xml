		<action id="GetOtherData">
	<text>
		<![CDATA[
declare @q nvarchar(max), @slstt_rec nvarchar(max)
select @slstt_rec = text from @lstt_rec

select top 0 @slstt_rec as data, b.line_nbr, b.stt_rec, cast(null as varchar(max)) as ddyn, ma_td1 as d_ma_td1, ma_hd as d_ma_hd, ma_sp as d_ma_sp, ma_vv as d_ma_vv, cast('' as nvarchar(max)) as d_tk_no into #m from d]]>&ddTable;<![CDATA[$000000 b right join (select null as v) x on 1 = 0

insert into #m(data) select data from [dbo].[FastBusiness$Function$System$Split](@slstt_rec, char(252)) a where id > 1

update #m set line_nbr = dbo.FastBusiness$Function$GetWordNum(data, 1, char(253)), stt_rec = dbo.FastBusiness$Function$GetWordNum(data, 2, char(253))

if ']]>&ddTable;<![CDATA[' in ('42', '83', '26') update #m set ddyn = 'd]]>&ddTable;<![CDATA[$000000'
else begin
	set @q = 'update #m set ddyn = ''d]]>&ddTable;<![CDATA[$'' + convert(char(6), ngay_ct, 112) from #m a join c]]>&ddTable;<![CDATA[$000000 b on a.stt_rec = b.stt_rec'
	exec (@q)
end

select top 0 stt_rec, stt_rec0, line_nbr, ma_td1, ma_hd, ma_sp, ma_vv into #d from d]]>&ddTable;<![CDATA[$000000 b right join (select null as v) x on 1 = 0
select top 0 stt_rec, tk_no into #d2 from d]]>&ddTable;<![CDATA[$000000 b right join (select null as v) x on 1 = 0

set @q = ''
select @q = @q + 'insert into #d select stt_rec, stt_rec0, line_nbr, ma_td1, ma_hd, ma_sp, ma_vv
			from ' + ddyn + ' a where exists(select * from #m where stt_rec = a.stt_rec) and line_nbr = 1;'
from #m where ddyn <> '' group by ddyn
exec (@q)

set @q = ''
select @q = @q + 'insert into #d2 select stt_rec, tk_no
			from ' + ddyn + ' a where exists(select * from #m where stt_rec = a.stt_rec);'
from #m where ddyn <> '' group by ddyn
exec (@q)

SELECT 
		stt_rec,
		STUFF(
				(
						SELECT DISTINCT ', ' + rtrim(tk_no)
						FROM #d2 t2
						WHERE t2.stt_rec = t1.stt_rec
						FOR XML PATH(''), TYPE
				).value('.', 'NVARCHAR(MAX)')
		, 1, 2, '') AS list_tk_no
into #d2_group FROM #d2 t1
GROUP BY stt_rec;

update #m set d_ma_td1 = b.ma_td1, d_ma_hd = b.ma_hd, d_ma_sp = b.ma_sp, d_ma_vv = b.ma_vv from #m a join #d b on a.stt_rec = b.stt_rec
update #m set d_tk_no = b.list_tk_no from #m a join #d2_group b on a.stt_rec = b.stt_rec


select '' as array$, rtrim(a.d_ma_td1), rtrim(a.d_ma_hd), rtrim(d_ma_sp), rtrim(d_ma_vv), rtrim(d_tk_no) from #m a order by line_nbr
return
]]>
	</text>
</action>
