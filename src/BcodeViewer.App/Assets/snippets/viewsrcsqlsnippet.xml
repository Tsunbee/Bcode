		<Item keyword="ssRetrieveMultiGrid" description="Điều kiện lọc với stt_rec_ct">
			<![CDATA[declare @stt_rec_ct char(13) 
select @stt_rec_ct = data from #t where id = 5
if @stt_rec_ct <> '' 
	set @queryWhereClause = @queryWhereClause + ' and m.stt_rec = ''' + @stt_rec_ct + ''''
else begin
	declare @so_ct varchar(33)
	select @so_ct = data from #t where id = 6
	if @so_ct <> '' set @queryWhereClause = @queryWhereClause + ' and m.so_ct = ''' + dbo.ff_padL(ltrim(@so_ct), col_length('wrkgl', 'so_ct')) + ''''
end
{{-}}
			]]>
