<?xml version="1.0" encoding="UTF-8"?>
<config>
	<Hint>		
		<HintItem object='f' exact="1">
			<Item keyword="getItem" description="Lấy đối tượng trên form" varialble=""><![CDATA[getItem({{-}})]]></Item>
			<Item keyword="getItemValue" description="" varialble=""><![CDATA[getItemValue({{-}}]]></Item>
