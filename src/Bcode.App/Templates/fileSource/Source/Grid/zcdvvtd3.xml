<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY % SubTitleBalance SYSTEM "..\Include\SubTitleBalance.ent">
	%SubTitleBalance;
	<!ENTITY DowloadScript SYSTEM "..\Include\Javascript\DownloadScript.txt">
	<!ENTITY TransferID "zcdvvtd3">

	<!ENTITY FastBusiness.Encryption.Begin "">
	<!ENTITY CreateTicket "declare @ticket varchar(32)
select @ticket = lower(replace(newid(),'-',''))
insert into @@sysDatabaseName..ticket values(@ticket, @@userID, '&TransferID;', '', '', '@@appDatabaseName', getdate());">
	<!ENTITY FastBusiness.Encryption.End "">

	<!ENTITY % ExportImportTemplate SYSTEM "..\Include\ExportImportTemplate.ent">
	%ExportImportTemplate;
	<!ENTITY ExportImportTemplate.UploadController "controller=&TransferID;&amp;form=&TransferID;">

	<!ENTITY FilterCheckAccessUnit "(@@admin = 1 or exists(select 1 from sysunitrights r where r.user_id = @@userID and r.ma_dvcs = @@table.ma_dvcs and r.r_access=1))">
	<!ENTITY CommandWhenBalanceBeforeInit SYSTEM "..\Include\Command\WhenBalanceBeforeInit.txt">

	<!ENTITY % Tiny.External SYSTEM "..\Include\Tiny.External.ent">
	%Tiny.External;
	%Tiny.External.JobBalance;
]>
<grid table="zcdvvtd3_v" code="nam, ma_dvcs, tk, ma_vv, ma_td3, ma_kh, ma_hd" filter="&FilterCheckAccessUnit;" order="nam, ma_dvcs, tk, ma_vv, ma_td3, ma_kh, ma_hd" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Vào &Tiny.External.Title.v;" e="&Tiny.External.Title.e;"></title>
	<subTitle v="&SubTitleBalance.v;Cập nhật thông tin &Tiny.External.Title.v;..." e="&SubTitleBalance.e;&Tiny.External.Title.e;..."></subTitle>
	<fields>
		<field name="nam" isPrimaryKey="true" type="Decimal" width="60" hidden ="true" allowSorting="true" allowFilter="true" >
			<header v="Năm" e="Year"></header>
			<items style="Numeric"/>
		</field>
		<field name="ma_dvcs" isPrimaryKey="true" width="100" allowSorting="true" allowFilter="true" >
			<header v="Đơn vị" e="Unit"></header>
		</field>
		<field name="tk" isPrimaryKey="true" width="100" allowSorting="true" allowFilter="true">
			<header v="Tài khoản" e="Account"></header>
		</field>
		<field name="ma_vv" isPrimaryKey="true" width="100" allowSorting="true" allowFilter="true" >
			<header v="Mã vụ việc" e="Job"></header>
		</field>
		<field name="ten_vv%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên vụ việc" e="Job Name"></header>
		</field>
		<field name="ma_td3" isPrimaryKey="true" width="100" allowSorting="true" allowFilter="true" >
			<header v="Hạng mục" e="Item"></header>
		</field>
		<field name="ten_dtqt%l" width="300" allowSorting="true" allowFilter="true">
			<header v="Tên hạng mục" e="Item Name"></header>
		</field>
		<field name="ma_kh" isPrimaryKey="true" width="130"  allowSorting="true" allowFilter="true">
			<header v="Khách hàng" e="Customer"></header>
		</field>
		<field name="ten_kh%l"  width="180"  allowSorting="true" allowFilter="true">
			<header v="Tên khách hàng" e="Customer"></header>
		</field>
		<field name="ma_hd" isPrimaryKey="true" width="130"  allowSorting="true" allowFilter="true">
			<header v="Hợp đồng" e="Contract"></header>
		</field>
		<field name="ten_hd%l"  width="180"  allowSorting="true" allowFilter="true">
			<header v="Tên hợp đồng" e="Contract Name"></header>
		</field>
		
		<field name="du_no00" width="120" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="true" aggregate="Sum">
			<header v="Dư nợ" e="Debit Balance"></header>
			<items style="Numeric"/>
		</field>
		<field name="du_co00" width="120" type="Decimal" dataFormatString="@baseCurrencyAmountViewFormat" allowSorting="true" allowFilter="true" aggregate="Sum">
			<header v="Dư có" e="Credit Balance"></header>
			<items style="Numeric"/>
		</field>
		<field name="du_no_nt00" width="120" type="Decimal" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="true" aggregate="Sum">
			<header v="Dư nợ nt" e="FC Dr. Balance"></header>
			<items style="Numeric"/>
		</field>
		<field name="du_co_nt00" width="120" type="Decimal" dataFormatString="@foreignCurrencyAmountViewFormat" allowSorting="true" allowFilter="true" aggregate="Sum">
			<header v="Dư có nt" e="FC Cr. Balance"></header>
			<items style="Numeric"/>
		</field>
		
		<field name="datetime0" dataFormatString="dd/MM/yyyy hh:mm:ss" type="DateTime" aliasName="a" width="130" allowSorting="true" allowFilter="true">
			<header v="Ngày tạo" e="Description"></header>
		</field>
		<field name="user_id0" aliasName="a" width="100" allowSorting="true" allowFilter="true">
			<header v="ID người tạo" e="Description"></header>
		</field>
		<field name="ten_ng_tao" external="true" aliasName="vdmhdg.ten_ng_tao" defaultValue="''"  width="150" allowSorting="true" allowFilter="true">
			<header v="Tên người tạo" e="Description"></header>
		</field>
		<field name="datetime2" dataFormatString="dd/MM/yyyy hh:mm:ss" type="DateTime" aliasName="a" width="130" allowSorting="true" allowFilter="true">
			<header v="Ngày sửa" e="Description"></header>
		</field>
		<field name="user_id2" aliasName="a" width="100" allowSorting="true" allowFilter="true">
			<header v="ID người sửa" e="Description"></header>
		</field>
		<field name="ten_ng_sua" external="true" aliasName="vdmhdg.ten_ng_tao" defaultValue="''" width="150" allowSorting="true" allowFilter="true">
			<header v="Tên người sửa" e="Description"></header>
		</field>
		
	</fields>

	<views>
		<view id="Grid">
			<field name="nam"/>
			<field name="ma_dvcs"/>
			<field name="tk"/>
			<field name="ma_vv"/>
			<field name="ten_vv%l"/>
			<field name="ma_td3"/>
			<field name="ten_dtqt%l"/>
			<field name="ma_kh"/>
			<field name="ten_kh%l"/>
			<field name="ma_hd"/>
			<field name="ten_hd%l"/>
			<field name="du_no00"/>
			<field name="du_co00"/>
			<field name="du_no_nt00"/>
			<field name="du_co_nt00"/>
			<field name="datetime0" />
			<field name="user_id0" />
			<field name="ten_ng_tao" />
			<field name="datetime2" />
			<field name="user_id2" />
			<field name="ten_ng_sua" />
		</view>
	</views>

	<commands>
		&SubTitleBalanceShowing;
		<command event="Loading">
			<text>
				&CreateTicket;<![CDATA[
declare @message nvarchar(4000), @$lockedDate nvarchar(512)
select @message = 'this._authorize = ' + rtrim(@@sysDatabaseName.dbo.FastBusiness$System$GetAuthorize(@@admin, @@userID, 'zcdvvtd3', 'New')) + ';this._key = ''' + @ticket + ''';load$Grid(this);'
select @$lockedDate = case when @@language = 'v' then N'Đã khóa số liệu, kiểm tra lại ngày khóa sổ.' else N'Data is locked, you must modify system locked date.' end
if exists(select 1 from dmstt where year(ngay_ks) >= nam_bd) begin
	select 'this._denyNew = true;this._denyEdit = true;this._denyDelete = true;this._denyMessage=''' + @$lockedDate + '''; ' + @message as message
	return
end
if exists(select 1 from dmdvcsks where ma_dvcs = @@unit and year(ngay_ks) >= (select nam_bd from dmstt)) begin
	 select 'this._denyNew = true;this._denyEdit = true;this._denyDelete = true;this._denyMessage=''' + @$lockedDate + ''';' + @message as message
	return
end
#IF @@admin <> 1 #THEN
	if not exists(select 1 from sysunitrights where user_id = @@userID and ma_dvcs = @@unit and r_new = 1) begin
		select 'this._denyNew = true;' + @message as message
		return
	end
#END
select @message as message
return
]]>
			</text>
		</command>

		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$Grid(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
/* <flatten type="Javascript"> */
function load$Grid(g) {
	g.add_onResponseComplete(on$GridJobBalance$ResponseComplete);
	g.add_commandEvent(on$GridJobBalance$ExecuteCommand);
}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridJobBalance$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridJobBalance$ResponseComplete);} catch (ex) {}
}
/* </flatten> */
function on$GridJobBalance$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	switch (action) {
		case 'ImportData':
			show$Form(g, 'zcdvvtd3Import');
			break;
		case 'Download':
			]]>&UserDefinedDownload;<![CDATA[
			break;
		default:
			break;
	}
}
/* <flatten type="Javascript"> */
function on$GridJobBalance$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		case 'Download':
			g._key = result[0].Value;
			break;
		default:
			break;
	}
}
function show$Form(g, c) {
	(g._authorize == 1) && (!g._denyNew) ? g.showForm(c) : $message.show(g._denyMessage ? g._denyMessage : $df.getResources(g._language, "Message.NotAccess"));
}
/* </flatten> */
]]>
			&DowloadScript;
		</text>
	</script>

	<css>
		<text>
			<![CDATA[
div.ImportData{background-image:url(../images/Upload.png);background-repeat:no-repeat;background-position:0 0;}
div.Download{background-image:url(../Images/Download.png);background-repeat:no-repeat;background-position:0 0;}
div.ImportDataOverGreen, div.DownloadOverGreen{background-position:0 -22px;}
]]>
		</text>
	</css>

	<response>
		<action id="Download">
			<text>
				&CreateTicket;<![CDATA[
select @ticket as value
return
]]>
			</text>
		</action>
	</response>

	<toolbar>
		<button command="New">
			<title v="Toolbar.New" e="Toolbar.New"></title>
		</button>
		<button command="Edit">
			<title v="Toolbar.Edit" e="Toolbar.Edit"></title>
		</button>
		<button command="Delete">
			<title v="Toolbar.Delete" e="Toolbar.Delete"></title>
		</button>
		<button command="View">
			<title v="Toolbar.View" e="Toolbar.View"></title>
		</button>
		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"/>
		</button>

		<button command="-">
			<title v="-" e="-"/>
		</button>

		<button command="ImportData">
			<title v="Lấy dữ liệu từ tệp..." e="Import Data from File..."></title>
		</button>
		<button command="Download">
			<title v="Tải tệp mẫu..." e="Download Template File..."/>
		</button>

		<button command="Separate">
			<title v="-" e="-"/>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>
</grid>