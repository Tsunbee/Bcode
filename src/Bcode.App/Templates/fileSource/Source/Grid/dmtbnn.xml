		</field>
		<field name="lan" width="150" allowFilter="true" allowSorting="true" >
			<header v="Lần" e="Note"/>
		</field>
		<field name="ngay_gui" type="DateTime" dataFormatString="@datetimeFormat" width="100" allowFilter="true" allowSorting="true" >
			<header v="Ngày gửi CV/TB" e="Date"></header>
		</field>
		<field name="ngay_kt" type="DateTime" dataFormatString="@datetimeFormat" width="100" allowFilter="true" allowSorting="true" >
			<header v="Ngày kt CV/TB" e="Date"></header>
		</field>
			<field name="ma_vv" width="150" clientDefault="Default" allowFilter="true" allowSorting="true">
			<header v="Vụ việc" e="Job"></header>
		</field>
		<field name="ten_vv%l"  readOnly="true" external="true" defaultValue="''"  width="150" allowFilter="true" allowSorting="true" >
			<header v="Tên vụ việc" e=""></header>
		</field>
		
		<field name="ma_kh" allowNulls="false" width="150" allowFilter="true" allowSorting="true" >
			<header v="Mã khách" e="Customer"></header>
		</field>
		<field name="ten_kh%l" readOnly="true" external="true" defaultValue="''" width="150" allowFilter="true" allowSorting="true">
			<header v="Tên khách hàng" e=""></header>
		</field>
				<field name="so_tb" width="150" allowFilter="true" allowSorting="true">
			<header v="Số thông báo" e="Note"/>
		</field>
			<field name="ghi_chu"  width="150" allowFilter="true" allowSorting="true">
			<header v="Ghi chú" e="Note"/>
		</field>
		
		<field name="status"  align="right"  width="100" allowFilter="true" allowSorting="true">
			<header v="Trạng thái" e="Status"></header>
		</field>

	</fields>

	<views>
		<view id="Grid">
			<field name="so_ct"/>
			<field name="ma_hd"/>			<field name="ten_hd%l"/>
			<field name="dot"/>
			<field name="lan"/>
			<field name="ngay_gui"/>
			<field name="ngay_kt"/>
			<field name="ma_vv"/>
			<field name="ten_vv%l"/>
			<field name="ma_kh"/>
			<field name="so_tb"/>
			<field name="ghi_chu"/>
			<field name="status"/>

		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>			
				<![CDATA[			
select 'this._authorize = ' + rtrim(@@sysDatabaseName.dbo.FastBusiness$System$GetAuthorize(@@admin, @@userID, 'dmtbnn', 'New')) + ';load$Grid(this);' as message
return
]]>
			</text>
		</command>
		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$Grid(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
