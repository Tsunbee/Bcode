<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE dir [
	<!ENTITY XMLWhenFilterLoading SYSTEM "..\Include\XML\WhenFilterLoading.xml">
	<!ENTITY XMLWhenFilterClosing SYSTEM "..\Include\XML\WhenFilterClosing.xml">
	<!ENTITY OutlineCss SYSTEM "..\Include\Javascript\OutlineCss.txt">
	<!ENTITY OutlineEntry SYSTEM "..\Include\Javascript\OutlineEntry.txt">
	<!ENTITY OnSelectionOutline SYSTEM "..\Include\Javascript\OnSelectionOutline.txt">
	<!ENTITY JavascriptReportFilter SYSTEM "..\Include\Javascript\ReportFilter.txt">
	<!ENTITY ScriptQueryFilterString SYSTEM "..\Include\Javascript\QueryFilterString.txt">
	
	<!ENTITY Controller "rs_dmhd">
	<!ENTITY DynamicReportFields ",'&Controller;', '#$query', '@@sysDatabaseName'">
	<!ENTITY JavascriptReportFilter SYSTEM "..\Include\Javascript\ReportFilter.txt">
	<!ENTITY % ReferenceNumber SYSTEM "..\Include\ReferenceNumber.ent">
	%ReferenceNumber;

	<!ENTITY % Tiny.Currency SYSTEM "..\Include\Tiny.Currency.ent">
	%Tiny.Currency;
]>

<dir type="Report" id="1" cache="true" xmlns="urn:schemas-fast-com:data-dir">
	<title v="Điều kiện lọc" e="Filter Condition"></title>

	<fields>

		<field name="ma_hd">
			<header v="Hợp đồng" e="Contract"></header>
			<items style="AutoComplete" controller="Contract"  key="status = '1'"/>
		</field>
		<field name="ten_hd%l" readOnly="true" external="true" defaultValue="''" inactivate="true">
			<header v="" e=""></header>
		</field>
		
		<field name="nh_vv1">
			<header v="Nhóm vụ việc 1" e="Job Group 1"></header>
			<items style="Lookup" controller="JobGroup" key="status ='1' and loai_nh = 1"/>
		</field>
				<field name="nh_vv2">
			<header v="Nhóm vụ việc 2" e="Job Group 2"></header>
			<items style="Lookup" controller="JobGroup" key="status ='1' and loai_nh = 2"/>
		</field>
				<field name="nh_vv3">
			<header v="Nhóm vụ việc 3" e="Job Group 3"></header>
			<items style="Lookup" controller="JobGroup" key="status ='1' and loai_nh = 3"/>
		</field>
		<field name="loai_sp">
			<header v="Loại sản phẩm" e="Item type"></header>
			<items style="Lookup" controller="zdmloaisp" key="status='1'" check="1=1" reference="ten_loai_sp%l" information="loai_sp$zdmloaisp.ten_loai_sp%l"/>
		</field>
		<field name="kieu_sp">
			<header v="Kiểu sản phẩm" e="Item type"></header>
		<items style="Lookup" controller="zdmkieusp" key="status='1'" check="1=1" reference="ten_kieu_sp%l" information="kieu_sp$zdmkieusp.ten_kieu_sp%l"/>
		</field>
		<field name="nh_hd1">
			<header v="Nhóm 1" e="Group 1"></header>
			<items style="Lookup" controller="ContractGroup" key="status = '1' and loai_nh = 1"/>
		</field>
		<field name="nh_hd2">
			<header v="Nhóm 2" e="Group 2"></header>
			<items style="Lookup" controller="ContractGroup" key="status = '1' and loai_nh = 2"/>
		</field>
		<field name="nh_hd3">
			<header v="Nhóm 3" e="Group 3"></header>
			<items style="Lookup" controller="ContractGroup" key="status = '1' and loai_nh = 3"/>
		</field>
		<field name="ma_dvcs">
			<header v="Đơn vị" e="Unit"></header>
			<items style="Lookup" controller="Unit" key="status = '1'" check="1=1"/>
		</field>
	
	</fields>

	<views> 
		<view id="Dir">
			<item value="120, 20, 20, 60, 100, 130, 100, 0, 0"/>
			<item value="110000-: [ma_hd].Label, [ma_hd]"/>
			<item value="110000-: [nh_vv1].Label, [nh_vv1]"/>
			<item value="110000-: [nh_vv2].Label, [nh_vv2]"/>
			<item value="110000-: [nh_vv3].Label, [nh_vv3]"/>
			<item value="110000-: [loai_sp].Label, [loai_sp]"/>
			<item value="110000-: [kieu_sp].Label, [kieu_sp]"/>
			<item value="110000-: [nh_hd1].Label, [nh_hd1]"/>
			<item value="110000-: [nh_hd2].Label, [nh_hd2]"/>
			<item value="110000-: [nh_hd3].Label, [nh_hd3]"/>
			<item value="110000-: [ma_dvcs].Label, [ma_dvcs]"/>
			</view>  
	</views>

	<commands>
		&XMLWhenFilterLoading;
		&XMLWhenFilterClosing;
		
		<command event="Processing">
			<text>
				<![CDATA[
select @ma_hd as ma_hd
exec rs_dmhd  @ma_hd, @nh_vv1, @nh_vv2, @nh_vv3, @loai_sp, @kieu_sp, @nh_hd1, @nh_hd2, @nh_hd3,  '@@sysDatabaseName', @@language, @ma_dvcs, @@userID, @@admin
]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			&OutlineEntry;
			&JavascriptReportFilter; 
			&ScriptQueryFilterString;
			<![CDATA[
function active$VoucherFilter$(f) {
	f.add_onResponseComplete(on$Filter$ResponseComplete); 
	if (f._convection) f._convection = null;
	else {
		changeLookupReadonly(f, 'ma_hd');
		changeLookupReadonly(f, 'nh_vv1');
		changeLookupReadonly(f, 'nh_vv2');
		changeLookupReadonly(f, 'nh_vv3');
		changeLookupReadonly(f, 'loai_sp');
		changeLookupReadonly(f, 'kieu_sp');
		changeLookupReadonly(f, 'nh_hd1');
		changeLookupReadonly(f, 'nh_hd2');
		changeLookupReadonly(f, 'nh_hd3');
		changeLookupReadonly(f, 'ma_dvcs');

		var o = f.getItem('maxLength');
		o.value = o.maxLength;
	}
	
}
function close$VoucherFilter$(f) {
	try {f.remove_onResponseComplete(on$Filter$ResponseComplete);} catch (ex) {}
}
function on$Filter$ResponseComplete(sender, e) {
		var f = e.object, context = e.type.Context, result = e.type.Result;
		switch (context) {
			case 'Checking':
					var g = f.grid;
					g._hiddenForms = [];
					g._alterTitle = [null, [['%s1', f.getItem('ma_hd').value, true]]];
					g._queryFilterString = getQueryFilterString(f, 'ma_hd');
				default:
						break;
		}
}
]]>
		</text>
	</script>

	&OutlineCss;
</dir>