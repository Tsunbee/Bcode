<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLWhenReportLoading SYSTEM "..\Include\XML\WhenReportLoading.xml">
	<!ENTITY XMLWhenReportClosing SYSTEM "..\Include\XML\WhenReportClosing.xml">
	<!ENTITY XMLStandardReportToolbar SYSTEM "..\Include\XML\StandardReportToolbar.xml">
	<!ENTITY JavascriptReportInit SYSTEM "..\Include\Javascript\ReportInit.txt">
	<!ENTITY % Control.Filter SYSTEM "..\Include\Filter.ent">
	%Control.Filter;
]>

<grid type="Report" valid="systotal = 1" filter="" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Báo cáo xuất nhập tồn theo đơn hàng, mã hàng" e="Inventory report by order and item code"></title>
	<subTitle v="Từ ngày %s1 đến ngày %s2" e="From Date %s1 to %s2"></subTitle>
	
	<fields>
		<field name="ma_kh" width="100" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Khách hàng" e="Customer"></header>
		</field>
		<field name="ten_kh" width="250" allowSorting="true" allowFilter="true">
			<header v="Tên khách hàng" e="Customer Name"></header>
		</field>
		<field name="ma_vt" width="100" dataFormatString="@upperCaseFormat" allowSorting="true" allowFilter="true">
			<header v="Mã cty" e="Item"></header>
		</field>
		<field name="ten_vt" width="250" allowSorting="true" allowFilter="true">
			<header v="Tên sản phẩm" e="Item Name"></header>
		</field>
		<field name="ke_hoach_dong_goi" width="100" allowSorting="true" allowFilter="true">
			<header v="Chi tiết" e="Detail"></header>
		</field>
		
		<field name="sl_total_don_hang" width="100" type="Decimal" dataFormatString="### ### ### ##0" aggregate="Sum" allowSorting="true" allowFilter="true" 
			hyperlinkFormatString="~/AppHandler/View.ashx Query: {Page: 'zquery_zrpt_282TotalSO', Controller: 'zrpt_282', Name: '[ma_vt]', Value: ' \'1\' + String.fromCharCode(253) + [ma_vt] + String.fromCharCode(253) + [ma_kh] + this._queryFilterString'}, Script: 'beforeDrillDownWithCondition(this);'">
			<header v="Total Đơn hàng" e="Total Orders"></header>
		</field>
		<field name="sl_total_xuat" width="100" type="Decimal" dataFormatString="### ### ### ##0" aggregate="Sum" allowSorting="true" allowFilter="true"
			hyperlinkFormatString="~/AppHandler/View.ashx Query: {Page: 'zquery_zrpt_282TotalSO', Controller: 'zrpt_282', Name: '[ma_vt]', Value: ' \'2\' + String.fromCharCode(253) + [ma_vt] + String.fromCharCode(253) + [ma_kh] + this._queryFilterString'}, Script: 'beforeDrillDownWithCondition(this);'">>
			<header v="Total xuất" e="Total output"></header>
		</field>
		<field name="sl_total_ton" width="100" type="Decimal" dataFormatString="### ### ### ##0" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Total tồn" e="Total Stock"></header>
		</field>
		<field name="sl_du_kien_xuat" width="100" type="Decimal" dataFormatString="### ### ### ##0" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Số lượng dự kiến xuất" e="Estimated export quantity"></header>
		</field>
		<field name="sl_ton_sau_dk" width="100" type="Decimal" dataFormatString="### ### ### ##0" aggregate="Sum" allowSorting="true" allowFilter="true">
			<header v="Tồn sau dự kiến" e="Expected inventory"></header>
		</field>
		
		<field name="so_ct" width="100" allowSorting="true" allowFilter="true" align="right">
			<header v="Số đơn hàng" e="No. Salesorder"></header>
		</field>
		<field name="ngay_ct" width="100" allowSorting="true" allowFilter="true">
			<header v="Ngày đơn hàng" e="Salesorder Date"></header>
		</field>
		
		<field name="systotal" width="0" hidden="true" inactivate="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
<!--			<field name="so_ct"/>
			<field name="ngay_ct"/>-->
			<field name="ma_kh"/>
			<field name="ten_kh"/>
			<field name="ma_vt"/>
			<field name="ten_vt"/>
			<field name="ke_hoach_dong_goi"/>
			<field name="sl_total_don_hang"/>
			<field name="sl_total_xuat"/>
			<field name="sl_total_ton"/>
			<field name="sl_du_kien_xuat"/>
			<field name="sl_ton_sau_dk"/>
			
			<field name="systotal"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
		  <text>
			<![CDATA[select 'load$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
		<command event="Closing">
		  <text>
			<![CDATA[select 'dispose$GridReport$(this);' as message
	return]]>
		  </text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[
function load$GridReport$(g) {g.add_onRender(on$GridReport$Render);}
function dispose$GridReport$(g) {try {g.remove_onRender(on$GridReport$Render);} catch (ex) {}}
function on$GridReport$Render(sender, eventArgs) {
	var g = eventArgs.grid;  
	if (g._hiddenFields) {    
		var a = g._hiddenFields, h = '';
		for (var i = 0; i < a.length; i++) {
			setGridHiddenFields(g, a[i].Fields, a[i].Value);
			if (a[i].Value) h += (h == '' ? '' : ',') + a[i].Fields;
		}
		g._externalHiddenFields = h;
	}
}
function setGridHiddenFields(g, c, v) {
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var l = g._getColumnOrder($func.trim(a[i]));
		if (l != -1) g._setColumnVisible(l, !v);
	}
}
function beforeDrillDown(g) {g._args.cancelEvent = !($func.trim(g._getItemValue(g._activeRow, g._activeColumn)));}
function formatDateView(c) {return String.format('{0}/{1}/{2}', c.substring(6, 8), c.substring(4, 6), c.substring(0, 4));}
function beforeDrillDownWithCondition(g) {g._args.cancelEvent = !(g._getItemValue(g._activeRow, g._getColumnOrder('systotal')) == 1);}
]]>
		</text>
	</script>
	
	&XMLStandardReportToolbar;
</grid>