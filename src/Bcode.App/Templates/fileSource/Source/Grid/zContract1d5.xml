<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLStandardDetailToolbar SYSTEM "..\Include\XML\StandardDetailToolbar.xml">

	<!ENTITY % Extra SYSTEM "..\Include\Extra\Extra.ent">
	%Extra;
	<!ENTITY % Clipboard.List SYSTEM "..\Include\Clipboard\Clipboard.List">
	%Clipboard.List;
	<!ENTITY % Clipboard SYSTEM "..\Include\Clipboard\Clipboard.ent">
	%Clipboard;
]>

<grid table="zdmhd5" type="Detail" code="ma_hd" order="ma_hd, line_nbr" xmlns="urn:schemas-fast-com:data-grid">
	<title v="" e=""></title>
	<subTitle v="" e=""></subTitle>

	<fields>
		<field name="ma_loai_bl" allowNulls="false" width="100" aliasName="a">
			<header v="Mã loại bảo lãnh" e=""></header>
			<items style="AutoComplete" controller="zdmlbl" reference="ten_loai_bl%l" key="status = '1'" check="1 = 1" information="ma_loai_bl$zdmlbl.ten_loai_bl%l" new="Default"/>
		</field>
		<field name="ten_loai_bl%l" readOnly="true" external="true" defaultValue="''" inactivate="true" width="200" aliasName="b">
			<header v="Loại bảo lãnh" e=""></header>
		</field>
		<field name="ma_lan" allowNulls="false" width="100" aliasName="a">
			<header v="Mã số lần phát hành BL" e=""></header>
			<items style="AutoComplete" controller="zdmslpbl" reference="ten_lan%l" key="status = '1'" check="1 = 1" information="ma_lan$zdmslpbl.ten_lan%l" new="Default"/>
		</field>
		<field name="ten_lan%l" readOnly="true" external="true" defaultValue="''" inactivate="true" width="200" aliasName="c">
			<header v="Số lần phát hành BL" e=""></header>
		</field>
		<field name="ngan_hang_phat_hanh" allowNulls="false" width="200" aliasName="a">
			<header v="Ngân hàng phát hành" e=""></header>
		</field>
		<field name="so_chung_thu" allowNulls="false" width="100" aliasName="a">
			<header v="Số chứng thư" e="P"></header>
		</field>
		<field name="gia_tri_bao_lanh" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0">
			<header v="Giá trị bảo lãnh" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="ngay_phat_hanh" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100">
			<header v="Ngày phát hành" e=""></header>
		</field>
		<field name="ngay_hh_bao_lanh" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100">
			<header v="Ngày hết hạn bảo lãnh" e=""></header>
		</field>
		<field name="ngay_hh_hop_dong" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100">
			<header v="Ngày hết hạn hợp đồng" e=""></header>
		</field>
		<field name="tg_toi_thieu_gia_han" type="Decimal" dataFormatString="### ### ### ##0" width="100" clientDefault="0">
			<header v="Thời gian tối thiểu phải gia hạn theo TP THƯ BẢO LÃNH (ngày)" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="nguoi_phu_trach" width="200" aliasName="a">
			<header v="Người phụ trách (P. Dự toán)" e=""></header>
		</field>
		<field name="ma_ghi_chu" width="100" aliasName="a">
			<header v="Mã ghi chú" e=""></header>
			<items style="AutoComplete" controller="zdmldgcblhd" reference="ten_ghi_chu%l" key="status = '1'" check="1 = 1" information="ma_ghi_chu$zdmldgcblhd.ten_ghi_chu%l" new="Default"/>
		</field>
		<field name="ten_ghi_chu%l" readOnly="true" external="true" defaultValue="''" inactivate="true" width="300" aliasName="d">
			<header v="Ghi chú" e=""></header>
		</field>
		<field name="phan_hoi_qlxd" width="300" aliasName="a">
			<header v="Phản hồi khối QLXD" e=""></header>
		</field>
		<field name="nhan_ngay" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100">
			<header v="Nhận ngày" e=""></header>
		</field>
		
		<field name="line_nbr" type="Int32" isPrimaryKey="true" width="0" align="right" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ma_loai_bl"/>
			<field name="ten_loai_bl%l"/>
			<field name="ma_lan"/>
			<field name="ten_lan%l"/>
			<field name="ngan_hang_phat_hanh"/>
			<field name="so_chung_thu"/>
			<field name="gia_tri_bao_lanh"/>
			<field name="ngay_phat_hanh"/>
			<field name="ngay_hh_bao_lanh"/>
			<field name="ngay_hh_hop_dong"/>
			<field name="tg_toi_thieu_gia_han"/>
			<field name="nguoi_phu_trach"/>
			<field name="ma_ghi_chu"/>
			<field name="ten_ghi_chu%l"/>
			<field name="phan_hoi_qlxd"/>
			<field name="nhan_ngay"/>
			<field name="line_nbr"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>
				<![CDATA[
select 'load$GridDetail$d5(this);]]>&Clipboard.Loading;<![CDATA[' as message
return]]>
			</text>
		</command>
		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$GridDetail$d5(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[/* <flatten type="Javascript"> */
function load$GridDetail$d5(g) {
	g.add_commandEvent(on$GridDetail$d5$ExecuteCommand);
}
function dispose$GridDetail$d5(g) {
	try {g.remove_commandEvent(on$GridDetail$d5$ExecuteCommand);} catch (ex) {}
}
/* </flatten> */
function on$GridDetail$d5$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender, f = g.get_element().parentForm;
	switch (action) {
		]]>&Clipboard.Event.Before;<![CDATA[
		]]>&Clipboard.Event.Before.Request;<![CDATA[
		]]>&Clipboard.Event.Before.Process;<![CDATA[
		]]>&Clipboard.Event.After;<![CDATA[
		]]>&Clipboard.Event.After.Process;<![CDATA[
		]]>&GridExtraToolbarExecuteCommandScript;<![CDATA[
		default:
			break;
	}
}
]]>
			&GridExtraToolbarScript;
		</text>
	</script>

	<css>
		<text>
			&GridExtraToolbarCss;
		</text>
	</css>

	<toolbar>
		<button command="Insert">
			<title v="Toolbar.Insert" e="Toolbar.Insert"></title>
		</button>
		<button command="Grow">
			<title v="Toolbar.Grow" e="Toolbar.Grow"></title>
		</button>
		<button command="Down">
			<title v="Toolbar.Down" e="Toolbar.Down"></title>
		</button>
		<button command="Clone">
			<title v="Toolbar.Clone" e="Toolbar.Clone"></title>
		</button>
		<button command="Remove">
			<title v="Toolbar.Remove" e="Toolbar.Remove"></title>
		</button>

		<button command="Export">
			<title v="Toolbar.Export" e="Toolbar.Export"></title>
		</button>
		&GridExtraToolbar;

		<button command="-">
			<title v="-" e="-"/>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>

	<queries>
		<query event="Loading">
			<text>
				<![CDATA[
select @@fieldExternal from @@table a left join zdmlbl b on a.ma_loai_bl = b.ma_loai_bl left join zdmslpbl c on a.ma_lan = c.ma_lan left join zdmldgcblhd d on a.ma_ghi_chu = d.ma_ghi_chu where @@whereClause order by @@orderByClause
]]>
			</text>
		</query>
	</queries>
</grid>