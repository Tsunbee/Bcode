<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Chỉ để có System.Windows.Automation (UIAutomationClient — Host/BrowserTabLauncher.Uia.cs: F5 tìm lại tab trong Chrome / Edge
         đang mở của người dùng). Không dùng XAML / cửa sổ WPF. -->
    <UseWPF>true</UseWPF>
    <!-- UseWPF bỏ 2 using ngầm định này (tránh trùng tên với WPF) — code WinForms sẵn có vẫn dựa vào chúng. -->
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BcodeViewer.App</RootNamespace>
    <AssemblyName>BcodeViewer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Mỗi màn 1 DPI (như Bcode): WebView2 nét trên màn phụ khác DPI; form WinForms kế thừa UI/DpiForm. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Hiện trong tab Details khi bấm chuột phải vào BcodeViewer.exe, và cũng là nguồn
         cho hộp "Giới thiệu" trong app (xem MainForm.ShowAbout): khai một nơi, đọc hai
         chỗ, nên không thể lệch nhau. -->
    <Product>BcodeViewer</Product>
    <Authors>PhongNT|HaoTN</Authors>
    <Company>PhongNT|HaoTN</Company>
    <Description>IDE FBO</Description>
    <Copyright>© PhongNT|HaoTN. Phần mềm độc quyền. Cấm sao chép, phân phối lại hoặc dịch ngược (decompile/reverse-engineer) khi chưa được phép bằng văn bản.</Copyright>
    <Trademark>BcodeViewer™</Trademark>
    <Version>1.0.0</Version>
    <!-- Cập nhật BcodeViewer (Shared/AppUpdate.cs, cơ chế riêng — không đi theo Bcode): thư mục phát hành mặc định của RIÊNG Viewer
         (người phát hành: tools\publish-release.ps1 -App Viewer -Dest <thư mục này>). Mỗi máy đổi được ở Help → Cập nhật BcodeViewer → Đổi…
         KHÔNG trùng thư mục phát hành của Bcode. -->
    <BcodeReleaseFolder>\\172.168.5.17\Users\HAOTN\Bcode\Bcodeviewer</BcodeReleaseFolder>
    <!-- "Có gì mới" + commit trong bcode-version.json chỉ tính commit đụng tới Viewer (pathspec git, tính từ thư mục project) — Shared/Release.targets. -->
    <BcodeStampPaths>. ../Shared ../Bcode.Core</BcodeStampPaths>
  </PropertyGroup>
  <!-- Dấu tĩnh truy nguồn (tools/bcode-mark): GUID bộ Bcode nhúng cố định vào metadata assembly để nhận ra bản sao chép nhị phân. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BcodeMark</_Parameter1>
      <_Parameter2>b3c0de00-0000-4bee-b3c0-deb3c0deb3c0 | BcodeMark v1</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BcodeReleaseFolder</_Parameter1>
      <_Parameter2>$(BcodeReleaseFolder)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Lõi dùng chung (mục 1): WatermarkService — để BcodeViewer cũng mang dấu bí mật như Bcode. Tham chiếu, không chép. -->
  <ItemGroup>
    <ProjectReference Include="..\Bcode.Core\Bcode.Core.csproj" />
  </ItemGroup>
  <!-- Key gốc bản quyền ở Secrets/LocalSecrets.cs (gitignore) — chỉ dùng làm "muối" cho thuỷ ấn; thiếu file thì dùng bản rỗng (Viewer không có dấu bí mật). -->
  <ItemGroup>
    <Compile Include="..\Bcode.App\Secrets\LocalSecrets.cs" Link="Shared\LocalSecrets.cs" Condition="Exists('..\Bcode.App\Secrets\LocalSecrets.cs')" />
    <Compile Include="..\Bcode.App\Secrets\LocalSecrets.Empty.cs" Link="Shared\LocalSecrets.cs" Condition="!Exists('..\Bcode.App\Secrets\LocalSecrets.cs')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <!-- Code nhúng claude.ai / gemini.google.com dùng chung với Bcode.App (xem Shared/AiWebHelper.cs) — link, không chép. -->
    <Compile Include="..\Shared\AiWebHelper.cs" Link="Shared\AiWebHelper.cs" />
    <!-- Giải mật khẩu DPAPI trong settings.json của Bcode + mã hoá key / mật khẩu của viewer-settings.json — dùng chung với Bcode.App. -->
    <Compile Include="..\Shared\DpapiText.cs" Link="Shared\DpapiText.cs" />
    <!-- Alt+Tab quay lại thì trả focus / con trỏ về chỗ cũ (WebView2 không tự làm) — dùng chung với Bcode.App. -->
    <Compile Include="..\Shared\AppSwitchFocus.cs" Link="Shared\AppSwitchFocus.cs" />
    <!-- Giao thức pipe liên-tiến-trình có phiên bản (Bcode ↔ BcodeViewer) — Shared/PipeProtocol.cs, link vào cả hai. -->
    <Compile Include="..\Shared\PipeProtocol.cs" Link="Shared\PipeProtocol.cs" />
    <!-- Cập nhật bản mới — cùng lõi với Bcode.App (kiểm tra / tải trước / cài / quay lại + xử lý hộp update.html), thư mục phát hành riêng. -->
    <Compile Include="..\Shared\AppUpdate.cs" Link="Shared\AppUpdate.cs" />
    <Compile Include="..\Shared\AppUpdateDialog.cs" Link="Shared\AppUpdateDialog.cs" />
    <Compile Include="..\Shared\AppUpdateToast.cs" Link="Shared\AppUpdateToast.cs" />
    <Compile Include="..\Shared\AppUpdateForm.cs" Link="Shared\AppUpdateForm.cs" />
    <!-- SQL IntelliSense only (table/column names — see Host/SqlSchemaService). BcodeViewer
         reuses the workspace Bcode.App already stores in %AppData%\Bcode\settings.json
         rather than referencing Bcode.App, which would drag its whole WinForms/ClosedXML
         surface into a standalone editor for two SELECTs. Same package version Bcode.App
         pins, so a machine with both installed doesn't end up with two native SNI copies. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The whole Web/ folder (index.html, editor.js, chat.js, style.css, vendored
         monaco-editor/min/vs) ships next to the exe so WebView2 can load it via a
         file:// path with no build step and no internet access needed at runtime. -->
    <None Include="Web\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Hộp "Cập nhật BcodeViewer" (Shared/AppUpdateForm.cs): CHÍNH trang update.html + shell.css/dialog.css của Bcode — link, không chép. -->
    <None Include="..\Bcode.App\Web\Shell\update.html;..\Bcode.App\Web\Shell\shell.css;..\Bcode.App\Web\Shell\dialog.css" LinkBase="Web\update" CopyToOutputDirectory="PreserveNewest" />
    <!-- ApplicationIcon alone only sets the .exe file's own icon (Explorer/taskbar
         pinning) — the running window's titlebar icon needs Form.Icon set explicitly
         at runtime (see MainForm's constructor), which needs the file alongside the exe. -->
    <None Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bộ snippet FCode (sql/js/html/css) — đọc lúc chạy bởi Settings/FcodeXmlSnippets. -->
    <None Include="Assets\snippets\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ma trận ghost text Fast + kho Hỏi Fast đi kèm (Host/FastSource) — rút từ Bcode.App\Templates\fileSource (công khai) bằng công cụ đo; kiến thức học từ source Fast / dự án nằm ở thư mục kiến thức, không ở đây. -->
    <None Include="Assets\fastsource\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Định nghĩa thuộc tính field của Fast (Note thuộc tính field — Settings/FieldNoteStore, Web/fieldnotes.js): soạn từ thống kê source Fast + form khai field của FCode. -->
    <None Include="Assets\fieldnotes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Từ điển field FCode (gợi ý "f.ma_kh" + Enter — Settings/FcodeFieldDictionary) dùng chung với Bcode.App — link, không chép. -->
    <None Include="..\Bcode.App\Templates\fileSource\header.xml" Link="Assets\fields\header.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Từ có sẵn của Từ điển dịch (Settings/TranslateDictionary) — cùng file HeaderTranslator của Bcode dùng; link, không chép. -->
    <None Include="..\Bcode.App\Templates\HeaderDictionary.json" Link="Assets\fields\HeaderDictionary.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- bcode-version.json / bcode-changelog.txt / bcode-manifest.json cạnh BcodeViewer.exe cho cơ chế cập nhật — dùng chung với Bcode.App. -->
  <Import Project="..\Shared\Release.targets" />
</Project>
