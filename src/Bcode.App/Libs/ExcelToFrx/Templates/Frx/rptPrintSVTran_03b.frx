    <Parameter Name="f_gia2" DataType="System.String" Expression="IIf([isFC] == 0,[d1.gia2],[d1.gia_nt2])"/>
    <Parameter Name="f_ten_kh" DataType="System.String" Expression="[d1.ten_kh]"/>
    <Parameter Name="f_thanh_toan" DataType="System.String" Expression="IIf([cLan] == &quot;V&quot;,[d1.thanh_toan], [d1.thanh_toan2])"/>
    <Parameter Name="f_company" DataType="System.String" Expression="Switch([companyLine].Trim() == &quot;1&quot;, [Entity_Line1],[companyLine].Trim() == &quot;2&quot;, [Entity_Line2], [companyLine].Trim() == &quot;3&quot;, [Entity_Line3], [companyLine].Trim() == &quot;4&quot;, [Entity_Line4],[companyLine].Trim() == &quot;5&quot;, [Entity_Line5], true, &quot;&quot;)"/>
    <Parameter Name="f_mau_so" DataType="System.String" Expression="IIf([d1.ky_hieu] == &quot;&quot;, [h_mau_so], [h_mau_so2] + [d1.ky_hieu])"/>
    <Parameter Name="f_address" DataType="System.String" Expression="IIf([addressLine].Trim() == &quot;1&quot;, [Entity_Line1], IIf([addressLine].Trim() == &quot;2&quot;, [Entity_Line2], IIf([addressLine].Trim() == &quot;3&quot;, [Entity_Line3], IIf([addressLine].Trim() == &quot;4&quot;, [Entity_Line4], IIf([addressLine].Trim() == &quot;5&quot;, [Entity_Line5], &quot;&quot;)))))"/>
    <Parameter Name="f_companyTaxCode" DataType="System.String" Expression="Replace([companyTaxCode], &quot;-&quot;,&quot;&quot;)"/>
    <Parameter Name="f_companyTaxCodeCus" DataType="System.String" Expression="Replace([d1.ma_so_thue], &quot;-&quot;,&quot;&quot;)"/>
    <Parameter Name="f_thue" DataType="System.String" Expression="IIf([isFC] == 0,[d1.thue],[d1.thue_nt])"/>
    <Parameter Name="f_h_khong_thue" DataType="System.String" Expression="&quot;/&quot;"/>
    <Parameter Name="f_t_khong_thue" DataType="System.String" Expression="IIf([isFC] == 0,[d1.tien_99],[d1.tien_nt_99])"/>
    <Parameter Name="f_t_tien_hang0" DataType="System.String" Expression="IIf([isFC] == 0,[d1.tien_0],[d1.tien_nt_0])"/>
    <Parameter Name="f_t_tien_hang5" DataType="System.String" Expression="IIf([isFC] == 0,[d1.tien_5],[d1.tien_nt_5])"/>
    <Parameter Name="f_t_tien_hang10" DataType="System.String" Expression="IIf([isFC] == 0,[d1.tien_10],[d1.tien_nt_10])"/>
    <Parameter Name="f_t_tien_thue_gtgt0" DataType="System.String" Expression="IIf([isFC] == 0,[d1.thue_0],[d1.thue_nt_0])"/>
    <Parameter Name="f_t_tien_thue_gtgt5" DataType="System.String" Expression="IIf([isFC] == 0,[d1.thue_5],[d1.thue_nt_5])"/>
    <Parameter Name="f_t_tien_thue_gtgt10" DataType="System.String" Expression="IIf([isFC] == 0,[d1.thue_10],[d1.thue_nt_10])"/>
    <Parameter Name="f_t_tien_khong_thue" DataType="System.String" Expression="0"/>
    <Parameter Name="f_t_tien_thue_gtgt8" DataType="System.String" Expression="IIf([isFC] == 0,[d1.thue_8],[d1.thue_nt_8])"/>
    <Parameter Name="f_t_tien_hang8" DataType="System.String" Expression="IIf([isFC] == 0,[d1.tien_8],[d1.tien_nt_8])"/>
