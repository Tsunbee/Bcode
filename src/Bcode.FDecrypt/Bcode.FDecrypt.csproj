<Project Sdk="Microsoft.NET.Sdk">

  <!-- Giải mã file controller .f của Fast (khối <Encrypted>) cho Sơ đồ phụ thuộc / File Lookup.
       EXE RIÊNG, chạy tiến trình tách: gọi engine SẠCH Bcode.FSystem.dll (viết lại từ fsystem, tự chứa) — KHÔNG nạp fsystem.dll
       cài sẵn, KHÔNG đọc license %windir%\<máy>.c. Chạy tách để lỗi/treo của engine không làm sập Bcode và giữ nguyên giao thức
       với Sơ đồ phụ thuộc. Khoá (hashKey 391 ký tự) Bcode truyền vào qua STDIN (không hiện ở dòng lệnh).

       net48: Bcode.FSystem là net48 (có Microsoft.VisualBasic trong GAC). Không còn cần WMI/System.Management hay chạy 32-bit
       (trước đây x86 là vì fsystem kiểm license theo ngày tạo System32 — nay bỏ hẳn license). Giữ net48 để build kèm Bcode.App
       như cũ (target CopyFDecrypt chép từ bin\<Config>\net48). .NET Framework 4.8 có sẵn trên mọi Windows 10/11. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Bcode.FDecrypt</AssemblyName>
    <RootNamespace>Bcode.FDecrypt</RootNamespace>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bcode.FSystem\Bcode.FSystem.csproj" />
  </ItemGroup>

</Project>
