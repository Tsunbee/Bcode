<grid table="vdmtbnn" code="so_ct, ma_hd" order="so_ct, ma_hd" filter="&UnitFilter;" initialize="&UnitQuery;" xmlns="urn:schemas-fast-com:data-grid">
	<title v="Danh mục nhắc thông báo nợ" e="Product Category List"></title>
	<subTitle v="Cập nhật: Thêm, sửa, xóa" e="Input: New, Edit, Delete"></subTitle>
	<fields>
		<field name="so_ct"  isPrimaryKey="true" width="100" align="right" allowFilter="true" allowSorting="true" >
			<header v="Mã thông báo" e=""></header>
		</field>
		<field name="ma_hd" isPrimaryKey="true" width="100" allowFilter="true" allowSorting="true">			<header v="Mã hợp đồng" e="Code"></header>		</field>		<field name="ten_hd%l" external="true" defaultValue="''" width="250" allowFilter="true" allowSorting="true">			<header v="Tên hợp đồng" e="Description"></header>		</field>			<field name="dot" width="150" allowFilter="true" allowSorting="true">
