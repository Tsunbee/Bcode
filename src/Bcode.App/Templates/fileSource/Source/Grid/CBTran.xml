	<script>
		<text>
			<![CDATA[
function load$Grid(g) {
	g.add_onResponseComplete(on$GridBankCreditAdvice$ResponseComplete);
	g.add_commandEvent(on$GridBankCreditAdvice$ExecuteCommand);

}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridBankCreditAdvice$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridBankCreditAdvice$ResponseComplete);} catch (ex) {}

}
function on$GridBankCreditAdvice$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	switch (action) {
		case 'ImportData':
			show$Form(g, 'CBMasterImport');
			break;
		case 'Download':
			]]>&UserDefinedDownload;<![CDATA[
			break;
		case 'TradingNotes':
			var r = g._activeRow;
			if (r == -1) break;
			g.showForm('zTradingNotes');
			break;
		default:
			break;
	}
}
function on$GridBankCreditAdvice$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		case 'Download':
			g._key = result[0].Value;
			break;
		default:
			break;
	}
}

function show$Form(g, c) {(g._authorize == 1) && (!g._denyNew) ? g.showForm(c) : $message.show(g._denyMessage ? g._denyMessage : $df.getResources(g._language, "Message.NotAccess"));}
]]>
			&DowloadScript;
			&PrintRightScript;
			&FlowMultiScript;
			&VisibleFieldScript;
		</text>
	</script>

