		<Item keyword="fnSetEmptyValueFunc" description="Gán trường trắng">
			<![CDATA[function setFieldsEmpty(f, c, v){
	var a = c.split(',');
	for (var i = 0; i < a.length; i++) {
		var o = f.getItem($func.trim(a[i]));
		if(!v) {
			switch (o.field.Type) {
				case 'DateTime':
					f.setItemValue($func.trim(a[i]), null);
					break;
				case 'Boolean':
					f.setItemValue($func.trim(a[i]), false);
					break;
				case 'String':
					o.value = '';
					break;
				default:
					break;
			}
		}
	}
}
