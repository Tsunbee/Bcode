	<script>
		<text>
			<![CDATA[
function load$Grid(g) {
	g.add_onResponseComplete(on$GridBankDebitAdvice$ResponseComplete);
	g.add_commandEvent(on$GridBankDebitAdvice$ExecuteCommand);

}
function dispose$Grid(g) {
	try {g.remove_commandEvent(on$GridBankDebitAdvice$ExecuteCommand);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridBankDebitAdvice$ResponseComplete);} catch (ex) {}

}
function on$GridBankDebitAdvice$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender;
	switch (action) {
		case 'ImportData':
			show$Form(g, 'CPMasterImport');
			break;
		case 'Download':
			]]>&UserDefinedDownload;<![CDATA[
			break;
		]]>&APVHistoryExecute;<![CDATA[
		]]>&GNEditExecute;<![CDATA[
		default:
			break;
	}
}

function on$GridBankDebitAdvice$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object;
	switch (context) {
		case 'Download':
			g._key = result[0].Value;
			break;
		]]>&APVHistoryResponse;<![CDATA[

		default:
			break;
	}
}

function show$Form(g, c) {(g._authorize == 1) && (!g._denyNew) ? g.showForm(c) : $message.show(g._denyMessage ? g._denyMessage : $df.getResources(g._language, "Message.NotAccess"));}
]]>
