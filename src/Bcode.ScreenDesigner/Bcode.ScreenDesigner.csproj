<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bcode.ScreenDesigner</RootNamespace>
    <AssemblyName>BcodeScreenDesigner</AssemblyName>
    <ApplicationIcon>designer.ico</ApplicationIcon>
    <Product>Bcode Screen Designer</Product>
    <Authors>HaoTN</Authors>
    <Description>Thiết kế màn hình FastBusiness (Dir / Grid / Filter) bằng kéo thả, xuất ảnh dán vào tài liệu khảo sát.</Description>
    <Version>1.0.0</Version>
    <!-- Cập nhật Screen Designer — cơ chế RIÊNG (Shared/AppUpdate.cs), không đi theo Bcode dù Designer nằm trong thư mục ScreenDesigner\ của Bcode
         (bản cập nhật của Bcode bỏ qua thư mục đó). Người phát hành: tools\publish-release.ps1 -App Designer -Dest <thư mục này>.
         Mỗi máy đổi được ở nút "⬆ Cập nhật" → Đổi… KHÔNG trùng thư mục phát hành của Bcode / BcodeViewer. -->
    <BcodeReleaseFolder>\\172.168.5.17\Users\HAOTN\BcodeScreenDesigner</BcodeReleaseFolder>
    <!-- "Có gì mới" + commit chỉ tính commit đụng tới Designer + file dùng lại của Viewer (pathspec git) — Shared/Release.targets. -->
    <BcodeStampPaths>. ../Shared ../BcodeViewer.App/Web/dirpreview.js ../BcodeViewer.App/Web/entity.js ../BcodeViewer.App/Web/hostcall.js ../BcodeViewer.App/Host/IncludeTree.cs</BcodeStampPaths>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BcodeReleaseFolder</_Parameter1>
      <_Parameter2>$(BcodeReleaseFolder)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <!-- Dữ liệu mẫu từ DB FastBusiness trên máy (chỉ SELECT) — cùng phiên bản với Bcode.App. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Kiểm tra key bản quyền (LicenseCodec dùng bcrypt) — cùng phiên bản với Bcode.App / Bcode.KeyGen. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Trang giao diện riêng của Designer. -->
    <None Include="Web\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Dùng LẠI nguyên bản code "Xem trước Dir" của BcodeViewer (Alt+P) — không chép: sửa ở BcodeViewer là Designer ăn theo. -->
    <None Include="..\BcodeViewer.App\Web\dirpreview.js" Link="Web\shared\dirpreview.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BcodeViewer.App\Web\entity.js" Link="Web\shared\entity.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BcodeViewer.App\Web\hostcall.js" Link="Web\shared\hostcall.js" CopyToOutputDirectory="PreserveNewest" />
    <!-- Hộp "Cập nhật Screen Designer" (Shared/AppUpdateForm.cs): CHÍNH trang update.html + shell.css/dialog.css của Bcode — link, không chép. -->
    <None Include="..\Bcode.App\Web\Shell\update.html;..\Bcode.App\Web\Shell\shell.css;..\Bcode.App\Web\Shell\dialog.css" LinkBase="Web\update" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Đọc include theo lô / cả cây (entity.js BeginReadFiles / BeginReadIncludeTree) — dùng LẠI code của BcodeViewer. -->
    <Compile Include="..\BcodeViewer.App\Host\IncludeTree.cs" Link="Shared\IncludeTree.cs" />
    <!-- Dọn hồ sơ WebView2 theo pid của lần chạy cũ trong %TEMP% (trước đây không bao giờ xoá) -->
    <Compile Include="..\Shared\WebViewProfileCleanup.cs" Link="Shared\WebViewProfileCleanup.cs" />
    <!-- Key bản quyền: chạy thẳng BcodeScreenDesigner.exe (không qua Bcode) cũng phải có key như khi mở từ Bcode. -->
    <Compile Include="..\Bcode.App\Services\LicenseService.cs" Link="Shared\LicenseService.cs" />
    <!-- Key gốc + cách ghép key Decrypt nằm ở Secrets/LocalSecrets.cs (gitignore) — LicenseSecret.cs chỉ tham chiếu. Thiếu file thì dùng bản rỗng. -->
    <Compile Include="..\Bcode.App\Secrets\LocalSecrets.cs" Link="Shared\LocalSecrets.cs" Condition="Exists('..\Bcode.App\Secrets\LocalSecrets.cs')" />
    <Compile Include="..\Bcode.App\Secrets\LocalSecrets.Empty.cs" Link="Shared\LocalSecrets.cs" Condition="!Exists('..\Bcode.App\Secrets\LocalSecrets.cs')" />
    <Compile Include="..\Bcode.App\Services\LicenseSecret.cs" Link="Shared\LicenseSecret.cs" />
    <Compile Include="..\Bcode.App\BcodePaths.cs" Link="Shared\BcodePaths.cs" />
    <Compile Include="..\Shared\LicenseCodec.cs" Link="Shared\LicenseCodec.cs" />
    <!-- Cập nhật bản mới — cùng lõi + cùng hộp với BcodeViewer (Shared/AppUpdate*.cs), thư mục phát hành riêng. -->
    <Compile Include="..\Shared\AppUpdate.cs" Link="Shared\AppUpdate.cs" />
    <Compile Include="..\Shared\AppUpdateDialog.cs" Link="Shared\AppUpdateDialog.cs" />
    <Compile Include="..\Shared\AppUpdateToast.cs" Link="Shared\AppUpdateToast.cs" />
    <Compile Include="..\Shared\AppUpdateForm.cs" Link="Shared\AppUpdateForm.cs" />
  </ItemGroup>
  <!-- bcode-version.json / bcode-changelog.txt / bcode-manifest.json cạnh BcodeScreenDesigner.exe — dùng chung với Bcode.App / BcodeViewer.App. -->
  <Import Project="..\Shared\Release.targets" />
</Project>
