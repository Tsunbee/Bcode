<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE grid [
	<!ENTITY XMLStandardDetailToolbar SYSTEM "..\Include\XML\StandardDetailToolbar.xml">

	<!ENTITY % Extra SYSTEM "..\Include\Extra\Extra.ent">
	%Extra;
	<!ENTITY % Clipboard.List SYSTEM "..\Include\Clipboard\Clipboard.List">
	%Clipboard.List;
	<!ENTITY % Clipboard SYSTEM "..\Include\Clipboard\Clipboard.ent">
	%Clipboard;
]>

<grid table="ctdmhd" type="Detail" code="ma_hd" order="ma_hd, line_nbr" xmlns="urn:schemas-fast-com:data-grid">
	<title v="" e=""></title>
	<subTitle v="" e=""></subTitle>

	<fields>
		<field name="ngay_tt" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100" aliasName="a">
			<header v="Ngày thanh toán" e="Payment Date"></header>
		</field>
		<field name="ngay_tt_x" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100" external="true" aliasName="x.ngay_tt" readOnly="true" inactivate="true">
			<header v="Ngày thanh toán (hệ thống ghi nhận)" e=""></header>
		</field>
		<field name="ma_dot" allowNulls="false" width="100" aliasName="a">
			<header v="Đợt thanh toán" e="Payment Phase"></header>
			<items style="AutoComplete" controller="ContractPaymentProgress" reference="ten_dot%l" key="status = '1'" check="1 = 1" information="ma_dot$dmtthd.ten_dot%l" new="Default"/>
		</field>
		<field name="ten_dot%l" readOnly="true" external="true" clientDefault="Default" defaultValue="''" inactivate="true" hidden="true" width="0">
			<header v="" e=""></header>
		</field>
		<field name="ty_le" type ="Decimal" width="100" dataFormatString="##0.00" align="right">
			<header v="Tỷ lệ (%)" e="Rate (%)"></header>
			<items style="Numeric"></items>
		</field>
		<field name="tien" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="120" clientDefault="0">
			<header v="Tiền" e="Amount"></header>
			<items style="Numeric"/>
		</field>
		<field name="han_tt" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100">
			<header v="Hạn thanh toán" e="Due Date"></header>
			<clientScript><![CDATA[onchange="onChange$$GridVoucherDetail$Date(this);"]]></clientScript>
		</field>
		<field name="da_xuat_hd" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0" readOnly="true" inactivate="true" external="true" aliasName="x">
			<header v="Đã xuất hóa đơn" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="da_tt0" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0" readOnly="true" inactivate="true" external="true" aliasName="x">
			<header v="Đã thanh toán (đầu kỳ)" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="da_tt1" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0" readOnly="true" inactivate="true" external="true" aliasName="x">
			<header v="Đã thanh toán (trong kỳ)" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="tttt_cdt0" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0" readOnly="true" inactivate="true" external="true" aliasName="x">
			<header v="Thanh toán trực tiếp CĐT (đầu kỳ)" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="tttt_cdt1" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0" readOnly="true" inactivate="true" external="true" aliasName="x">
			<header v="Thanh toán trực tiếp CĐT (trong kỳ)" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="ngay_tttt_cdt" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100" readOnly="true" inactivate="true" external="true" aliasName="x">
			<header v="Ngày TTTT CĐT" e=""></header>
		</field>
		<field name="tong_da_tt" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0" external="true" defaultValue="0" aliasName="x" readOnly="true" inactivate="true">
			<header v="Tổng đã thanh toán" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="con_pt" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0" external="true" defaultValue="0" aliasName="a.tien - isnull(x.tong_da_tt, 0)" readOnly="true" inactivate="true">
			<header v="Số tiền còn lại" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="so_ngay_gia_han" type ="Decimal" width="100" dataFormatString="### ##0" align="right">
			<header v="Số ngày gia hạn" e=""></header>
			<items style="Numeric"></items>
		</field>
		<field name="ngay_gia_han" type="DateTime" dataFormatString="@datetimeFormat" align="left" width="100">
			<header v="Ngày gia hạn" e=""></header>
			<clientScript><![CDATA[onchange="onChange$$GridVoucherDetail$Date(this);"]]></clientScript>
		</field> 
		<field name="no_kho_doi" type="Boolean" width="100" readOnly="true" external="true" aliasName="x">
			<header v="Nợ khó đòi" e=""></header>
		</field>
		<field name="von_tu_co" type="Boolean" width="100" readOnly="true" external="true" aliasName="x">
			<header v="Vốn tự có" e=""></header>
		</field>
		<field name="von_giai_ngan" type="Boolean" width="100" readOnly="true" external="true" aliasName="x">
			<header v="Vốn giải ngân" e=""></header>
		</field>
		<field name="ghi_chu" width="300">
			<header v="Ghi chú" e="Note"></header>
		</field>
		<field name="thong_bao_nhac_no" width="300">
			<header v="Thông báo nhắc nợ" e=""></header>
		</field>
		
		<field name="so_ngay_tre_han" type ="Decimal" width="100" dataFormatString="### ##0" align="right">
			<header v="Số ngày trễ hạn" e="Number of days late"></header>
			<items style="Numeric"></items>
		</field>
		<field name="tien_lai_tre_han" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="120" clientDefault="0">
			<header v="Tiền lãi trễ hạn" e="Late Interest"></header>
			<items style="Numeric"/>
		</field>
		<field name="tien_lai_mien_giam" type="Decimal" dataFormatString="@baseCurrencyAmountInputFormat" width="100" clientDefault="0">
			<header v="Tiền lãi miễn giảm" e=""></header>
			<items style="Numeric"/>
		</field>
		<field name="ghi_chu_to_khai_mien_giam" width="300">
			<header v="Ghi chú tờ khai miễn giảm" e=""></header>
		</field>
		
		<field name="tien_nt" type="Decimal" dataFormatString="@foreignCurrencyAmountInputFormat" width="120" clientDefault="0" hidden="true">
			<header v="Tiền nt" e="FC Amount"></header>
			<items style="Numeric"/>
		</field>
		<field name="line_nbr" type="Int32" isPrimaryKey="true" width="0" align="right" hidden="true">
			<header v="" e=""></header>
		</field>
	</fields>

	<views>
		<view id="Grid">
			<field name="ngay_tt"/>
			<field name="ngay_tt_x"/>
			<field name="ma_dot"/>
			<field name="ten_dot%l"/>
			<field name="ty_le"/>
			<field name="tien"/>
			<field name="han_tt"/>
			<field name="da_xuat_hd"/>
			<field name="da_tt0"/>
			<field name="da_tt1"/>
			<field name="tttt_cdt0"/>
			<field name="tttt_cdt1"/>
			<field name="ngay_tttt_cdt"/>
			<field name="tong_da_tt"/>
			<field name="con_pt"/>
			<field name="so_ngay_gia_han"/>
			<field name="ngay_gia_han"/>
			<field name="no_kho_doi"/>
			<field name="von_tu_co"/>
			<field name="von_giai_ngan"/>
			<field name="ghi_chu"/>
			<field name="thong_bao_nhac_no"/>
			<field name="so_ngay_tre_han"/>
			<field name="tien_lai_tre_han"/>
			<field name="tien_lai_mien_giam"/>
			<field name="ghi_chu_to_khai_mien_giam"/>
			<field name="tien_nt"/>
			<field name="line_nbr"/>
		</view>
	</views>

	<commands>
		<command event="Loading">
			<text>
				<![CDATA[
select 'load$GridDetail$(this);]]>&Clipboard.Loading;<![CDATA[' as message
return]]>
			</text>
		</command>
		<command event="Closing">
			<text>
				<![CDATA[select 'dispose$GridDetail$(this);' as message
return]]>
			</text>
		</command>
	</commands>

	<script>
		<text>
			<![CDATA[/* <flatten type="Javascript"> */
function load$GridDetail$(g) {
	g.add_commandEvent(on$GridDetail$ExecuteCommand);
	g.add_itemValueChanged(onChange$GridDetail$);
	g.add_onResponseComplete(on$GridVoucherDetail$ResponseComplete);
}
function dispose$GridDetail$(g) {
	try {g.remove_commandEvent(on$GridDetail$ExecuteCommand);} catch (ex) {}
	try {g.remove_itemValueChanged(onChange$GridDetail$);} catch (ex) {}
	try {g.remove_onResponseComplete(on$GridVoucherDetail$ResponseComplete);} catch (ex) {}
}
/* </flatten> */
function on$GridDetail$ExecuteCommand(sender, e) {
	var action = e.type.Action, g = sender, f = g.get_element().parentForm;
	switch (action) {
		]]>&Clipboard.Event.Before;<![CDATA[
		]]>&Clipboard.Event.Before.Request;<![CDATA[
		]]>&Clipboard.Event.Before.Process;<![CDATA[
		]]>&Clipboard.Event.After;<![CDATA[
		]]>&Clipboard.Event.After.Process;<![CDATA[
		]]>&GridExtraToolbarExecuteCommandScript;<![CDATA[
		default:
			break;
	}
}
function onChange$GridDetail$(sender, eventArgs) {
	var o = eventArgs.get_object(), g = o.grid, f = g.get_element().parentForm, name = o.field.Name;
	switch (name) {
		default:
			break;
	}
}
function on$GridVoucherDetail$ResponseComplete(sender, e) {
	var g = e.object, context = e.type.Context, result = e.type.Result, o = e.type.Object, f = g.get_element().parentForm;
	switch (context) {
		case 'RenewalDate':
			g.setItemGridBehavior(o, [['so_ngay_gia_han', result[0].Value, null, null]]);
			break;
		default:
			break;
	}
}
function onChange$$GridVoucherDetail$Date(o) {
	o.grid.request(o, 'RenewalDate', 'RenewalDate', ['han_tt', 'ngay_gia_han'], [], null);
}
]]>
			&GridExtraToolbarScript;
		</text>
	</script>
	
	<response>
		<action id="RenewalDate">
			<text>
				<![CDATA[
declare @rs int = datediff(dy, @han_tt, @ngay_gia_han)
if @rs is null set @rs = 0

select @rs
return
]]>
			</text>
		</action>
	</response>
	
	<css>
		<text>
			&GridExtraToolbarCss;
		</text>
	</css>

	<toolbar>
		<button command="Insert">
			<title v="Toolbar.Insert" e="Toolbar.Insert"></title>
		</button>
		<button command="Grow">
			<title v="Toolbar.Grow" e="Toolbar.Grow"></title>
		</button>
		<button command="Down">
			<title v="Toolbar.Down" e="Toolbar.Down"></title>
		</button>
		<button command="Clone">
			<title v="Toolbar.Clone" e="Toolbar.Clone"></title>
		</button>
		<button command="Remove">
			<title v="Toolbar.Remove" e="Toolbar.Remove"></title>
		</button>


		&GridExtraToolbar;

		<button command="-">
			<title v="-" e="-"/>
		</button>
		<button command="Freeze">
			<title v="Toolbar.Freeze" e="Toolbar.Freeze"></title>
		</button>
	</toolbar>

	<queries>
		<query event="Loading">
			<text>
				<![CDATA[
declare @ContractCode varchar(33)
select @ContractCode = @ma_hd

select ma_dot, da_xuat_hd, da_tt0, da_tt1, ngay_tt, tttt_cdt0, tttt_cdt1, ngay_tttt_cdt, tong_da_tt, no_kho_doi, von_tu_co, von_giai_ngan into #x from zhopdongtt a where ma_hd = @ContractCode

select @@fieldExternal from @@table a left join #x x on a.ma_dot = x.ma_dot where @@whereClause order by @@orderByClause
]]>
			</text>
		</query>
	</queries>
</grid>