    <Parameter Name="f_t_tien_khong_thue" DataType="System.String" Expression="0"/>
    <Parameter Name="f_h_thue8" DataType="System.String" Expression="&quot;8%&quot;"/>
    <Parameter Name="f_t_tien_thue_gtgt8" DataType="System.String" Expression="IIf([isFC] == 0,[d1.thue_8],[d1.thue_nt_8])"/>
